<UserControl x:Class="keycuts.GUI.Views.CreatorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:keycuts.GUI.Controls"
             xmlns:themes="clr-namespace:keycuts.GUI.Themes"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:design="clr-namespace:keycuts.GUI.DesignData"
             mc:Ignorable="d" d:DataContext="{x:Static design:DesignViewModels.CreatorUrl}"
             Background="{DynamicResource SurfaceBrush}" Loaded="CreatorView_Loaded"
             PreviewKeyDown="CreatorView_PreviewKeyDown"
             PreviewDragEnter="Creator_DragEnter" PreviewDragOver="Creator_DragOver" PreviewDragLeave="Creator_DragLeave"
             PreviewDrop="Creator_Drop"
             AllowDrop="{Binding IsInputEnabled}">
  <UserControl.Resources>
    <!-- Borderless single-line field that sits inside the drop area; focus is shown on the drop area instead. -->
    <Style x:Key="InlineTextBox" TargetType="TextBox">
      <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
      <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}" />
      <Setter Property="SelectionBrush" Value="{DynamicResource AccentBrush}" />
      <Setter Property="SelectionTextBrush" Value="{DynamicResource OnAccentBrush}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="MinHeight" Value="22" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="AllowDrop" Value="True" />
      <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Grid Background="Transparent">
              <ScrollViewer x:Name="PART_ContentHost" Padding="{TemplateBinding Padding}" Focusable="False"
                            VerticalAlignment="Center" HorizontalScrollBarVisibility="Hidden"
                            VerticalScrollBarVisibility="Hidden" />
              <TextBlock x:Name="Placeholder" Visibility="Collapsed" IsHitTestVisible="False" Margin="2,0,0,0"
                         Text="{TemplateBinding themes:TextBoxChrome.Placeholder}" VerticalAlignment="Center"
                         TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextSecondaryBrush}" />
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="Text" Value="">
                <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Placeholder" Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="Text" Value="">
          <Setter Property="ToolTipService.IsEnabled" Value="False" />
        </Trigger>
        <Trigger Property="IsEnabled" Value="False">
          <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
        </Trigger>
      </Style.Triggers>
    </Style>

    <!-- Drop area layers: the dashed outline, the fill, and the soft glow around it. -->
    <Style x:Key="DropStroke" TargetType="Rectangle">
      <Setter Property="RadiusX" Value="12" />
      <Setter Property="RadiusY" Value="12" />
      <Setter Property="StrokeThickness" Value="1" />
      <Setter Property="Stroke" Value="{DynamicResource BorderStrongBrush}" />
      <Setter Property="StrokeDashArray">
        <Setter.Value>
          <DoubleCollection>4 3</DoubleCollection>
        </Setter.Value>
      </Setter>
      <Setter Property="IsHitTestVisible" Value="False" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsKeyboardFocusWithin, ElementName=DropArea}" Value="True">
          <Setter Property="Stroke" Value="{DynamicResource AccentBrush}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding ShowDestinationError}" Value="True">
          <Setter Property="Stroke" Value="{DynamicResource DangerBrush}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding ShowDragHover}" Value="True">
          <Setter Property="Stroke" Value="{DynamicResource AccentBrush}" />
          <Setter Property="StrokeThickness" Value="2" />
          <Setter Property="StrokeDashArray" Value="{x:Null}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="DropFill" TargetType="Border">
      <Setter Property="CornerRadius" Value="{StaticResource RadiusLg}" />
      <Setter Property="Background" Value="{DynamicResource SurfaceSubtleBrush}" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding ShowDestinationError}" Value="True">
          <Setter Property="Background" Value="{DynamicResource DangerSoftBrush}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding ShowDragHover}" Value="True">
          <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="DropGlow" TargetType="Border">
      <Setter Property="Margin" Value="-3" />
      <Setter Property="BorderThickness" Value="3" />
      <Setter Property="CornerRadius" Value="15" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
      <Setter Property="Opacity" Value="0" />
      <Setter Property="IsHitTestVisible" Value="False" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsKeyboardFocusWithin, ElementName=DropArea}" Value="True">
          <Setter Property="Opacity" Value="0.2" />
        </DataTrigger>
        <MultiDataTrigger>
          <MultiDataTrigger.Conditions>
            <Condition Binding="{Binding IsKeyboardFocusWithin, ElementName=DropArea}" Value="True" />
            <Condition Binding="{Binding ShowDestinationError}" Value="True" />
          </MultiDataTrigger.Conditions>
          <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
        </MultiDataTrigger>
        <DataTrigger Binding="{Binding ShowDragHover}" Value="True">
          <Setter Property="Margin" Value="-4" />
          <Setter Property="BorderThickness" Value="4" />
          <Setter Property="CornerRadius" Value="16" />
          <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
          <Setter Property="Opacity" Value="0.2" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <!-- Quiet full-width link button for the footer. -->
    <Style x:Key="FooterLinkButton" TargetType="Button">
      <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
      <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="FocusVisualStyle" Value="{StaticResource AppFocusVisual}" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}" CornerRadius="{StaticResource RadiusSm}">
              <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="HelperText" TargetType="TextBlock">
      <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
      <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="AutomationProperties.LiveSetting" Value="Polite" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsSuccess}" Value="True">
          <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding HelperIsError}" Value="True">
          <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="BrowseChevron" TargetType="controls:Icon">
      <Setter Property="Size" Value="12" />
      <Setter Property="Kind" Value="Chevron" />
      <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
      <Setter Property="RenderTransform">
        <Setter.Value>
          <RotateTransform Angle="90" />
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsBrowseMenuOpen}" Value="True">
          <Setter Property="RenderTransform">
            <Setter.Value>
              <RotateTransform Angle="-90" />
            </Setter.Value>
          </Setter>
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="BrowseMenuItem" TargetType="MenuItem" BasedOn="{StaticResource AppMenuItem}">
      <Setter Property="MinHeight" Value="46" />
    </Style>
  </UserControl.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid Grid.Row="0" Margin="20,20,20,22">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <Grid Grid.Row="0" Margin="0,0,0,20">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="NEW KEYCUT" FontSize="{StaticResource FontSizeEyebrow}" FontWeight="Bold"
                     Foreground="{DynamicResource AccentBrush}" />
          <TextBlock Text="Launch anything instantly" FontSize="{StaticResource FontSizeHeading}" FontWeight="SemiBold"
                     Foreground="{DynamicResource TextBrush}" />
        </StackPanel>
        <Button Grid.Column="1" Style="{StaticResource IconButton}" VerticalAlignment="Top"
                Command="{Binding OpenSettingsCommand}" AutomationProperties.Name="Settings">
          <controls:Icon Kind="Settings" />
        </Button>
      </Grid>

      <!-- Destination drop area -->
      <Grid x:Name="DropArea" Grid.Row="1" MinHeight="96">
        <Border Style="{StaticResource DropGlow}" />
        <Border Style="{StaticResource DropFill}" />
        <Rectangle Style="{StaticResource DropStroke}" />
        <Grid Margin="10,18">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <Border Width="42" Height="42" CornerRadius="11" Background="{DynamicResource AccentSoftBrush}"
                  VerticalAlignment="Center">
            <controls:Icon Kind="{Binding DestinationIcon}" Size="23" HorizontalAlignment="Center"
                           VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}" />
          </Border>

          <StackPanel Grid.Column="1" Margin="10,0" VerticalAlignment="Center">
            <TextBlock Text="Destination" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" />
            <TextBox x:Name="TextboxDestination" Style="{StaticResource InlineTextBox}" Margin="-2,4,0,0"
                     Text="{Binding Destination, UpdateSourceTrigger=PropertyChanged}"
                     themes:TextBoxChrome.Placeholder="Drop or paste a file, folder, or URL here"
                     IsEnabled="{Binding IsInputEnabled}" AutomationProperties.Name="Destination"
                     PreviewKeyDown="TextboxDestination_PreviewKeyDown" TextChanged="TextboxDestination_TextChanged"
                     LostFocus="TextboxDestination_LostFocus" />
          </StackPanel>

          <controls:MenuButton x:Name="BtnBrowse" Grid.Column="2" Style="{StaticResource SecondaryButton}" VerticalAlignment="Center"
                  Click="Browse_Click" PreviewKeyDown="Browse_PreviewKeyDown" IsEnabled="{Binding IsInputEnabled}"
                  AutomationProperties.Name="Browse">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="Browse" VerticalAlignment="Center" />
              <controls:Icon Style="{StaticResource BrowseChevron}" Margin="6,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
            <Button.ContextMenu>
              <ContextMenu x:Name="BrowseMenu" Width="190" Opened="BrowseMenu_Opened" Closed="BrowseMenu_Closed"
                           PreviewKeyDown="BrowseMenu_PreviewKeyDown">
                <MenuItem Style="{StaticResource BrowseMenuItem}" AutomationProperties.Name="File…"
                          Command="{Binding BrowseFileCommand}">
                  <MenuItem.Icon>
                    <controls:Icon Kind="File" Size="16" Foreground="{DynamicResource AccentBrush}" />
                  </MenuItem.Icon>
                  <MenuItem.Header>
                    <StackPanel>
                      <TextBlock Text="File…" FontWeight="Bold" FontSize="{StaticResource FontSizeBody}" />
                      <TextBlock Text="Choose a single file" FontSize="{StaticResource FontSizeEyebrow}" Margin="0,2,0,0"
                                 Foreground="{DynamicResource TextTertiaryBrush}" />
                    </StackPanel>
                  </MenuItem.Header>
                </MenuItem>
                <MenuItem Style="{StaticResource BrowseMenuItem}" AutomationProperties.Name="Folder…"
                          Command="{Binding BrowseFolderCommand}">
                  <MenuItem.Icon>
                    <controls:Icon Kind="Folder" Size="16" Foreground="{DynamicResource AccentBrush}" />
                  </MenuItem.Icon>
                  <MenuItem.Header>
                    <StackPanel>
                      <TextBlock Text="Folder…" FontWeight="Bold" FontSize="{StaticResource FontSizeBody}" />
                      <TextBlock Text="Choose a directory" FontSize="{StaticResource FontSizeEyebrow}" Margin="0,2,0,0"
                                 Foreground="{DynamicResource TextTertiaryBrush}" />
                    </StackPanel>
                  </MenuItem.Header>
                </MenuItem>
              </ContextMenu>
            </Button.ContextMenu>
          </controls:MenuButton>
        </Grid>
      </Grid>

      <!-- Name form -->
      <StackPanel Grid.Row="2" Margin="0,18,0,0">
        <TextBlock Text="Name your keycut" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,6" />
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBox x:Name="TextboxShortcut" Height="38" MinHeight="38"
                   Text="{Binding ShortcutName, UpdateSourceTrigger=PropertyChanged}"
                   themes:TextBoxChrome.Placeholder="e.g. l-vicki"
                   themes:TextBoxChrome.HasError="{Binding IsDuplicateName}"
                   IsEnabled="{Binding IsInputEnabled}" AutomationProperties.Name="Keycut name"
                   TextChanged="TextboxShortcut_TextChanged">
            <TextBox.InputBindings>
              <!-- Enter creates only from the name field -->
              <KeyBinding Key="Return" Command="{Binding CreateCommand}" />
            </TextBox.InputBindings>
          </TextBox>
          <Button x:Name="BtnCreateShortcut" Grid.Column="1" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0"
                  Height="38" MinWidth="104" Padding="16,0" Command="{Binding CreateCommand}"
                  AutomationProperties.Name="Create">
            <Grid>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <StackPanel.Style>
                  <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsSaving}" Value="True">
                        <Setter Property="Visibility" Value="Collapsed" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </StackPanel.Style>
                <TextBlock Text="Create" VerticalAlignment="Center" />
                <controls:Icon Kind="Arrow" Size="16" Margin="8,0,0,0" VerticalAlignment="Center" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <StackPanel.Style>
                  <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsSaving}" Value="True">
                        <Setter Property="Visibility" Value="Visible" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </StackPanel.Style>
                <Control Style="{StaticResource Spinner}" Width="12" Height="12" VerticalAlignment="Center"
                         Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                <TextBlock Text="Saving" Margin="8,0,0,0" VerticalAlignment="Center" />
              </StackPanel>
            </Grid>
          </Button>
        </Grid>
        <StackPanel Orientation="Horizontal" Margin="0,8,0,0" MinHeight="18">
          <controls:Icon Kind="Check" Size="14" Margin="0,0,6,0" VerticalAlignment="Center"
                         Foreground="{DynamicResource SuccessBrush}">
            <controls:Icon.Style>
              <Style TargetType="controls:Icon">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsSuccess}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </controls:Icon.Style>
          </controls:Icon>
          <TextBlock Text="{Binding HelperText}" Style="{StaticResource HelperText}" ToolTip="{Binding HelperText}" />
        </StackPanel>
      </StackPanel>
    </Grid>

    <!-- Footer strip -->
    <Border Grid.Row="1" Background="{DynamicResource SurfaceSubtleBrush}" BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,1,0,0" Padding="20,10">
      <Button Style="{StaticResource FooterLinkButton}" Command="{Binding ShowManagerCommand}"
              AutomationProperties.Name="{Binding KeycutCount, StringFormat='View all keycuts ({0})'}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <controls:Icon Kind="External" Size="15" />
            <TextBlock Text="View all keycuts" Margin="8,0,0,0" VerticalAlignment="Center" />
          </StackPanel>
          <Border Grid.Column="1" MinWidth="24" Height="20" Padding="7,0" CornerRadius="10"
                  Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                  BorderThickness="1" VerticalAlignment="Center">
            <TextBlock Text="{Binding KeycutCount}" FontSize="{StaticResource FontSizeCaption}" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
          </Border>
        </Grid>
      </Button>
    </Border>
  </Grid>
</UserControl>
