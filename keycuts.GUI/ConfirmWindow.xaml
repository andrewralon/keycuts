<Window x:Class="keycuts.GUI.ConfirmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:keycuts.GUI.Controls"
        xmlns:vm="clr-namespace:keycuts.GUI.ViewModels"
        mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=vm:ConfirmViewModel}"
        Title="{Binding Title}" Width="{StaticResource ConfirmWidth}" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" UseLayoutRounding="True"
        Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextBrush}"
        FontFamily="{StaticResource AppFontFamily}" FontSize="{StaticResource FontSizeBody}"
        Loaded="Confirm_Loaded">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <Style x:Key="TargetText" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        </Style>
    </Window.Resources>

    <!-- The body scrolls when the window is capped to the screen (high DPI, large text); the footer always stays visible.
         It holds nothing focusable, so it takes the focus itself (Tab, or Shift+Tab from Cancel): the arrow keys and
         Page Up/Down then scroll it, so a clipped confirmation can be read without a mouse. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer x:Name="BodyScroller" Grid.Row="0" Focusable="True" IsTabStop="True"
                      FocusVisualStyle="{StaticResource AppFocusVisual}" AutomationProperties.Name="{Binding Heading}"
                      AutomationProperties.HelpText="{Binding Summary}"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="{StaticResource PagePadding}">
                <!-- Header -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <!-- A warning, not a greeting: the tile is subtle and outlined, with the glyph in the warning color -->
                    <Border Style="{StaticResource IconTile}" Background="{DynamicResource SurfaceSubtleBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                        <controls:Icon Kind="Warning" Size="24" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{DynamicResource WarningBrush}" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                        <TextBlock x:Name="HeadingText" Text="{Binding Heading}" Style="{StaticResource Heading}" Margin="0" />
                        <TextBlock Text="{Binding Intro}" Margin="0,4,0,0" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>
                </Grid>

                <!-- A replace: what the keycut opens now, and what it will open -->
                <Border Style="{StaticResource InsetPanel}"
                        Visibility="{Binding ShowTargets, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <controls:SectionLabel Text="Opens now" />
                        <TextBlock x:Name="CurrentTargetText" Text="{Binding CurrentTarget}" Style="{StaticResource TargetText}"
                                   AutomationProperties.Name="{Binding CurrentTarget, StringFormat='Opens now: {0}'}" />
                        <controls:SectionLabel Text="Will open" Margin="0,12,0,8" />
                        <TextBlock x:Name="NewTargetText" Text="{Binding NewTarget}" Style="{StaticResource TargetText}"
                                   AutomationProperties.Name="{Binding NewTarget, StringFormat='Will open: {0}'}" />
                    </StackPanel>
                </Border>

                <!-- Other commands with this name, most important first -->
                <ItemsControl x:Name="WarningList" ItemsSource="{Binding Warnings}" Focusable="False" IsTabStop="False"
                              Visibility="{Binding ShowWarnings, Converter={StaticResource BoolToVisibility}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <controls:Icon Kind="Warning" Size="16" Margin="0,1,8,0" VerticalAlignment="Top"
                                               Foreground="{DynamicResource WarningBrush}" />
                                <TextBlock Grid.Column="1" Text="{Binding}" TextWrapping="Wrap" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer, as in Settings: Cancel and Escape keep things as they are; Enter goes ahead -->
        <Border Grid.Row="1" Style="{StaticResource DialogFooter}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnCancel" Content="cancel" Style="{StaticResource SecondaryButton}" IsCancel="True" />
                <Button x:Name="BtnConfirm" Style="{StaticResource PrimaryButton}" IsDefault="True" Margin="8,0,0,0"
                        Click="Confirm_Click" AutomationProperties.Name="{Binding ConfirmText}"
                        AutomationProperties.HelpText="{Binding Summary}">
                    <StackPanel Orientation="Horizontal">
                        <controls:Icon Kind="Check" Size="16" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding ConfirmText}" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>
