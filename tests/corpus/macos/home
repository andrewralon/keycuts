#!/bin/sh
# keycuts 2.0.0
# <shortcut>/Users/me/Shortcuts/home</shortcut>
# <type>folder</type>
# <target>$HOME/it's "odd" $x `y` \z</target>
# <description>Saved with $HOME</description>
open "$HOME/it's \"odd\" \$x \`y\` \\z"
s=$?
u="$HOME/Library/Application Support/keycuts/usage"; { mkdir -p "$u" && echo 1 >>"$u/${0##*/}.runs"; } 2>/dev/null
exit $s
