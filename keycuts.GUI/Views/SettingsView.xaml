<UserControl x:Class="keycuts.GUI.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:common="clr-namespace:keycuts.Common;assembly=keycuts.Common"
             xmlns:controls="clr-namespace:keycuts.GUI.Controls"
             xmlns:themes="clr-namespace:keycuts.GUI.Themes"
             xmlns:views="clr-namespace:keycuts.GUI.Views"
             xmlns:vm="clr-namespace:keycuts.GUI.ViewModels"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}"
             Background="{DynamicResource SurfaceBrush}" Loaded="SettingsView_Loaded"
             AutomationProperties.Name="settings">
  <!-- #218: Settings as the main window's third screen (docs/styleguide.md, Tabbed window). No heading (the selected tab names the
       screen) and no Save button: every change is stored as it is made (SettingsViewModel). Section labels group the rows, which are
       16 apart, sections 24, with no lines between them. It ends in the same footer as the other screens. -->
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

    <!-- A setting's name: body text, SemiBold -->
    <Style x:Key="SettingName" TargetType="TextBlock">
      <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- What a setting does, 4 under its name -->
    <Style x:Key="SettingNote" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
      <Setter Property="Margin" Value="0,4,0,0" />
    </Style>

    <!-- A row after the first in its section; the control sits 16 to the right of the text -->
    <Style x:Key="SettingRow" TargetType="Grid">
      <Setter Property="Margin" Value="0,16,0,0" />
    </Style>

    <!-- A section after the first: 24 above its label -->
    <Style x:Key="LaterSection" TargetType="controls:SectionLabel" BasedOn="{StaticResource {x:Type controls:SectionLabel}}">
      <Setter Property="Margin" Value="0,24,0,8" />
    </Style>

    <!-- The folder box shows the error state while the view model has a message for it -->
    <Style x:Key="OutputFolderBox" TargetType="TextBox" BasedOn="{StaticResource AppTextBox}">
      <!-- A long path doesn't fit, so it can be read in full from the tooltip -->
      <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
      <Style.Triggers>
        <Trigger Property="Text" Value="">
          <Setter Property="ToolTipService.IsEnabled" Value="False" />
        </Trigger>
        <DataTrigger Binding="{Binding HasOutputFolderError}" Value="True">
          <Setter Property="themes:TextBoxChrome.HasError" Value="True" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="OutputFolderHelper" TargetType="controls:HelperText" BasedOn="{StaticResource {x:Type controls:HelperText}}">
      <Style.Triggers>
        <DataTrigger Binding="{Binding HasOutputFolderError}" Value="True">
          <Setter Property="State" Value="Error" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <!-- An icon choice as a picture, 52. One that follows the theme shows both drawings: the light-mode one at the top left, and
         the dark-mode one over it, smaller, at the bottom right, in a ring of whatever it sits on (a card, a button). -->
    <DataTemplate x:Key="IconPreview" DataType="{x:Type themes:AppIconOption}">
      <Grid Width="52" Height="52" RenderOptions.BitmapScalingMode="HighQuality">
        <Image x:Name="Single" Source="{Binding LightImage}" />
        <Image x:Name="Back" Source="{Binding LightImage}" Width="38" Height="38" HorizontalAlignment="Left" VerticalAlignment="Top"
               Visibility="Collapsed" />
        <Border x:Name="Front" Width="33" Height="33" Padding="1" CornerRadius="{StaticResource RadiusMd}" HorizontalAlignment="Right"
                VerticalAlignment="Bottom" Visibility="Collapsed"
                Background="{Binding Background, RelativeSource={RelativeSource AncestorType=Border, AncestorLevel=1}}">
          <Image Source="{Binding DarkImage}" />
        </Border>
      </Grid>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding FollowsTheme}" Value="True">
          <Setter TargetName="Single" Property="Visibility" Value="Collapsed" />
          <Setter TargetName="Back" Property="Visibility" Value="Visible" />
          <Setter TargetName="Front" Property="Visibility" Value="Visible" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <!-- A card in the icon picker. Two share a row: the list is 428 wide and a card 205 with 4 on each side, so a row is 426 and
         2 are spare (rounding at any scale can't wrap the second). Classic, the last, takes the whole row: 418. -->
    <Style x:Key="IconCard" TargetType="ListBoxItem" BasedOn="{StaticResource CardItem}">
      <Setter Property="Width" Value="205" />
      <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
      <Setter Property="AutomationProperties.HelpText" Value="{Binding Description}" />
      <Setter Property="ContentTemplate">
        <Setter.Value>
          <DataTemplate>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource IconPreview}" VerticalAlignment="Center" />
              <StackPanel Grid.Column="1" Margin="12,0,16,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding Name}" Style="{StaticResource SettingName}" />
                <TextBlock Text="{Binding Description}" Style="{StaticResource SettingNote}" />
              </StackPanel>
            </Grid>
          </DataTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsWide}" Value="True">
          <Setter Property="Width" Value="418" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
  </UserControl.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- The page scrolls when the window is capped to a short screen; the footer stays. Off while the icon picker is open. -->
    <ScrollViewer x:Name="BodyScroller" Grid.Row="0" Focusable="False" IsTabStop="False" IsEnabled="{Binding IsBodyEnabled}"
                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="{StaticResource PagePadding}">

        <!-- Output -->
        <controls:SectionLabel Text="Output" />
        <TextBlock Text="Output folder" Style="{StaticResource FieldLabel}" />
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <!-- Stored when committed: Enter or leaving the box (SettingsView.xaml.cs), or a pick from the folder button -->
          <TextBox x:Name="TextboxOutputFolder" Grid.Column="0" Style="{StaticResource OutputFolderBox}"
                   Text="{Binding OutputFolder, UpdateSourceTrigger=PropertyChanged}"
                   themes:TextBoxChrome.Placeholder="Choose where keycuts are saved"
                   KeyDown="OutputFolder_KeyDown" LostKeyboardFocus="OutputFolder_LostKeyboardFocus"
                   AutomationProperties.Name="Output folder"
                   AutomationProperties.HelpText="{Binding OutputFolderMessage}" />
          <Button x:Name="BtnChoose" Grid.Column="1" Margin="8,0,0,0" Style="{StaticResource SquareButton}"
                  Command="{Binding ChooseCommand}" ToolTip="Choose a folder" AutomationProperties.Name="Choose a folder">
            <controls:Icon Kind="Folder" Size="20" />
          </Button>
          <!-- Disabled while the folder doesn't exist; the tooltip still shows then, so the bare icon can be identified -->
          <Button x:Name="BtnLaunch" Grid.Column="2" Margin="8,0,0,0" Style="{StaticResource SquareButton}"
                  Command="{Binding LaunchCommand}" ToolTip="Open the output folder" ToolTipService.ShowOnDisabled="True"
                  AutomationProperties.Name="Open the output folder">
            <controls:Icon Kind="External" Size="20" />
          </Button>
        </Grid>
        <controls:HelperText x:Name="OutputFolderMessage" Style="{StaticResource OutputFolderHelper}" Text="{Binding OutputFolderMessage}" />

        <!-- Behavior -->
        <controls:SectionLabel Text="Behavior" Style="{StaticResource LaterSection}" />

        <!-- No visible note: the toggle's help text tells a screen reader what it does -->
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="Ask before replacing a keycut" Style="{StaticResource SettingName}" VerticalAlignment="Center" />
          <ToggleButton x:Name="ToggleAskBeforeReplacing" Grid.Column="1" Style="{StaticResource ToggleSwitch}" Margin="16,0,0,0"
                        VerticalAlignment="Center" IsChecked="{Binding AskBeforeReplacing}"
                        AutomationProperties.Name="Ask before replacing a keycut"
                        AutomationProperties.HelpText="Confirm before a new keycut replaces one with the same name." />
        </Grid>

        <Grid Style="{StaticResource SettingRow}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="Right-click context menus" Style="{StaticResource SettingName}" />
            <TextBlock Text="Add “keycut this!” to File Explorer menus." Style="{StaticResource SettingNote}" />
          </StackPanel>
          <ToggleButton x:Name="ToggleRightClick" Grid.Column="1" Style="{StaticResource ToggleSwitch}" Margin="16,0,0,0"
                        VerticalAlignment="Center" IsChecked="{Binding RightClickContextMenus}"
                        AutomationProperties.Name="Right-click context menus"
                        AutomationProperties.HelpText="Add “keycut this!” to File Explorer menus." />
        </Grid>

        <!-- #31: save new file and folder keycuts as %USERPROFILE%\... and the like; Shift flips it while creating (the Creator's
             Target shows the path that way). "Flip" is right both ways: Shift turns it on for one keycut when it is off, and off
             when it is on. -->
        <Grid Style="{StaticResource SettingRow}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="Use environment variables in paths" Style="{StaticResource SettingName}" />
            <TextBlock Text="Save paths as %USERPROFILE%\… or similar. Hold Shift to preview or create a keycut like this, even when disabled."
                       Style="{StaticResource SettingNote}" />
          </StackPanel>
          <ToggleButton x:Name="ToggleEnvironmentVariables" Grid.Column="1" Style="{StaticResource ToggleSwitch}" Margin="16,0,0,0"
                        VerticalAlignment="Center" IsChecked="{Binding UseEnvironmentVariables}"
                        AutomationProperties.Name="Use environment variables in paths"
                        AutomationProperties.HelpText="Saves C:\Users\you\Desktop as %USERPROFILE%\Desktop, so keycuts work on other accounts. Hold Shift while creating to flip it for one keycut." />
        </Grid>

        <!-- Appearance. The icon: its name and what it does, and the icon itself as the button that opens the picker. -->
        <controls:SectionLabel Text="Appearance" Style="{StaticResource LaterSection}" />
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Style="{StaticResource SettingName}">
              <Run Text="Icon" /><Run Text=" &#x00B7; " FontWeight="Normal" Foreground="{DynamicResource TextSecondaryBrush}" /><Run
                  Text="{Binding SelectedIcon.Name, Mode=OneWay}" FontWeight="Normal" Foreground="{DynamicResource TextSecondaryBrush}" />
            </TextBlock>
            <TextBlock x:Name="IconDescription" Text="{Binding SelectedIcon.Description}" Style="{StaticResource SettingNote}" />
          </StackPanel>
          <Button x:Name="BtnIcon" Grid.Column="1" Margin="16,0,0,0" Padding="4" VerticalAlignment="Center"
                  Command="{Binding OpenIconPickerCommand}" Content="{Binding SelectedIcon}" ContentTemplate="{StaticResource IconPreview}"
                  ToolTip="Change the icon" AutomationProperties.Name="{Binding IconButtonName}" />
        </Grid>

        <!-- The theme: the label and the three choices share a line. A choice applies and is stored at once. -->
        <Grid Style="{StaticResource SettingRow}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="Theme" Style="{StaticResource SettingName}" VerticalAlignment="Center" />
          <StackPanel x:Name="ThemeChoices" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
            <RadioButton Content="System" GroupName="Theme" Tag="{x:Static common:ThemePreference.System}"
                         AutomationProperties.Name="System theme" Checked="Theme_Checked" Margin="0,0,16,0" />
            <RadioButton Content="Light" GroupName="Theme" Tag="{x:Static common:ThemePreference.Light}"
                         AutomationProperties.Name="Light theme" Checked="Theme_Checked" Margin="0,0,16,0" />
            <RadioButton Content="Dark" GroupName="Theme" Tag="{x:Static common:ThemePreference.Dark}"
                         AutomationProperties.Name="Dark theme" Checked="Theme_Checked" />
          </StackPanel>
        </Grid>

        <!-- Updates (#171): only reads the latest release from GitHub and links to its page -->
        <controls:SectionLabel Text="Updates" Style="{StaticResource LaterSection}" />
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="Check for updates" Style="{StaticResource SettingName}" />
            <TextBlock Text="Once a day, ask GitHub whether a newer version is out." Style="{StaticResource SettingNote}" />
          </StackPanel>
          <ToggleButton x:Name="ToggleCheckForUpdates" Grid.Column="1" Style="{StaticResource ToggleSwitch}" Margin="16,0,0,0"
                        VerticalAlignment="Center" IsChecked="{Binding CheckForUpdates}" AutomationProperties.Name="Check for updates"
                        AutomationProperties.HelpText="Once a day, ask GitHub whether a newer version is out." />
        </Grid>

        <!-- The version, the update status and check now: hidden only for the README's screenshots -->
        <Grid x:Name="VersionRow" Style="{StaticResource SettingRow}"
              Visibility="{Binding ShowVersionRow, Converter={StaticResource BoolToVisibility}}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center">
            <TextBlock x:Name="CurrentVersionText" Text="{Binding CurrentVersionText}" Style="{StaticResource SettingName}" />
            <WrapPanel Margin="0,4,0,0" Visibility="{Binding HasUpdateStatus, Converter={StaticResource BoolToVisibility}}">
              <TextBlock x:Name="UpdateStatusMessage" Text="{Binding UpdateStatusText}" Style="{StaticResource Caption}"
                         AutomationProperties.LiveSetting="Polite" />
              <!-- Only while a newer release is known -->
              <TextBlock Style="{StaticResource Caption}" Visibility="{Binding IsUpdateAvailable, Converter={StaticResource BoolToVisibility}}">
                <Run Text=" &#x00B7; " /><Hyperlink x:Name="SettingsDownloadLink" Command="{Binding DownloadUpdateCommand}"
                    Foreground="{DynamicResource AccentTextBrush}" AutomationProperties.Name="Download the new version">download</Hyperlink>
              </TextBlock>
            </WrapPanel>
          </StackPanel>
          <Button x:Name="BtnCheckNow" Grid.Column="1" Margin="16,0,0,0" Content="check now" Style="{StaticResource SecondaryButton}"
                  VerticalAlignment="Center" Command="{Binding CheckNowCommand}" AutomationProperties.Name="check for updates now"
                  Visibility="{Binding CanCheckForUpdates, Converter={StaticResource BoolToVisibility}}" />
        </Grid>

        <!-- A change that was only partly stored (for example PATH couldn't be updated) -->
        <TextBlock x:Name="SaveErrorMessage" Text="{Binding SaveError}" Style="{StaticResource ErrorText}" Margin="0,16,0,0"
                   Visibility="{Binding HasSaveError, Converter={StaticResource BoolToVisibility}}" />

        <!-- There is no Save button, so the page says so -->
        <StackPanel x:Name="SavedNote" Orientation="Horizontal" Margin="0,24,0,0">
          <controls:Icon Kind="Check" Size="12" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
          <TextBlock Text="{x:Static vm:SettingsViewModel.SavedAsYouGoNote}" Style="{StaticResource Caption}" Margin="4,0,0,0"
                     VerticalAlignment="Center" />
        </StackPanel>

        <!-- Show welcome goes back to the creator with the first-run panel; restore defaults asks first, never touches the folder -->
        <Grid Margin="0,16,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Button x:Name="BtnShowWelcome" Grid.Column="0" Content="show welcome" Style="{StaticResource SecondaryButton}"
                  Command="{Binding ShowWelcomeCommand}" AutomationProperties.Name="show the welcome panel" />
          <Button x:Name="BtnRestoreDefaults" Grid.Column="2" Content="restore defaults" Style="{StaticResource SecondaryButton}"
                  Command="{Binding RestoreDefaultsCommand}" AutomationProperties.Name="restore defaults"
                  AutomationProperties.HelpText="{x:Static vm:ConfirmViewModel.RestoreDefaultsIntro}" />
        </Grid>
      </StackPanel>
    </ScrollViewer>

    <views:FooterView x:Name="Footer" Grid.Row="1" DataContext="{Binding Footer}" IsEnabled="{Binding DataContext.IsBodyEnabled, RelativeSource={RelativeSource AncestorType=UserControl, AncestorLevel=1}}" />

    <!-- The icon picker, over the page and the footer (the tabs are disabled meanwhile through the shell; the caption buttons and
         dragging still work). A click on a card applies it at once, so there is no done button; the close button, Escape and a
         click on the dimmed page close it, and closing undoes nothing. -->
    <Grid x:Name="IconPicker" Grid.RowSpan="2" Visibility="{Binding IsIconPickerOpen, Converter={StaticResource BoolToVisibility}}">
      <Border Style="{StaticResource OverlayScrim}" MouseLeftButtonDown="IconPickerScrim_MouseLeftButtonDown" />
      <ContentControl x:Name="IconPickerSheet" Style="{StaticResource OverlaySheet}" Width="456">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <Grid Style="{StaticResource OverlaySheetHeader}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="Icon" Style="{StaticResource Subheading}" />
              <TextBlock x:Name="IconPickerNoteText" Text="{Binding IconPickerNote}" AutomationProperties.LiveSetting="Polite">
                <TextBlock.Style>
                  <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding HasIconError}" Value="True">
                        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
            </StackPanel>
            <Button x:Name="BtnCloseIconPicker" Grid.Column="1" Style="{StaticResource IconButton}" VerticalAlignment="Top"
                    Command="{Binding CloseIconPickerCommand}" ToolTip="Close" AutomationProperties.Name="Close the icon picker">
              <controls:Icon Kind="Close" Size="16" />
            </Button>
          </Grid>

          <ScrollViewer x:Name="IconScroller" Grid.Row="1" Margin="0,0,0,8" Focusable="False" IsTabStop="False"
                        VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ListBox x:Name="IconList" ItemsSource="{Binding IconOptionsView}" SelectedItem="{Binding SelectedIcon}"
                     ItemContainerStyle="{StaticResource IconCard}" Width="428" HorizontalAlignment="Center"
                     Background="Transparent" BorderThickness="0"
                     KeyboardNavigation.DirectionalNavigation="Contained" AutomationProperties.Name="Icons">
              <!-- Only the cards: the scroller around the list scrolls them -->
              <ListBox.Template>
                <ControlTemplate TargetType="ListBox">
                  <ItemsPresenter />
                </ControlTemplate>
              </ListBox.Template>
              <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel />
                </ItemsPanelTemplate>
              </ListBox.ItemsPanel>
              <ListBox.GroupStyle>
                <GroupStyle>
                  <!-- The stock group indents its items by 5, which would push the second card of a row onto the next -->
                  <GroupStyle.ContainerStyle>
                    <Style TargetType="GroupItem">
                      <Setter Property="Template">
                        <Setter.Value>
                          <ControlTemplate TargetType="GroupItem">
                            <StackPanel>
                              <ContentPresenter />
                              <ItemsPresenter />
                            </StackPanel>
                          </ControlTemplate>
                        </Setter.Value>
                      </Setter>
                    </Style>
                  </GroupStyle.ContainerStyle>
                  <GroupStyle.HeaderTemplate>
                    <DataTemplate>
                      <controls:SectionLabel Text="{Binding Name}" Margin="4,8,0,8" AutomationProperties.HeadingLevel="Level3" />
                    </DataTemplate>
                  </GroupStyle.HeaderTemplate>
                </GroupStyle>
              </ListBox.GroupStyle>
            </ListBox>
          </ScrollViewer>
        </Grid>
      </ContentControl>
    </Grid>
  </Grid>
</UserControl>
