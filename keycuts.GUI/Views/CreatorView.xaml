<UserControl x:Class="keycuts.GUI.Views.CreatorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:keycuts.GUI.Controls"
             xmlns:themes="clr-namespace:keycuts.GUI.Themes"
             xmlns:views="clr-namespace:keycuts.GUI.Views"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:design="clr-namespace:keycuts.GUI.DesignData"
             mc:Ignorable="d" d:DataContext="{x:Static design:DesignViewModels.CreatorUrl}"
             Background="{DynamicResource SurfaceBrush}" Loaded="CreatorView_Loaded"
             PreviewKeyDown="CreatorView_PreviewKeyDown" PreviewKeyUp="CreatorView_PreviewKeyUp"
             IsKeyboardFocusWithinChanged="CreatorView_IsKeyboardFocusWithinChanged"
             PreviewDragEnter="Creator_DragEnter" PreviewDragOver="Creator_DragOver" PreviewDragLeave="Creator_DragLeave"
             PreviewDrop="Creator_Drop"
             AllowDrop="{Binding IsInputEnabled}">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

    <!-- Borderless single-line field that sits inside the drop area; focus is shown on the drop area instead. -->
    <Style x:Key="InlineTextBox" TargetType="TextBox">
      <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
      <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}" />
      <Setter Property="SelectionBrush" Value="{DynamicResource AccentBrush}" />
      <Setter Property="SelectionTextBrush" Value="{DynamicResource OnAccentBrush}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="MinHeight" Value="22" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="AllowDrop" Value="True" />
      <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Grid Background="Transparent">
              <ScrollViewer x:Name="PART_ContentHost" Padding="{TemplateBinding Padding}" Focusable="False"
                            VerticalAlignment="Center" HorizontalScrollBarVisibility="Hidden"
                            VerticalScrollBarVisibility="Hidden" />
              <TextBlock x:Name="Placeholder" Visibility="Collapsed" IsHitTestVisible="False" Margin="2,0,0,0"
                         Text="{TemplateBinding themes:TextBoxChrome.Placeholder}" VerticalAlignment="Center"
                         TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextSecondaryBrush}" />
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="Text" Value="">
                <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Placeholder" Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="Text" Value="">
          <Setter Property="ToolTipService.IsEnabled" Value="False" />
        </Trigger>
        <Trigger Property="IsEnabled" Value="False">
          <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
        </Trigger>
      </Style.Triggers>
    </Style>

    <!-- Drop area layers: the dashed outline, the fill, and the soft glow around it. -->
    <Style x:Key="DropStroke" TargetType="Rectangle">
      <Setter Property="RadiusX" Value="12" />
      <Setter Property="RadiusY" Value="12" />
      <Setter Property="StrokeThickness" Value="1" />
      <Setter Property="Stroke" Value="{DynamicResource BorderStrongBrush}" />
      <Setter Property="StrokeDashArray">
        <Setter.Value>
          <DoubleCollection>4 3</DoubleCollection>
        </Setter.Value>
      </Setter>
      <Setter Property="IsHitTestVisible" Value="False" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsKeyboardFocusWithin, ElementName=DropArea}" Value="True">
          <Setter Property="Stroke" Value="{DynamicResource AccentBrush}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding ShowTargetError}" Value="True">
          <Setter Property="Stroke" Value="{DynamicResource DangerBrush}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding ShowDragHover}" Value="True">
          <Setter Property="Stroke" Value="{DynamicResource AccentBrush}" />
          <Setter Property="StrokeThickness" Value="2" />
          <Setter Property="StrokeDashArray" Value="{x:Null}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="DropFill" TargetType="Border">
      <Setter Property="CornerRadius" Value="{StaticResource RadiusLg}" />
      <Setter Property="Background" Value="{DynamicResource SurfaceSubtleBrush}" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding ShowTargetError}" Value="True">
          <Setter Property="Background" Value="{DynamicResource DangerSoftBrush}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding ShowDragHover}" Value="True">
          <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="DropGlow" TargetType="Border">
      <Setter Property="Margin" Value="-3" />
      <Setter Property="BorderThickness" Value="3" />
      <Setter Property="CornerRadius" Value="15" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
      <Setter Property="Opacity" Value="0" />
      <Setter Property="IsHitTestVisible" Value="False" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsKeyboardFocusWithin, ElementName=DropArea}" Value="True">
          <Setter Property="Opacity" Value="0.2" />
        </DataTrigger>
        <MultiDataTrigger>
          <MultiDataTrigger.Conditions>
            <Condition Binding="{Binding IsKeyboardFocusWithin, ElementName=DropArea}" Value="True" />
            <Condition Binding="{Binding ShowTargetError}" Value="True" />
          </MultiDataTrigger.Conditions>
          <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
        </MultiDataTrigger>
        <DataTrigger Binding="{Binding ShowDragHover}" Value="True">
          <Setter Property="Margin" Value="-4" />
          <Setter Property="BorderThickness" Value="4" />
          <Setter Property="CornerRadius" Value="16" />
          <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
          <Setter Property="Opacity" Value="0.2" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <!-- A field label that is also a button (#205): "Description (optional)" hides its box, "Add a description" shows it. It looks
         like the "Name" label, and turns to the accent on hover so it reads as clickable. -->
    <Style x:Key="FieldLabelButton" TargetType="Button">
      <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
      <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="FocusVisualStyle" Value="{StaticResource AppFocusVisual}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
              <ContentPresenter RecognizesAccessKey="False" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
        </Trigger>
        <Trigger Property="IsEnabled" Value="False">
          <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
          <Setter Property="Cursor" Value="Arrow" />
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="HelperText" TargetType="TextBlock">
      <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
      <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="AutomationProperties.LiveSetting" Value="Polite" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding HelperIsError}" Value="True">
          <Setter Property="AutomationProperties.LiveSetting" Value="Assertive" />
        </DataTrigger>
        <DataTrigger Binding="{Binding IsSuccess}" Value="True">
          <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding HelperIsError}" Value="True">
          <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <!-- The name form's helper line also shows name warnings (#153), in amber; an error still wins. It wraps, since a
         warning names a full path. -->
    <Style x:Key="NameHelperText" TargetType="TextBlock" BasedOn="{StaticResource HelperText}">
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="TextTrimming" Value="None" />
      <Setter Property="VerticalAlignment" Value="Top" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsSuccess}" Value="True">
          <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding HelperIsWarning}" Value="True">
          <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
          <Setter Property="AutomationProperties.LiveSetting" Value="Assertive" />
        </DataTrigger>
        <DataTrigger Binding="{Binding HelperIsError}" Value="True">
          <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
          <Setter Property="AutomationProperties.LiveSetting" Value="Assertive" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="BrowseMenuItem" TargetType="MenuItem" BasedOn="{StaticResource AppMenuItem}">
      <Setter Property="MinHeight" Value="46" />
    </Style>
  </UserControl.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- 16 at the bottom: the same gap as between the Name and Description fields, so the window ends where its content does -->
    <Grid Grid.Row="0" Margin="20,20,20,16">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <Grid Grid.Row="0" Margin="0,0,0,16">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="keycuts creator" FontSize="{StaticResource FontSizeHeading}" FontWeight="SemiBold"
                   VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}"
                   AutomationProperties.HeadingLevel="Level1" />
        <!-- Lowercase on purpose: the manager's own heading is "keycuts manager" -->
        <Button x:Name="BtnManager" Grid.Column="1" Style="{StaticResource SecondaryButton}" VerticalAlignment="Center"
                AutomationProperties.Name="manager"
                Margin="12,0,0,0" Command="{Binding ShowManagerCommand}">
          <StackPanel Orientation="Horizontal">
            <controls:Icon Kind="Table" Size="15" />
            <TextBlock Text="manager" Margin="8,0,0,0" />
          </StackPanel>
        </Button>
      </Grid>

      <!-- First-run welcome (#61, #11): shown once, while the keycuts folder is empty. Collapsed without a Welcome. -->
      <Border x:Name="WelcomePanel" Grid.Row="1" DataContext="{Binding Welcome}" Margin="0,0,0,18" Padding="14,12"
              CornerRadius="{StaticResource RadiusLg}" Background="{DynamicResource AccentSoftBrush}"
              Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}">
        <StackPanel>
          <TextBlock Text="Welcome to keycuts" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"
                     AutomationProperties.HeadingLevel="Level2" />
          <TextBlock TextWrapping="Wrap" Margin="0,4,0,10" Foreground="{DynamicResource TextSecondaryBrush}"
                     Text="Give anything a short name here. Then press Win+R, type the name, and press Enter to open it." />
          <TextBlock Text="Start with a keycut to keycuts itself:" FontWeight="SemiBold" Margin="0,0,0,6"
                     Foreground="{DynamicResource TextBrush}" />
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="TextboxWelcomeName" Height="34" MinHeight="34"
                     Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                     themes:TextBoxChrome.HasError="{Binding HelperIsError}"
                     IsEnabled="{Binding IsInputEnabled}" AutomationProperties.Name="Name for the keycuts keycut"
                     AutomationProperties.HelpText="{Binding HelperText}">
              <TextBox.InputBindings>
                <KeyBinding Key="Return" Command="{Binding CreateCommand}" />
              </TextBox.InputBindings>
            </TextBox>
            <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Height="34" Padding="12,0"
                    Command="{Binding CreateCommand}" Content="Create keycut"
                    AutomationProperties.Name="Create keycut to keycuts" />
            <Button Grid.Column="2" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Height="34" Padding="12,0"
                    Command="{Binding DismissCommand}" Content="Got it" AutomationProperties.Name="Dismiss welcome" />
          </Grid>
          <TextBlock x:Name="WelcomeHelperTextBlock" Margin="0,8,0,0" Text="{Binding HelperText}"
                     Style="{StaticResource HelperText}" TextWrapping="Wrap" TextTrimming="None" />
          <!-- Only after a create, when the keycuts folder isn't on PATH yet (a portable copy), so Win+R can't find it -->
          <Button Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Margin="0,8,0,0" Height="34"
                  Padding="12,0" Command="{Binding AddToPathCommand}" Content="Add to PATH"
                  AutomationProperties.Name="Add the keycuts folder to PATH"
                  Visibility="{Binding NeedsPath, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}" />
        </StackPanel>
      </Border>

      <!-- Target drop area -->
      <Grid x:Name="DropArea" Grid.Row="2" MinHeight="96">
        <Border Style="{StaticResource DropGlow}" />
        <Border Style="{StaticResource DropFill}" />
        <Rectangle Style="{StaticResource DropStroke}" />
        <Grid Margin="10,18">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <Border Width="42" Height="42" CornerRadius="11" Background="{DynamicResource AccentSoftBrush}"
                  VerticalAlignment="Center">
            <controls:Icon Kind="{Binding TargetIcon}" Size="23" HorizontalAlignment="Center"
                           VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}" />
          </Border>

          <StackPanel Grid.Column="1" Margin="10,0" VerticalAlignment="Center">
            <TextBlock Text="Target" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" />
            <!-- #205: a long target wraps and the box grows with it, so there is no ellipsis. Not being edited, it shows the path
                 as it will be saved (#31): with %VAR% while Shift is held or the setting is on (TargetText). -->
            <TextBox x:Name="TextboxTarget" Style="{StaticResource InlineTextBox}" Margin="-2,4,0,0"
                     Text="{Binding TargetText, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap"
                     themes:TextBoxChrome.Placeholder="Drop or paste a file, folder, URL ..."
                     IsEnabled="{Binding IsInputEnabled}" AutomationProperties.Name="Target"
                     AutomationProperties.HelpText="{Binding TargetHelpText}"
                     PreviewKeyDown="TextboxTarget_PreviewKeyDown" TextChanged="TextboxTarget_TextChanged"
                     LostFocus="TextboxTarget_LostFocus"
                     IsKeyboardFocusWithinChanged="TextboxTarget_IsKeyboardFocusWithinChanged" />
          </StackPanel>

          <!-- Icon-only, like the Settings window's folder button: the tooltip and the automation name say "Browse". Centered in
               the box, so it stays so when a long target wraps and the box grows. -->
          <controls:MenuButton x:Name="BtnBrowse" Grid.Column="2" Style="{StaticResource SecondaryButton}" VerticalAlignment="Center"
                  Width="40" Height="40" Padding="0"
                  Click="Browse_Click" PreviewKeyDown="Browse_PreviewKeyDown" ContextMenuOpening="Browse_ContextMenuOpening" IsEnabled="{Binding IsInputEnabled}"
                  ToolTip="Browse" AutomationProperties.Name="Browse">
            <controls:Icon Kind="Folder" Size="18" VerticalAlignment="Center" />
            <Button.ContextMenu>
              <ContextMenu x:Name="BrowseMenu" Width="190" Opened="BrowseMenu_Opened" Closed="BrowseMenu_Closed"
                           PreviewKeyDown="BrowseMenu_PreviewKeyDown">
                <MenuItem Style="{StaticResource BrowseMenuItem}" AutomationProperties.Name="File…"
                          Command="{Binding BrowseFileCommand}">
                  <MenuItem.Icon>
                    <controls:Icon Kind="File" Size="16" Foreground="{DynamicResource AccentBrush}" />
                  </MenuItem.Icon>
                  <MenuItem.Header>
                    <StackPanel>
                      <TextBlock Text="File…" FontWeight="Bold" FontSize="{StaticResource FontSizeBody}" />
                      <TextBlock Text="Choose a single file" FontSize="{StaticResource FontSizeEyebrow}" Margin="0,2,0,0"
                                 Foreground="{DynamicResource TextTertiaryBrush}" />
                    </StackPanel>
                  </MenuItem.Header>
                </MenuItem>
                <MenuItem Style="{StaticResource BrowseMenuItem}" AutomationProperties.Name="Folder…"
                          Command="{Binding BrowseFolderCommand}">
                  <MenuItem.Icon>
                    <controls:Icon Kind="Folder" Size="16" Foreground="{DynamicResource AccentBrush}" />
                  </MenuItem.Icon>
                  <MenuItem.Header>
                    <StackPanel>
                      <TextBlock Text="Folder…" FontWeight="Bold" FontSize="{StaticResource FontSizeBody}" />
                      <TextBlock Text="Choose a directory" FontSize="{StaticResource FontSizeEyebrow}" Margin="0,2,0,0"
                                 Foreground="{DynamicResource TextTertiaryBrush}" />
                    </StackPanel>
                  </MenuItem.Header>
                </MenuItem>
              </ContextMenu>
            </Button.ContextMenu>
          </controls:MenuButton>
        </Grid>
      </Grid>

      <!-- Name form -->
      <StackPanel Grid.Row="3" Margin="0,16,0,0">
        <TextBlock Text="Name" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,6" />
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBox x:Name="TextboxShortcut" Height="38" MinHeight="38"
                   Text="{Binding ShortcutName, UpdateSourceTrigger=PropertyChanged}"
                   themes:TextBoxChrome.Placeholder="e.g. art"
                   themes:TextBoxChrome.HasError="{Binding IsNameError}"
                   themes:TextBoxChrome.HasWarning="{Binding IsNameWarning}"
                   IsEnabled="{Binding IsInputEnabled}" AutomationProperties.Name="Keycut name"
                   AutomationProperties.HelpText="{Binding NameHelpText}"
                   TextChanged="TextboxShortcut_TextChanged">
            <TextBox.InputBindings>
              <!-- Enter creates only from the name field; Shift+Enter too, with the environment-variables setting flipped -->
              <KeyBinding Key="Return" Command="{Binding CreateCommand}" />
              <KeyBinding Key="Return" Modifiers="Shift" Command="{Binding CreateCommand}" />
            </TextBox.InputBindings>
          </TextBox>
          <!-- Icon-only (#205): a white rocket on the same solid blue. The tooltip and the automation name are "Create", or
               "Saving" while the keycut is being written, when the rocket gives way to the spinner. The tooltip also shows while
               the button is disabled, so the bare icon can always be identified. -->
          <Button x:Name="BtnCreateShortcut" Grid.Column="1" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0"
                  Width="38" Height="38" Padding="0" Command="{Binding CreateCommand}"
                  ToolTip="{Binding CreateButtonName}" ToolTipService.ShowOnDisabled="True"
                  AutomationProperties.Name="{Binding CreateButtonName}">
            <Grid>
              <controls:Icon Kind="Rocket" Size="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                <controls:Icon.Style>
                  <Style TargetType="controls:Icon">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsSaving}" Value="True">
                        <Setter Property="Visibility" Value="Collapsed" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </controls:Icon.Style>
              </controls:Icon>
              <Control HorizontalAlignment="Center" VerticalAlignment="Center" Width="14" Height="14"
                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}">
                <Control.Style>
                  <Style TargetType="Control" BasedOn="{StaticResource Spinner}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsSaving}" Value="True">
                        <Setter Property="Visibility" Value="Visible" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Control.Style>
              </Control>
            </Grid>
          </Button>
        </Grid>
        <!-- Warnings, errors and the success message; takes no room (#205) while there is nothing to say -->
        <DockPanel Margin="0,8,0,0" MinHeight="18"
                   Visibility="{Binding HasHelperText, Converter={StaticResource BoolToVisibility}}">
          <controls:Icon DockPanel.Dock="Left" Kind="Warning" Size="14" Margin="0,1,6,0" VerticalAlignment="Top"
                         Foreground="{DynamicResource WarningBrush}">
            <controls:Icon.Style>
              <Style TargetType="controls:Icon">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding HelperIsWarning}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </controls:Icon.Style>
          </controls:Icon>
          <controls:Icon DockPanel.Dock="Left" Kind="Check" Size="14" Margin="0,0,6,0" VerticalAlignment="Center"
                         Foreground="{DynamicResource SuccessBrush}">
            <controls:Icon.Style>
              <Style TargetType="controls:Icon">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsSuccess}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </controls:Icon.Style>
          </controls:Icon>
          <TextBlock x:Name="HelperTextBlock" Text="{Binding HelperText}" Style="{StaticResource NameHelperText}" />
        </DockPanel>

        <!-- #162, #205: the description is optional. Its label is a button: "Add a description" shows the box and
             "Description (optional)" hides it, the choice being remembered between launches. Styled like the "Name" label,
             with the same 16 above it as between Target and Name. -->
        <Button x:Name="BtnToggleDescription" Style="{StaticResource FieldLabelButton}" HorizontalAlignment="Left"
                Margin="0,16,0,0" Command="{Binding ToggleDescriptionCommand}"
                Content="{Binding DescriptionToggleText}" AutomationProperties.Name="{Binding DescriptionToggleName}"
                IsEnabled="{Binding IsInputEnabled}" />
        <TextBox x:Name="TextboxDescription" Height="38" MinHeight="38" Margin="0,6,0,0"
                 Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                 themes:TextBoxChrome.Placeholder="e.g. Recent paintings"
                 IsEnabled="{Binding IsInputEnabled}" AutomationProperties.Name="Description"
                 Visibility="{Binding IsDescriptionVisible, Converter={StaticResource BoolToVisibility}}">
          <TextBox.InputBindings>
            <KeyBinding Key="Return" Command="{Binding CreateCommand}" />
            <KeyBinding Key="Return" Modifiers="Shift" Command="{Binding CreateCommand}" />
          </TextBox.InputBindings>
        </TextBox>
      </StackPanel>
    </Grid>

    <!-- #205: the footer both screens share (Settings, the count, the update line) -->
    <views:FooterView Grid.Row="1" />
  </Grid>
</UserControl>
