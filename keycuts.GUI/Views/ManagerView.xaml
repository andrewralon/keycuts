<UserControl x:Class="keycuts.GUI.Views.ManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:keycuts.GUI.Controls"
             xmlns:themes="clr-namespace:keycuts.GUI.Themes"
             xmlns:views="clr-namespace:keycuts.GUI.Views"
             xmlns:vm="clr-namespace:keycuts.GUI.ViewModels"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:design="clr-namespace:keycuts.GUI.DesignData"
             mc:Ignorable="d" d:DataContext="{x:Static design:DesignViewModels.ManagerTwoItems}"
             Background="{DynamicResource SurfaceBrush}"
             Loaded="ManagerView_Loaded" PreviewKeyDown="ManagerView_PreviewKeyDown"
             PreviewMouseDown="ManagerView_PreviewMouseDown" ContextMenuOpening="ManagerView_ContextMenuOpening">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

    <!-- The Manager, for the column headers: a column that starts hidden builds its header off the visual tree, where a
         RelativeSource binding fails for good (BindingProxy) -->
    <controls:BindingProxy x:Key="ManagerProxy" Data="{Binding}" />

    <!-- Single-line table text: trims with an ellipsis and shows the full value in a tooltip. -->
    <Style x:Key="CellText" TargetType="TextBlock">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
      <Setter Property="TextWrapping" Value="NoWrap" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
      <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
      <Style.Triggers>
        <Trigger Property="Text" Value="">
          <Setter Property="ToolTipService.IsEnabled" Value="False" />
        </Trigger>
      </Style.Triggers>
    </Style>

    <!-- The divider between two column headers, to drag (#202). Wider than it looks, so it's easy to hit; the line shows on
         hover and turns to the accent while dragging. Mouse only: the full values are in the cells' tooltips. -->
    <Style x:Key="ColumnGripper" TargetType="Thumb">
      <Setter Property="Width" Value="9" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Cursor" Value="SizeWE" />
      <Setter Property="Focusable" Value="False" />
      <!-- A double click on a divider would size the column to its content (see Gripper_PreviewMouseDoubleClick) -->
      <EventSetter Event="PreviewMouseDoubleClick" Handler="Gripper_PreviewMouseDoubleClick" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Thumb">
            <Border Background="{TemplateBinding Background}">
              <Rectangle x:Name="Line" Width="2" Margin="0,8" HorizontalAlignment="Center"
                         Fill="{DynamicResource BorderStrongBrush}" Opacity="0" SnapsToDevicePixels="True" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Line" Property="Opacity" Value="1" />
              </Trigger>
              <Trigger Property="IsDragging" Value="True">
                <Setter TargetName="Line" Property="Opacity" Value="1" />
                <Setter TargetName="Line" Property="Fill" Value="{DynamicResource AccentBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- 12 at the left, like the cells; 4 at the right, which the label's sort chevron may run into, 16 short of the next label -->
    <Style x:Key="ManagerHeader" TargetType="DataGridColumnHeader">
      <Setter Property="Height" Value="36" />
      <Setter Property="Padding" Value="12,0,4,0" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="IsTabStop" Value="False" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="DataGridColumnHeader">
            <Grid>
              <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Left" RecognizesAccessKey="False"
                                  SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
              </Border>
              <!-- The grid finds these two by name and hides the one a column can't use (a fixed column, the first one's left).
                   It sets the thumb's own Visibility, so a header that must not offer one (see Tag, below) collapses its host. -->
              <Border x:Name="LeftGripperHost" HorizontalAlignment="Left">
                <Thumb x:Name="PART_LeftHeaderGripper" Style="{StaticResource ColumnGripper}" />
              </Border>
              <Border x:Name="RightGripperHost" HorizontalAlignment="Right">
                <Thumb x:Name="PART_RightHeaderGripper" Style="{StaticResource ColumnGripper}" />
              </Border>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="Tag" Value="NoRightGripper">
                <Setter TargetName="RightGripperHost" Property="Visibility" Value="Collapsed" />
              </Trigger>
              <Trigger Property="Tag" Value="NoGrippers">
                <Setter TargetName="LeftGripperHost" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="RightGripperHost" Property="Visibility" Value="Collapsed" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- The last column that gives way: the divider on its right can't move, since the fixed columns beside it are pinned -->
    <Style x:Key="ManagerHeaderPinnedRight" TargetType="DataGridColumnHeader" BasedOn="{StaticResource ManagerHeader}">
      <Setter Property="Tag" Value="NoRightGripper" />
    </Style>

    <!-- The fixed columns (Modified, Runs, Last run): their left divider would resize the column before them, whose right edge is pinned -->
    <Style x:Key="ManagerHeaderFixed" TargetType="DataGridColumnHeader" BasedOn="{StaticResource ManagerHeader}">
      <Setter Property="Tag" Value="NoGrippers" />
    </Style>

    <!-- Sortable column header: label plus a chevron that shows on hover and for the active column. Smaller than 24, it passes
         WCAG 2.5.8 by spacing: it sits alone in a 36 high header, well clear of the next one. -->
    <Style x:Key="SortHeaderButtonStyle" TargetType="controls:SortHeaderButton">
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
      <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <!-- Pulled left by the frame's 1 border and 4 padding, so the label starts where its column's values do (12 in) -->
      <Setter Property="Margin" Value="-5,0,0,0" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="ActiveColumn" Value="{Binding Data.SortColumn, Source={StaticResource ManagerProxy}}" />
      <Setter Property="IsDescending" Value="{Binding Data.SortDescending, Source={StaticResource ManagerProxy}}" />
      <Setter Property="Command" Value="{Binding Data.SortCommand, Source={StaticResource ManagerProxy}}" />
      <Setter Property="CommandParameter" Value="{Binding Column, RelativeSource={RelativeSource Self}}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="controls:SortHeaderButton">
            <!-- The frame shows keyboard focus; 2 above and below keep it close to the 12px label (an optical offset) -->
            <Border x:Name="Frame" Background="Transparent" BorderBrush="Transparent" BorderThickness="1"
                    CornerRadius="{StaticResource RadiusSm}" Padding="4,2">
              <StackPanel Orientation="Horizontal">
                <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="False" />
                <controls:Icon x:Name="Chevron" Kind="Chevron" Size="12" Margin="4,0,0,0" Opacity="0"
                               VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                  <controls:Icon.RenderTransform>
                    <RotateTransform Angle="90" />
                  </controls:Icon.RenderTransform>
                </controls:Icon>
              </StackPanel>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                <Setter TargetName="Chevron" Property="Opacity" Value="1" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                <Setter TargetName="Chevron" Property="Opacity" Value="1" />
              </Trigger>
              <Trigger Property="State" Value="Ascending">
                <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
                <Setter TargetName="Chevron" Property="Opacity" Value="1" />
                <Setter TargetName="Chevron" Property="RenderTransform">
                  <Setter.Value>
                    <RotateTransform Angle="-90" />
                  </Setter.Value>
                </Setter>
              </Trigger>
              <Trigger Property="State" Value="Descending">
                <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
                <Setter TargetName="Chevron" Property="Opacity" Value="1" />
                <Setter TargetName="Chevron" Property="RenderTransform">
                  <Setter.Value>
                    <RotateTransform Angle="90" />
                  </Setter.Value>
                </Setter>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Rows take no keyboard focus: Up and Down move the selection while focus stays in the search box.
         The bar keeps the selection visible in high contrast, where the tint disappears. -->
    <Style x:Key="ManagerRow" TargetType="DataGridRow">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Cursor" Value="Arrow" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="IsTabStop" Value="False" />
      <Setter Property="ValidationErrorTemplate" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="DataGridRow">
            <Border Background="{TemplateBinding Background}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,0,1" SnapsToDevicePixels="True">
              <Grid>
                <DataGridCellsPresenter ItemsPanel="{TemplateBinding ItemsPanel}"
                                        SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                <Rectangle x:Name="SelectionBar" Width="3" HorizontalAlignment="Left" Visibility="Collapsed"
                           Fill="{DynamicResource AccentBrush}" />
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="SelectionBar" Property="Visibility" Value="Visible" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
        </Trigger>
        <DataTrigger Binding="{Binding IsMenuOpen}" Value="True">
          <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
        </DataTrigger>
        <Trigger Property="IsSelected" Value="True">
          <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="ManagerCell" TargetType="DataGridCell">
      <Setter Property="Focusable" Value="False" />
      <Setter Property="IsTabStop" Value="False" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="12,0" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="DataGridCell">
            <Border Background="Transparent" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
              <ContentPresenter VerticalAlignment="Center" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- A type badge has its own border and fill, so 4 at its right is enough: 16 short of the description, and the widest badge
         (Command) fits a 104 column -->
    <Style x:Key="ManagerBadgeCell" TargetType="DataGridCell" BasedOn="{StaticResource ManagerCell}">
      <Setter Property="Padding" Value="12,0,4,0" />
    </Style>

    <Style x:Key="ManagerTable" TargetType="DataGrid">
      <Setter Property="AutoGenerateColumns" Value="False" />
      <Setter Property="IsReadOnly" Value="True" />
      <Setter Property="CanUserAddRows" Value="False" />
      <Setter Property="CanUserDeleteRows" Value="False" />
      <Setter Property="CanUserResizeRows" Value="False" />
      <!-- Name, Description and Target can be dragged (#202); the others say CanUserResize="False" -->
      <Setter Property="CanUserResizeColumns" Value="True" />
      <Setter Property="CanUserReorderColumns" Value="False" />
      <Setter Property="CanUserSortColumns" Value="False" />
      <Setter Property="ClipboardCopyMode" Value="None" />
      <Setter Property="HeadersVisibility" Value="Column" />
      <Setter Property="GridLinesVisibility" Value="None" />
      <Setter Property="SelectionMode" Value="Single" />
      <Setter Property="SelectionUnit" Value="FullRow" />
      <Setter Property="RowHeight" Value="36" />
      <Setter Property="ColumnHeaderHeight" Value="36" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
      <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="EnableRowVirtualization" Value="True" />
      <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
      <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
      <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
      <Setter Property="ColumnHeaderStyle" Value="{StaticResource ManagerHeader}" />
      <Setter Property="RowStyle" Value="{StaticResource ManagerRow}" />
      <Setter Property="CellStyle" Value="{StaticResource ManagerCell}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="DataGrid">
            <Border Background="{TemplateBinding Background}" BorderThickness="{TemplateBinding BorderThickness}"
                    SnapsToDevicePixels="True">
              <ScrollViewer x:Name="DG_ScrollViewer" Focusable="False">
                <ScrollViewer.Template>
                  <ControlTemplate TargetType="ScrollViewer">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                      </Grid.RowDefinitions>
                      <Border Grid.ColumnSpan="2" Background="{DynamicResource SurfaceSubtleBrush}"
                              BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" />
                      <DataGridColumnHeadersPresenter x:Name="PART_ColumnHeadersPresenter" />
                      <ScrollContentPresenter x:Name="PART_ScrollContentPresenter" Grid.Row="1"
                                              CanContentScroll="{TemplateBinding CanContentScroll}" />
                      <ScrollBar x:Name="PART_VerticalScrollBar" Grid.Column="1" Grid.Row="1"
                                 Maximum="{TemplateBinding ScrollableHeight}"
                                 ViewportSize="{TemplateBinding ViewportHeight}"
                                 Value="{Binding VerticalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"
                                 Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" />
                    </Grid>
                  </ControlTemplate>
                </ScrollViewer.Template>
                <ItemsPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
              </ScrollViewer>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- A row's actions: each row gets its own copy (x:Shared="False"), so the menu's bindings follow that row. 250 wide for the
         key names beside the items. Right-clicking a row opens it at the pointer; Shift+F10 or the Menu key opens the selected
         row's under that row (ManagerView_ContextMenuOpening). A screen reader names it after its keycut. -->
    <ContextMenu x:Key="RowMenu" x:Shared="False" Width="250" AutomationProperties.Name="{Binding ActionsLabel}"
                 Opened="RowMenu_Opened" Closed="RowMenu_Closed" PreviewKeyDown="RowMenuPopup_PreviewKeyDown">
      <MenuItem Header="Open keycut" InputGestureText="Enter" Command="{Binding OpenCommand}" Click="SafeItem_Click">
        <MenuItem.Icon>
          <controls:Icon Kind="Play" Size="16" />
        </MenuItem.Icon>
      </MenuItem>
      <!-- #202: greyed out for a keycut the form can't save, and the tooltip (shown on the disabled item) says why -->
      <MenuItem Header="Edit…" InputGestureText="Ctrl+E" Command="{Binding EditCommand}" Click="SafeItem_Click">
        <MenuItem.Style>
          <Style TargetType="MenuItem" BasedOn="{StaticResource AppMenuItem}">
            <Setter Property="ToolTip" Value="{Binding EditTooltip}" />
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
            <Setter Property="ToolTipService.IsEnabled" Value="False" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding CanEditInForm}" Value="False">
                <Setter Property="ToolTipService.IsEnabled" Value="True" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </MenuItem.Style>
        <MenuItem.Icon>
          <controls:Icon Kind="File" Size="16" />
        </MenuItem.Icon>
      </MenuItem>
      <MenuItem Header="Edit in Notepad" InputGestureText="Ctrl+Shift+E" Command="{Binding EditInNotepadCommand}" Click="SafeItem_Click">
        <MenuItem.Icon>
          <controls:Icon Kind="External" Size="16" />
        </MenuItem.Icon>
      </MenuItem>
      <MenuItem Header="Open file location" InputGestureText="Ctrl+Shift+O" Command="{Binding OpenFileLocationCommand}" Click="SafeItem_Click">
        <MenuItem.Icon>
          <controls:Icon Kind="Folder" Size="16" />
        </MenuItem.Icon>
      </MenuItem>
      <MenuItem Header="Copy target" InputGestureText="Ctrl+C" Command="{Binding CopyTargetCommand}" Click="SafeItem_Click">
        <MenuItem.Icon>
          <controls:Icon Kind="Copy" Size="16" />
        </MenuItem.Icon>
      </MenuItem>
      <!-- No SafeItem_Click: the focus goes to the name or description box -->
      <MenuItem Header="Rename" InputGestureText="F2" Command="{Binding RenameCommand}" />
      <MenuItem Header="Edit description" InputGestureText="Shift+F2" Command="{Binding EditDescriptionCommand}" />
      <Separator />
      <MenuItem Header="Delete" InputGestureText="Delete" Style="{StaticResource DangerMenuItem}" Command="{Binding DeleteCommand}">
        <MenuItem.Icon>
          <controls:Icon Kind="Delete" Size="16" Foreground="{DynamicResource DangerBrush}" />
        </MenuItem.Icon>
      </MenuItem>
    </ContextMenu>
  </UserControl.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Margin="24,16,24,12">
      <!-- The Creator's fields in one row (docs/styleguide.md, The Manager's create row), 16 above the search box. Its keys are its
           own: ManagerView_PreviewKeyDown leaves them alone. A Manager without one (tests, design data) builds nothing here. -->
      <ContentControl x:Name="CreateRowHost" Margin="0,0,0,16" Content="{Binding CreateRow}" Focusable="False" IsTabStop="False"
                      Visibility="{Binding HasCreateRow, Converter={StaticResource BoolToVisibility}}">
        <ContentControl.Resources>
          <DataTemplate DataType="{x:Type vm:CreatorViewModel}">
            <views:CreateRowView />
          </DataTemplate>
        </ContentControl.Resources>
      </ContentControl>

      <!-- The search box, then the Manager's message (Undo, Deleted, errors) while there is one, then the count -->
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid>
          <TextBox x:Name="SearchBox" Style="{StaticResource AppTextBox}" Padding="36,0,12,0"
                   Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                   IsEnabled="{Binding CanSearch}" IsEnabledChanged="SearchBox_IsEnabledChanged"
                   themes:TextBoxChrome.Placeholder="Search names, types, descriptions, or targets"
                   AutomationProperties.Name="Search keycuts">
            <!-- A box's own menu, as WPF would build it. Set here, so WPF doesn't open its built-in one before the view can give
                 Shift+F10 and the Menu key to the selected row while the box is empty (ManagerView_ContextMenuOpening) -->
            <TextBox.ContextMenu>
              <ContextMenu>
                <MenuItem Command="ApplicationCommands.Cut" />
                <MenuItem Command="ApplicationCommands.Copy" />
                <MenuItem Command="ApplicationCommands.Paste" />
              </ContextMenu>
            </TextBox.ContextMenu>
          </TextBox>
          <controls:Icon Kind="Search" Size="16" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0,0,0"
                         IsHitTestVisible="False" Foreground="{DynamicResource TextTertiaryBrush}" />
        </Grid>
        <views:ManagerStatusView Grid.Column="1" VerticalAlignment="Center" />
        <!-- The count: "355 keycuts", or "4 of 355 keycuts" while a search hides some. Fully round: the radius is half its height. -->
        <Border x:Name="CountPill" Grid.Column="2" Margin="12,0,0,0" Height="22" Padding="8,0" CornerRadius="11"
                Background="{DynamicResource SurfaceSubtleBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                VerticalAlignment="Center">
          <TextBlock x:Name="CountText" Text="{Binding CountText}" FontSize="{StaticResource FontSizeCaption}" FontWeight="SemiBold"
                     Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"
                     AutomationProperties.LiveSetting="Polite" />
        </Border>
      </Grid>
    </StackPanel>

    <!-- 24 at the bottom, like every page: the bar under it is there only while a newer version is out. The table is a whole
         number of rows tall (TableArea_SizeChanged), so no row shows cut off at its bottom; what is left over goes under it. -->
    <Grid x:Name="TableArea" Grid.Row="1" Margin="24,0,24,24" SizeChanged="TableArea_SizeChanged">
      <!-- Populated -->
      <Border x:Name="TableHost" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" VerticalAlignment="Top"
              CornerRadius="{StaticResource RadiusMd}" SizeChanged="TableHost_SizeChanged"
              Visibility="{Binding IsTableVisible, Converter={StaticResource BoolToVisibility}}">
        <DataGrid x:Name="Table" Style="{StaticResource ManagerTable}" ItemsSource="{Binding Rows}"
                  SelectedItem="{Binding SelectedRow}" AutomationProperties.Name="keycuts" LoadingRow="Table_LoadingRow"
                  KeyboardNavigation.TabNavigation="Continue">
          <DataGrid.Columns>
            <!-- A click on the name or description cell of the selected row edits it in place (#202; see ManagerView_PreviewMouseDown) -->
            <DataGridTemplateColumn x:Name="NameColumn" Width="1.2*" MinWidth="120">
              <DataGridTemplateColumn.Header>
                <controls:SortHeaderButton Column="Shortcut" Content="Name" Style="{StaticResource SortHeaderButtonStyle}" />
              </DataGridTemplateColumn.Header>
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}">
                      <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource CellText}">
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding IsRenaming}" Value="True">
                              <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>
                    <!-- Rename in place (F2, Rename, or a click on the selected row): Enter saves, Escape cancels, clicking or tabbing away saves -->
                    <TextBox Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}" Height="30" MinHeight="30"
                             Visibility="{Binding IsRenaming, Converter={StaticResource BoolToVisibility}}"
                             AutomationProperties.Name="{Binding RenameLabel}"
                             IsVisibleChanged="RenameBox_IsVisibleChanged" PreviewKeyDown="RenameBox_PreviewKeyDown"
                             LostKeyboardFocus="RenameBox_LostKeyboardFocus" />
                    <StackPanel Orientation="Horizontal" ToolTip="{Binding MissingTooltip}"
                                Visibility="{Binding ShowMissingIndicator, Converter={StaticResource BoolToVisibility}}">
                      <controls:Icon Kind="Close" Size="12" VerticalAlignment="Center"
                                     Foreground="{DynamicResource DangerBrush}" />
                      <TextBlock Text="Missing" Margin="4,0,0,0" FontSize="{StaticResource FontSizeCaption}"
                                 VerticalAlignment="Center" Foreground="{DynamicResource DangerBrush}" />
                    </StackPanel>
                    <!-- #203: starts, but something it names is wrong (a start-in folder that doesn't exist). WarningBrush is yellow
                         in the dark palette and a dark amber in the light one, where yellow text can't be read. -->
                    <StackPanel Orientation="Horizontal" ToolTip="{Binding WarningTooltip}"
                                Visibility="{Binding ShowWarningIndicator, Converter={StaticResource BoolToVisibility}}">
                      <controls:Icon Kind="Warning" Size="12" VerticalAlignment="Center"
                                     Foreground="{DynamicResource WarningBrush}" />
                      <TextBlock Text="Warning" Margin="4,0,0,0" FontSize="{StaticResource FontSizeCaption}"
                                 VerticalAlignment="Center" Foreground="{DynamicResource WarningBrush}" />
                    </StackPanel>
                  </StackPanel>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <!-- Type, Modified, Runs and Last run are fixed: the same MinWidth as Width, or the grid squeezes them to its default 20
                 when the table jumps narrower than all the columns need (a snap, a restore), and keeps them squeezed after the
                 Modified column has made way again -->
            <DataGridTemplateColumn Width="104" MinWidth="104" CanUserResize="False" CellStyle="{StaticResource ManagerBadgeCell}">
              <DataGridTemplateColumn.Header>
                <controls:SortHeaderButton Column="Type" Content="Type" Style="{StaticResource SortHeaderButtonStyle}" />
              </DataGridTemplateColumn.Header>
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <controls:TypeBadge Kind="{Binding Kind}" HorizontalAlignment="Left" VerticalAlignment="Center" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn x:Name="DescriptionColumn" Width="*" MinWidth="100">
              <DataGridTemplateColumn.Header>
                <controls:SortHeaderButton Column="Description" Content="Description" Style="{StaticResource SortHeaderButtonStyle}" />
              </DataGridTemplateColumn.Header>
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <Grid VerticalAlignment="Center">
                    <TextBlock Text="{Binding Description}">
                      <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource CellText}">
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding IsEditingDescription}" Value="True">
                              <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>
                    <!-- Edit in place (Shift+F2, Edit description, or a click on the selected row): Enter saves, Escape cancels, clicking or tabbing away saves -->
                    <TextBox Text="{Binding EditDescription, UpdateSourceTrigger=PropertyChanged}" Height="30" MinHeight="30"
                             themes:TextBoxChrome.Placeholder="Add a description"
                             Visibility="{Binding IsEditingDescription, Converter={StaticResource BoolToVisibility}}"
                             AutomationProperties.Name="{Binding DescriptionLabel}"
                             IsVisibleChanged="DescriptionBox_IsVisibleChanged" PreviewKeyDown="DescriptionBox_PreviewKeyDown"
                             LostKeyboardFocus="DescriptionBox_LostKeyboardFocus" />
                  </Grid>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <!-- Target is resizable, and the columns to its left give way to it. Its right edge is pinned by the fixed columns
                 beside it, which the grid can't move, so there is no gripper there (#202) -->
            <DataGridTemplateColumn Width="3.4*" MinWidth="160" HeaderStyle="{StaticResource ManagerHeaderPinnedRight}">
              <DataGridTemplateColumn.Header>
                <controls:SortHeaderButton Column="Target" Content="Target" Style="{StaticResource SortHeaderButtonStyle}" />
              </DataGridTemplateColumn.Header>
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <!-- The cell shows the program; the tooltip adds its arguments (#203) -->
                  <TextBlock Style="{StaticResource CellText}" Text="{Binding Target}" ToolTip="{Binding TargetTooltip}" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <!-- #187: how often each keycut runs and when it last did, for cleaning up. They make way only after Modified does
                 (TableHost_SizeChanged). A dash is no record, which isn't the same as 0. Their headers say when counting started (#235),
                 so a low count reads as new rather than unused. -->
            <DataGridTemplateColumn x:Name="RunsColumn" Width="64" MinWidth="64" CanUserResize="False"
                                    HeaderStyle="{StaticResource ManagerHeaderFixed}">
              <DataGridTemplateColumn.Header>
                <controls:SortHeaderButton Column="Runs" Content="Runs" Note="{Binding Data.CountingSinceText, Source={StaticResource ManagerProxy}}"
                                           Style="{StaticResource SortHeaderButtonStyle}" />
              </DataGridTemplateColumn.Header>
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <TextBlock Style="{StaticResource CellText}" Text="{Binding RunsText}" ToolTip="{Binding RunsTooltip}" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn x:Name="LastRunColumn" Width="112" MinWidth="112" CanUserResize="False"
                                    HeaderStyle="{StaticResource ManagerHeaderFixed}">
              <DataGridTemplateColumn.Header>
                <controls:SortHeaderButton Column="LastRun" Content="Last run" Note="{Binding Data.CountingSinceText, Source={StaticResource ManagerProxy}}"
                                           Style="{StaticResource SortHeaderButtonStyle}" />
              </DataGridTemplateColumn.Header>
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <TextBlock Style="{StaticResource CellText}" Text="{Binding LastRunText}" ToolTip="{Binding RunsTooltip}" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <!-- #167: the last column (the owner, 2026-11-17), hidden while the table is too narrow for it (TableHost_SizeChanged), so
                 the other columns keep their room -->
            <DataGridTemplateColumn x:Name="ModifiedColumn" Width="112" MinWidth="112" CanUserResize="False"
                                    HeaderStyle="{StaticResource ManagerHeaderFixed}">
              <DataGridTemplateColumn.Header>
                <controls:SortHeaderButton Column="Modified" Content="Modified" Style="{StaticResource SortHeaderButtonStyle}" />
              </DataGridTemplateColumn.Header>
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <!-- The text is how long ago; the tooltip is the exact date and time -->
                  <TextBlock Style="{StaticResource CellText}" Text="{Binding ModifiedText}" ToolTip="{Binding ModifiedTooltip}" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
          </DataGrid.Columns>
        </DataGrid>
      </Border>

      <!-- Loading -->
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal"
                  Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}">
        <Control Style="{StaticResource Spinner}" VerticalAlignment="Center" />
        <TextBlock Text="Loading keycuts…" Margin="8,0,0,0" VerticalAlignment="Center"
                   Foreground="{DynamicResource TextSecondaryBrush}" />
      </StackPanel>

      <!-- Empty -->
      <Grid Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
        <Rectangle RadiusX="{StaticResource RadiusMdValue}" RadiusY="{StaticResource RadiusMdValue}"
                   Stroke="{DynamicResource BorderStrongBrush}" StrokeThickness="1"
                   StrokeDashArray="4 3" />
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
          <Grid Width="56" Height="56" HorizontalAlignment="Center" Margin="0,0,0,12">
            <Border CornerRadius="{StaticResource RadiusXl}" Background="{DynamicResource AccentSoftBrush}" />
            <controls:Icon Kind="File" Size="32" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{DynamicResource AccentBrush}" />
            <controls:Icon Kind="Spark" Size="16" HorizontalAlignment="Right" VerticalAlignment="Top"
                           Margin="0,4,4,0" Foreground="{DynamicResource AccentBrush}" />
          </Grid>
          <TextBlock Text="No keycuts yet" HorizontalAlignment="Center" Style="{StaticResource Subheading}" />
          <TextBlock Text="Create your first keycut and it will show up here." HorizontalAlignment="Center"
                     Margin="0,0,0,16" Foreground="{DynamicResource TextSecondaryBrush}" />
          <Button x:Name="EmptyCreateButton" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Center" Padding="16,0"
                  Command="{Binding ShowCreatorCommand}">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="create a keycut" />
              <controls:Icon Kind="Arrow" Size="16" Margin="8,0,0,0" />
            </StackPanel>
          </Button>
        </StackPanel>
      </Grid>

      <!-- No search results -->
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                  Visibility="{Binding IsNoResults, Converter={StaticResource BoolToVisibility}}">
        <TextBlock Text="{Binding NoResultsMessage}" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"
                   TextWrapping="NoWrap" MaxWidth="560" Style="{StaticResource Subheading}" />
        <Button Style="{StaticResource SecondaryButton}" Content="clear search" HorizontalAlignment="Center"
                Margin="0,12,0,0" Command="{Binding ClearSearchCommand}" />
      </StackPanel>

      <!-- Load error -->
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="560"
                  Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
        <TextBlock Text="Can’t load your keycuts" HorizontalAlignment="Center" Style="{StaticResource Subheading}"
                   AutomationProperties.LiveSetting="Assertive" Foreground="{DynamicResource DangerBrush}" />
        <TextBlock Text="{Binding ErrorMessage}" HorizontalAlignment="Center" TextAlignment="Center"
                   TextWrapping="Wrap" Margin="0,0,0,16" Foreground="{DynamicResource TextSecondaryBrush}" />
        <Button Style="{StaticResource SecondaryButton}" Content="open settings" HorizontalAlignment="Center"
                Command="{Binding OpenSettingsCommand}" />
      </StackPanel>
    </Grid>

    <!-- #205: the footer the screens share, shown only while a newer version is out -->
    <views:FooterView Grid.Row="2" />
  </Grid>
</UserControl>
