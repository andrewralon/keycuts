#!/bin/sh
# keycuts 2.0.0
# <shortcut>/Users/me/Shortcuts/dl</shortcut>
# <type>folder</type>
# <target>/Users/me/Downloads</target>
# <description></description>
open '/Users/me/Downloads'
s=$?
u="$HOME/Library/Application Support/keycuts/usage"; { mkdir -p "$u" && echo 1 >>"$u/${0##*/}.runs"; } 2>/dev/null
exit $s
