<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>keycuts.CLI</RootNamespace>
    <AssemblyName>keycuts</AssemblyName>
    <UseWindowsForms>false</UseWindowsForms>
    <UseWPF>false</UseWPF>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="CommandLineParser" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\keycuts.Common\keycuts.Common.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The keycuts and keypaste commands (#97, #248): published into a shims folder, which the MSI installs into the keycuts
         folder (on PATH already), so PATH never reaches the self-contained runtime's DLLs next to the exe -->
    <None Update="shims\*.cmd" Link="shims\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>