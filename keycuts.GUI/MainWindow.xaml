<Window x:Class="keycuts.GUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:keycuts.GUI.ViewModels"
        xmlns:views="clr-namespace:keycuts.GUI.Views"
        Title="{Binding Title}" Width="440" SizeToContent="Height" ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True"
        Background="{DynamicResource CanvasBrush}" Foreground="{DynamicResource TextBrush}"
        FontFamily="{StaticResource AppFontFamily}" FontSize="{StaticResource FontSizeBody}"
        KeyDown="Main_KeyDown">
  <Window.Resources>
    <DataTemplate DataType="{x:Type vm:CreatorViewModel}">
      <views:CreatorView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:ManagerViewModel}">
      <views:ManagerView />
    </DataTemplate>
  </Window.Resources>
  <ContentControl Content="{Binding CurrentView}" Focusable="False" IsTabStop="False" />
</Window>
