<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <RootNamespace>keycuts.GUI</RootNamespace>
    <AssemblyName>keycuts.GUI</AssemblyName>
    <!-- Windows without an Icon of their own take this one, so it covers the title bar and the taskbar too -->
    <ApplicationIcon>Images\TR_256_ico.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <None Include="App.config" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\keycuts.Common\keycuts.Common.csproj" />
  </ItemGroup>
</Project>