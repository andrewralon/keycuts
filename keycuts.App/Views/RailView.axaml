<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:keycuts.GUI.Controls"
             xmlns:chrome="using:Avalonia.Controls.Chrome"
             xmlns:vm="using:keycuts.GUI.ViewModels"
             x:Class="keycuts.GUI.Views.RailView"
             x:DataType="vm:ShellViewModel"
             IsTabStop="False" Focusable="False">
  <!-- #218: the tab bar that replaces the title bar (WPF's Views/RailView). Left to right: the app icon (the keycap alone) and the
       name (not a tab), the tabs, the empty bar, and the caption buttons. DragArea, under everything, is the caption (drag, double
       click, the window menu); the icon, the name and the grip let the pointer through to it. The tabs and the caption buttons
       have their own roles, so they get their clicks. Maximize, always disabled, is client, not MaximizeButton: that role would
       open Windows 11's snap layouts over it (docs/macos-port.md, correction 12). -->
  <UserControl.Resources>
    <!-- Glyphs on a 10 x 10 box, the Windows standard size, stroked 1 in the button's foreground -->
    <ControlTheme x:Key="CaptionGlyph" TargetType="Path">
      <Setter Property="Width" Value="10" />
      <Setter Property="Height" Value="10" />
      <Setter Property="StrokeThickness" Value="1" />
      <Setter Property="Stroke" Value="{Binding $parent[Button].Foreground}" />
      <Setter Property="IsHitTestVisible" Value="False" />
    </ControlTheme>
  </UserControl.Resources>

  <Grid x:Name="Bar" Height="{StaticResource RailHeight}" Background="{DynamicResource RailBrush}">
    <Rectangle Fill="{DynamicResource RailTextureBrush}" IsHitTestVisible="False" />
    <Border x:Name="DragArea" Background="Transparent" chrome:WindowDecorationProperties.ElementRole="TitleBar" />

    <Grid ColumnDefinitions="Auto,Auto,*,Auto">
      <!-- The keycap alone at 36, 8 from the edge, 24 to the first tab so the name stands apart from the tabs. 4 at the top moves the
           icon and the name down 2, onto the tab names' line (26 from the top; the tabs lift theirs 2) -->
      <StackPanel x:Name="Brand" Grid.Column="0" Orientation="Horizontal" Margin="8,4,24,0" VerticalAlignment="Center" IsHitTestVisible="False">
        <Image x:Name="AppIcon" Width="36" Height="36" RenderOptions.BitmapInterpolationMode="HighQuality" />
        <TextBlock Text="keycuts" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="{StaticResource FontSizeSubheading}"
                   FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" />
      </StackPanel>

      <controls:RailTabControl x:Name="TabStrip" Grid.Column="1" Theme="{StaticResource RailTabControl}"
                               chrome:WindowDecorationProperties.ElementRole="User"
                               IsEnabled="{Binding AreTabsEnabled, FallbackValue=True}"
                               AutomationProperties.Name="Screens">
        <!-- Text only: the tab is as wide as its name plus the padding and the slant. Ctrl+1, 2 and 3 pick the tabs (MainWindow). -->
        <TabItem x:Name="CreatorTab" Header="creator" AutomationProperties.Name="creator" AutomationProperties.AcceleratorKey="Ctrl+1"
                 ToolTip.Tip="creator (Ctrl+1)" />
        <TabItem x:Name="ManagerTab" Header="manager" AutomationProperties.Name="manager" AutomationProperties.AcceleratorKey="Ctrl+2"
                 ToolTip.Tip="manager (Ctrl+2)" />
        <!-- The gear alone: the tooltip and the automation name say what it is -->
        <TabItem x:Name="SettingsTab" AutomationProperties.Name="settings" AutomationProperties.AcceleratorKey="Ctrl+3"
                 ToolTip.Tip="settings (Ctrl+3)">
          <TabItem.Header>
            <controls:Icon Kind="Settings" Size="20" />
          </TabItem.Header>
        </TabItem>
      </controls:RailTabControl>

      <!-- The faint dot grid that says "grab here", fading out at both ends -->
      <Border Grid.Column="2" Margin="8" CornerRadius="{StaticResource RadiusSm}" Background="{DynamicResource RailGripBrush}" IsHitTestVisible="False">
        <Border.OpacityMask>
          <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
            <GradientStop Color="Transparent" Offset="0" />
            <GradientStop Color="Black" Offset="0.22" />
            <GradientStop Color="Black" Offset="0.78" />
            <GradientStop Color="Transparent" Offset="1" />
          </LinearGradientBrush>
        </Border.OpacityMask>
      </Border>

      <StackPanel x:Name="CaptionButtons" Grid.Column="3" Orientation="Horizontal">
        <Button x:Name="BtnMinimize" Theme="{StaticResource CaptionButton}" ToolTip.Tip="Minimize"
                AutomationProperties.Name="Minimize" Click="Minimize_Click"
                chrome:WindowDecorationProperties.ElementRole="MinimizeButton">
          <Path Theme="{StaticResource CaptionGlyph}" Data="M0,5.5 H10" />
        </Button>
        <!-- Always disabled: the window is never maximized, on any screen (NoMaximizeHook) -->
        <Button x:Name="BtnMaximize" Theme="{StaticResource CaptionButton}" ToolTip.Tip="Maximize"
                AutomationProperties.Name="Maximize" IsEnabled="False"
                chrome:WindowDecorationProperties.ElementRole="User">
          <Path Theme="{StaticResource CaptionGlyph}" Data="M0.5,0.5 H9.5 V9.5 H0.5 Z" />
        </Button>
        <Button x:Name="BtnClose" Theme="{StaticResource CaptionCloseButton}" ToolTip.Tip="Close"
                AutomationProperties.Name="Close" Click="Close_Click"
                chrome:WindowDecorationProperties.ElementRole="CloseButton">
          <Path Theme="{StaticResource CaptionGlyph}" Data="M0,0 L10,10 M10,0 L0,10" />
        </Button>
      </StackPanel>
    </Grid>
  </Grid>
</UserControl>
