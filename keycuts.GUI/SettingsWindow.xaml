<Window x:Name="SettingsWindowName" x:Class="keycuts.GUI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:common="clr-namespace:keycuts.Common;assembly=keycuts.Common"
        xmlns:controls="clr-namespace:keycuts.GUI.Controls"
        xmlns:themes="clr-namespace:keycuts.GUI.Themes"
        xmlns:vm="clr-namespace:keycuts.GUI.ViewModels"
        mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}"
        Title="Settings" Width="500" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" UseLayoutRounding="True"
        Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextBrush}"
        FontFamily="{StaticResource AppFontFamily}" FontSize="{StaticResource FontSizeBody}"
        Loaded="Settings_Loaded" Closed="Settings_Closed">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
            <Setter Property="FontWeight" Value="ExtraBold" />
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="SettingLabel" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,2" />
        </Style>

        <Style x:Key="SettingNote" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <!-- Sits on the "Output folder" label's line, at the right edge. It is the helper text or the validation error, so a long
             error wraps (right-aligned) inside the space the label leaves instead of pushing the box down. -->
        <Style x:Key="FieldMessage" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Margin" Value="12,1,0,0" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasOutputFolderError}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- The folder box shows the error state while the view model has a message for it -->
        <Style x:Key="OutputFolderBox" TargetType="TextBox" BasedOn="{StaticResource AppTextBox}">
            <!-- A long path doesn't fit, so it can be read in full from the tooltip -->
            <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="ToolTipService.IsEnabled" Value="False" />
                </Trigger>
                <DataTrigger Binding="{Binding HasOutputFolderError}" Value="True">
                    <Setter Property="themes:TextBoxChrome.HasError" Value="True" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- No divider between sections: the blue heading and this gap, wider than the 16 between rows, separate them.
             The last row of a section sets Margin="0" so the gap isn't doubled. -->
        <Style x:Key="Section" TargetType="StackPanel">
            <Setter Property="Margin" Value="0,0,0,28" />
        </Style>

        <Style x:Key="SettingRow" TargetType="Grid">
            <Setter Property="Margin" Value="0,0,0,16" />
        </Style>

        <!-- An icon choice as a picture, 52 px. One that follows the theme shows both drawings: the light-mode one at the top
             left, and the dark-mode one over it, smaller, at the bottom right, in a ring of whatever it sits on (a card, a button). -->
        <DataTemplate x:Key="IconPreview" DataType="{x:Type themes:AppIconOption}">
            <Grid Width="52" Height="52" RenderOptions.BitmapScalingMode="HighQuality">
                <Image x:Name="Single" Source="{Binding LightImage}" />
                <Image x:Name="Back" Source="{Binding LightImage}" Width="38" Height="38" HorizontalAlignment="Left" VerticalAlignment="Top"
                       Visibility="Collapsed" />
                <Border x:Name="Front" Width="33" Height="33" Padding="1" CornerRadius="8" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                        Background="{Binding Background, RelativeSource={RelativeSource AncestorType=Border, AncestorLevel=1}}"
                        Visibility="Collapsed">
                    <Image Source="{Binding DarkImage}" />
                </Border>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding FollowsTheme}" Value="True">
                    <Setter TargetName="Single" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="Back" Property="Visibility" Value="Visible" />
                    <Setter TargetName="Front" Property="Visibility" Value="Visible" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- A card in the icon picker. The picked one has the accent border and a check in its corner. Two cards share a row:
             203 wide with 5 on each side, so a row is 426 and the list, 428, centers it with 2 to spare (rounding at any scale
             can't wrap the second). That still fits beside the 12 px scrollbar the picker shows on a short screen. Classic, the
             last, takes the whole row. -->
        <Style x:Key="IconCard" TargetType="ListBoxItem">
            <Setter Property="Width" Value="203" />
            <Setter Property="Margin" Value="5,0,5,10" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource AppFocusVisual}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
            <Setter Property="AutomationProperties.HelpText" Value="{Binding Description}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid>
                            <Border x:Name="Card" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="8" Padding="10" MinHeight="74" SnapsToDevicePixels="True">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource IconPreview}" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Margin="12,0,16,0" VerticalAlignment="Center">
                                        <!-- The list's own Foreground is the system text color, not the palette's -->
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextBrush}" />
                                        <TextBlock Text="{Binding Description}" FontSize="{StaticResource FontSizeCaption}" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,1,0,0" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <Border x:Name="Check" Width="18" Height="18" CornerRadius="9" Margin="0,7,7,0" HorizontalAlignment="Right"
                                    VerticalAlignment="Top" Background="{DynamicResource AccentBrush}"
                                    TextElement.Foreground="{DynamicResource OnAccentBrush}" Visibility="Collapsed">
                                <controls:Icon Kind="Check" Size="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Card" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="Card" Property="BorderThickness" Value="2" />
                                <Setter TargetName="Card" Property="Padding" Value="9" />
                                <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsWide}" Value="True">
                    <Setter Property="Width" Value="416" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <!-- The body scrolls when the window is capped to the screen (high DPI, large text); the footer always stays visible -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer x:Name="BodyScroller" Grid.Row="0" Focusable="False" IsTabStop="False" IsEnabled="{Binding IsBodyEnabled}"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24">
            <!-- Header -->
            <TextBlock Text="Settings" FontSize="{StaticResource FontSizeHeading}" FontWeight="SemiBold" Margin="0,0,0,22"
                       AutomationProperties.HeadingLevel="Level1" />

            <!-- Output -->
            <StackPanel Style="{StaticResource Section}">
                <TextBlock Text="OUTPUT" Style="{StaticResource SectionLabel}" />
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Output folder" Style="{StaticResource FieldLabel}" />
                    <TextBlock x:Name="OutputFolderMessage" Grid.Column="1" Style="{StaticResource FieldMessage}"
                               Text="{Binding OutputFolderMessage}" AutomationProperties.LiveSetting="Assertive" />
                </Grid>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="TextboxOutputFolder" Grid.Column="0" Style="{StaticResource OutputFolderBox}"
                             Text="{Binding OutputFolder, UpdateSourceTrigger=PropertyChanged}"
                             themes:TextBoxChrome.Placeholder="Choose where keycuts are saved"
                             AutomationProperties.Name="Output folder"
                             AutomationProperties.HelpText="{Binding OutputFolderMessage}" />
                    <!-- Icon-only, so each says what it does in a tooltip; the automation names are unchanged -->
                    <Button x:Name="BtnChoose" Grid.Column="1" Margin="8,0,0,0" Padding="12,0" Command="{Binding ChooseCommand}"
                            ToolTip="Choose a folder" AutomationProperties.Name="Choose">
                        <controls:Icon Kind="Folder" Size="17" VerticalAlignment="Center" />
                    </Button>
                    <!-- Disabled while the folder doesn't exist; the tooltip still shows then, so the bare icon can be identified -->
                    <Button x:Name="BtnLaunch" Grid.Column="2" Margin="8,0,0,0" Padding="12,0" Command="{Binding LaunchCommand}"
                            ToolTip="Open the output folder" ToolTipService.ShowOnDisabled="True" AutomationProperties.Name="Launch">
                        <controls:Icon Kind="External" Size="16" VerticalAlignment="Center" />
                    </Button>
                </Grid>
            </StackPanel>

            <!-- Behavior -->
            <StackPanel Style="{StaticResource Section}">
                <TextBlock Text="BEHAVIOR" Style="{StaticResource SectionLabel}" />

                <!-- No visible note: the toggle's help text tells a screen reader what it does -->
                <Grid Style="{StaticResource SettingRow}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Ask before replacing a keycut" Style="{StaticResource SettingLabel}" Margin="0" VerticalAlignment="Center" />
                    <ToggleButton x:Name="ToggleAskBeforeReplacing" Grid.Column="1" Style="{StaticResource ToggleSwitch}" Margin="20,0,0,0"
                                  VerticalAlignment="Center"
                                  IsChecked="{Binding AskBeforeReplacing}" AutomationProperties.Name="Ask before replacing a keycut"
                                  AutomationProperties.HelpText="Confirm before a new keycut replaces one with the same name." />
                </Grid>

                <Grid Style="{StaticResource SettingRow}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Right-click context menus" Style="{StaticResource SettingLabel}" />
                        <TextBlock Text="Add “keycut this!” to File Explorer menus." Style="{StaticResource SettingNote}" />
                    </StackPanel>
                    <ToggleButton x:Name="ToggleRightClick" Grid.Column="1" Style="{StaticResource ToggleSwitch}" Margin="20,0,0,0"
                                  IsChecked="{Binding RightClickContextMenus}" AutomationProperties.Name="Right-click context menus"
                                  AutomationProperties.HelpText="Add “keycut this!” to File Explorer menus." />
                </Grid>

                <!-- #31: save new file and folder keycuts as %USERPROFILE%\... and the like; Shift flips it while creating (the
                     the Creator's Target shows the path that way). The help text says "flip", which is right in both directions: Shift turns it on
                     for one keycut when the setting is off, and off when it is on. -->
                <Grid Style="{StaticResource SettingRow}" Margin="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Use environment variables in paths" Style="{StaticResource SettingLabel}" />
                        <TextBlock Text="Save paths as %USERPROFILE%\… or similar. Hold Shift to preview or create a keycut like this, even when disabled."
                                   Style="{StaticResource SettingNote}" />
                    </StackPanel>
                    <ToggleButton x:Name="ToggleEnvironmentVariables" Grid.Column="1" Style="{StaticResource ToggleSwitch}" Margin="20,0,0,0"
                                  IsChecked="{Binding UseEnvironmentVariables}" AutomationProperties.Name="Use environment variables in paths"
                                  AutomationProperties.HelpText="Saves C:\Users\you\Desktop as %USERPROFILE%\Desktop, so keycuts work on other accounts. Hold Shift while creating to flip it for one keycut." />
                </Grid>
            </StackPanel>

            <!-- Appearance. The icon first: its name and what it does, and the icon itself as the button that opens the picker.
                 Unlike the rest of Settings, a pick applies and is saved at once. -->
            <StackPanel Style="{StaticResource Section}">
                <TextBlock Text="APPEARANCE" Style="{StaticResource SectionLabel}" />
                <Grid Style="{StaticResource SettingRow}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource SettingLabel}">
                            <Run Text="Icon" /><Run Text=" &#x00B7; " FontWeight="Normal" Foreground="{DynamicResource TextSecondaryBrush}" /><Run
                                Text="{Binding SelectedIcon.Name, Mode=OneWay}" FontWeight="Normal" Foreground="{DynamicResource TextSecondaryBrush}" />
                        </TextBlock>
                        <TextBlock x:Name="IconDescription" Text="{Binding SelectedIcon.Description}" Style="{StaticResource SettingNote}" />
                    </StackPanel>
                    <Button x:Name="BtnIcon" Grid.Column="1" Margin="20,0,0,0" Padding="5" VerticalAlignment="Center"
                            Command="{Binding OpenIconPickerCommand}" Content="{Binding SelectedIcon}" ContentTemplate="{StaticResource IconPreview}"
                            ToolTip="Change the icon" AutomationProperties.Name="{Binding IconButtonName}" />
                </Grid>

                <!-- The theme: the label and the three choices share a line -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Theme" Style="{StaticResource SettingLabel}" Margin="0" VerticalAlignment="Center" />
                    <StackPanel x:Name="ThemeChoices" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                        <RadioButton Content="System" GroupName="Theme" Tag="{x:Static common:ThemePreference.System}"
                                     AutomationProperties.Name="System theme" Checked="Theme_Checked" Margin="0,0,16,0" />
                        <RadioButton Content="Light" GroupName="Theme" Tag="{x:Static common:ThemePreference.Light}"
                                     AutomationProperties.Name="Light theme" Checked="Theme_Checked" Margin="0,0,16,0" />
                        <RadioButton Content="Dark" GroupName="Theme" Tag="{x:Static common:ThemePreference.Dark}"
                                     AutomationProperties.Name="Dark theme" Checked="Theme_Checked" />
                    </StackPanel>
                </Grid>
            </StackPanel>

            <!-- Updates (#171): only reads the latest release from GitHub and links to its page -->
            <StackPanel Style="{StaticResource Section}" Margin="0">
                <TextBlock Text="UPDATES" Style="{StaticResource SectionLabel}" />

                <Grid Style="{StaticResource SettingRow}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Check for updates" Style="{StaticResource SettingLabel}" />
                        <TextBlock Text="Once a day, ask GitHub whether a newer version is out." Style="{StaticResource SettingNote}" />
                    </StackPanel>
                    <ToggleButton x:Name="ToggleCheckForUpdates" Grid.Column="1" Style="{StaticResource ToggleSwitch}" Margin="20,0,0,0"
                                  IsChecked="{Binding CheckForUpdates}" AutomationProperties.Name="Check for updates"
                                  AutomationProperties.HelpText="Once a day, ask GitHub whether a newer version is out." />
                </Grid>

                <!-- The version, the update status and Check now: hidden only for the README's screenshots -->
                <Grid x:Name="VersionRow" Visibility="{Binding ShowVersionRow, Converter={StaticResource BoolToVisibility}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="CurrentVersionText" Text="{Binding CurrentVersionText}" Style="{StaticResource SettingLabel}" />
                        <WrapPanel Visibility="{Binding HasUpdateStatus, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock x:Name="UpdateStatusMessage" Text="{Binding UpdateStatusText}" Style="{StaticResource SettingNote}"
                                       AutomationProperties.LiveSetting="Polite" />
                            <!-- Only while a newer release is known -->
                            <TextBlock Style="{StaticResource SettingNote}"
                                       Visibility="{Binding IsUpdateAvailable, Converter={StaticResource BoolToVisibility}}">
                                <Run Text=" &#x00B7; " /><Hyperlink x:Name="SettingsDownloadLink" Command="{Binding DownloadUpdateCommand}"
                                    Foreground="{DynamicResource AccentBrush}" AutomationProperties.Name="Download the new version">Download</Hyperlink>
                            </TextBlock>
                        </WrapPanel>
                    </StackPanel>
                    <Button x:Name="BtnCheckNow" Grid.Column="1" Margin="20,0,0,0" Content="Check now" Style="{StaticResource SecondaryButton}"
                            Command="{Binding CheckNowCommand}" AutomationProperties.Name="Check for updates now"
                            Visibility="{Binding CanCheckForUpdates, Converter={StaticResource BoolToVisibility}}" />
                </Grid>
            </StackPanel>

            <!-- Shown when a save partly failed (for example PATH could not be updated); the window stays open -->
            <TextBlock x:Name="SaveErrorMessage" Text="{Binding SaveError}" Margin="0,14,0,0" TextWrapping="Wrap"
                       Foreground="{DynamicResource DangerBrush}" AutomationProperties.LiveSetting="Assertive"
                       Visibility="{Binding HasSaveError, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>
        </ScrollViewer>

        <!-- Footer. There is no Cancel button: Escape (SettingsWindow.OnKeyDown) and the window's close button leave without saving -->
        <Border Grid.Row="1" Background="{DynamicResource SurfaceSubtleBrush}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0" Padding="24,13" IsEnabled="{Binding IsBodyEnabled}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <!-- Closes Settings and shows the first-run welcome panel in the creator again -->
                <Button x:Name="BtnShowWelcome" Grid.Column="0" Content="Show welcome" Style="{StaticResource SecondaryButton}"
                        Click="ShowWelcome_Click" AutomationProperties.Name="Show the welcome panel" />
                <Button x:Name="BtnSave" Grid.Column="1" Style="{StaticResource PrimaryButton}" IsDefault="True"
                        HorizontalAlignment="Right" Click="Save_Click" AutomationProperties.Name="Save">
                    <StackPanel Orientation="Horizontal">
                        <controls:Icon Kind="Check" Size="16" VerticalAlignment="Center" />
                        <TextBlock Text="Save" Margin="7,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- The icon picker, over the whole window. A click on a card applies it at once, so there is no Done button; the close
             button, Escape and a click on the dimmed window close it, and closing undoes nothing. The window behind is disabled
             meanwhile (IsBodyEnabled), so Tab stays in here and Enter can't press Save. The sheet gets the window's height less
             its margins: when Settings is capped to a short screen (FitToWorkArea), the cards scroll and the header stays. -->
        <Grid x:Name="IconPicker" Grid.RowSpan="2" Visibility="{Binding IsIconPickerOpen, Converter={StaticResource BoolToVisibility}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="*" />
                <RowDefinition Height="14" />
            </Grid.RowDefinitions>
            <Border Grid.RowSpan="3" Background="{DynamicResource ScrimBrush}" MouseLeftButtonDown="IconPickerScrim_MouseLeftButtonDown" />
            <!-- The shadow sits behind the sheet, not on it, so the sheet's text keeps ClearType -->
            <Border Grid.Row="1" Width="456" HorizontalAlignment="Center" VerticalAlignment="Top" CornerRadius="10"
                    Background="{DynamicResource SurfaceRaisedBrush}" Height="{Binding ActualHeight, ElementName=IconPickerSheet}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="28" ShadowDepth="8" Opacity="0.3" Color="{DynamicResource ShadowColor}" />
                </Border.Effect>
            </Border>
            <Border x:Name="IconPickerSheet" Grid.Row="1" Width="456" HorizontalAlignment="Center" VerticalAlignment="Top"
                    CornerRadius="10" Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" KeyboardNavigation.TabNavigation="Cycle">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Margin="18,16,12,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Icon" FontSize="{StaticResource FontSizeHeading}" FontWeight="SemiBold"
                                       AutomationProperties.HeadingLevel="Level2" />
                            <TextBlock x:Name="IconPickerNoteText" Text="{Binding IconPickerNote}" Margin="0,3,0,0"
                                       AutomationProperties.LiveSetting="Polite">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource SettingNote}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasIconError}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                        <Button x:Name="BtnCloseIconPicker" Grid.Column="1" Style="{StaticResource IconButton}" VerticalAlignment="Top"
                                Command="{Binding CloseIconPickerCommand}" ToolTip="Close" AutomationProperties.Name="Close the icon picker">
                            <controls:Icon Kind="Close" Size="16" />
                        </Button>
                    </Grid>

                    <ScrollViewer x:Name="IconScroller" Grid.Row="1" Margin="0,0,0,8" Focusable="False" IsTabStop="False"
                                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ListBox x:Name="IconList" ItemsSource="{Binding IconOptionsView}" SelectedItem="{Binding SelectedIcon}"
                             ItemContainerStyle="{StaticResource IconCard}" Width="428" HorizontalAlignment="Center"
                             Background="Transparent" BorderThickness="0"
                             KeyboardNavigation.DirectionalNavigation="Contained" AutomationProperties.Name="Icons">
                        <!-- Only the cards: the scroller around the list scrolls them -->
                        <ListBox.Template>
                            <ControlTemplate TargetType="ListBox">
                                <ItemsPresenter />
                            </ControlTemplate>
                        </ListBox.Template>
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.GroupStyle>
                            <GroupStyle>
                                <!-- The stock group indents its items by 5, which would push the second card of a row onto the next -->
                                <GroupStyle.ContainerStyle>
                                    <Style TargetType="GroupItem">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="GroupItem">
                                                    <StackPanel>
                                                        <ContentPresenter />
                                                        <ItemsPresenter />
                                                    </StackPanel>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </GroupStyle.ContainerStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" FontSize="{StaticResource FontSizeCaption}" FontWeight="ExtraBold"
                                                   Foreground="{DynamicResource TextTertiaryBrush}" Margin="5,4,0,8"
                                                   AutomationProperties.HeadingLevel="Level3" />
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ListBox.GroupStyle>
                    </ListBox>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
