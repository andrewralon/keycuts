<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <RootNamespace>keycuts.Tests</RootNamespace>
    <AssemblyName>keycuts.Tests</AssemblyName>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- xUnit v3 test projects are executables; VSTest still runs them through xunit.runner.visualstudio. -->
    <OutputType>Exe</OutputType>
    <!-- xUnit1051 (pass TestContext.Current.CancellationToken) arrived with v3. The tests finish in milliseconds and
         use their own tokens, so turning it on would touch some 200 calls for no gain. -->
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="GitHubActionsTestLogger" PrivateAssets="all" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3.mtp-off" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\keycuts.Common\keycuts.Common.csproj" />
    <ProjectReference Include="..\keycuts.GUI\keycuts.GUI.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Helpers shared with keycuts.Common.Tests, which holds the tests that don't need the GUI. -->
    <Compile Include="..\keycuts.Common.Tests\RepoFiles.cs" Link="Shared\RepoFiles.cs" />
    <Compile Include="..\keycuts.Common.Tests\TestNameChecks.cs" Link="Shared\TestNameChecks.cs" />
    <Compile Include="..\keycuts.Common.Tests\UpdateFakes.cs" Link="Shared\UpdateFakes.cs" />
  </ItemGroup>
</Project>
