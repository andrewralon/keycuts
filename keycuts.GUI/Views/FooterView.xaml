<UserControl x:Class="keycuts.GUI.Views.FooterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:keycuts.GUI.Controls"
             xmlns:views="clr-namespace:keycuts.GUI.Views">
  <!-- #205: the footer both screens share. It binds to whichever view model it sits in (the creator's or the manager's), which both
       have KeycutCount, CountDescription and UpdateNotice. Left to right: the count, the screen's own message (Message; the manager's
       Deleted/Undo/error line, which caps its own width), and the update line, right-justified. Settings is a tab (#218), so the
       footer has no gear. Declared left to right, so Tab goes Undo, Download, dismiss. The message takes what it needs up to its cap
       and the update line the rest, wrapping if that is narrow, so neither pushes the count out. -->
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
  </UserControl.Resources>

  <Border Background="{DynamicResource SurfaceSubtleBrush}" BorderBrush="{DynamicResource BorderBrush}"
          BorderThickness="0,1,0,0" Padding="24,0" MinHeight="48">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <!-- Just the number; the tooltip and the screen reader say what it counts (the manager adds "4 of 355" while searching) -->
      <!-- Fully round: the radius is half its height -->
      <Border Grid.Column="0" MinWidth="26" Height="22" Padding="8,0" CornerRadius="11"
              Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
              BorderThickness="1" VerticalAlignment="Center">
        <TextBlock x:Name="CountText" Text="{Binding KeycutCount}" FontSize="{StaticResource FontSizeCaption}"
                   FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   ToolTip="{Binding CountDescription}" AutomationProperties.Name="{Binding CountDescription}"
                   AutomationProperties.LiveSetting="Polite" />
      </Border>

      <ContentPresenter Grid.Column="1" VerticalAlignment="Center"
                        Content="{Binding Message, RelativeSource={RelativeSource AncestorType=views:FooterView}}" />

      <!-- #171: a newer release is out. Collapsed without an UpdateNotice, while there's nothing to say, and after dismissing.
           The text is right-aligned in the space it gets, so the dismiss button follows it closely and the line is
           right-justified; the text wraps when the space is narrow. -->
      <Grid x:Name="UpdateNotice" Grid.Column="2" DataContext="{Binding UpdateNotice}" Margin="16,8,0,8"
            VerticalAlignment="Center"
            Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}"
            DataContextChanged="UpdateNotice_DataContextChanged">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="UpdateNoticeText" Grid.Column="0" HorizontalAlignment="Right" VerticalAlignment="Center"
                   TextWrapping="Wrap" TextAlignment="Right"
                   Foreground="{DynamicResource TextSecondaryBrush}" AutomationProperties.LiveSetting="Polite">
          <Run Text="{Binding Message, Mode=OneWay}" /><Run Text=" &#x00B7; " /><Hyperlink x:Name="UpdateDownloadLink"
              Command="{Binding DownloadCommand}" Foreground="{DynamicResource AccentTextBrush}"
              AutomationProperties.Name="{Binding DownloadName, Mode=OneWay}">download</Hyperlink>
        </TextBlock>
        <Button x:Name="BtnDismissUpdate" Grid.Column="1" Style="{StaticResource IconButton}" VerticalAlignment="Center"
                Command="{Binding DismissCommand}" ToolTip="Dismiss" AutomationProperties.Name="Dismiss update notice">
          <controls:Icon Kind="Close" Size="16" />
        </Button>
      </Grid>
    </Grid>
  </Border>
</UserControl>
