<UserControl x:Class="keycuts.GUI.Views.CreatorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:keycuts.GUI.Controls"
             xmlns:themes="clr-namespace:keycuts.GUI.Themes"
             xmlns:views="clr-namespace:keycuts.GUI.Views"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:design="clr-namespace:keycuts.GUI.DesignData"
             mc:Ignorable="d" d:DataContext="{x:Static design:DesignViewModels.CreatorUrl}"
             Background="{DynamicResource SurfaceBrush}" Loaded="CreatorView_Loaded"
             AllowDrop="{Binding IsInputEnabled}">
  <UserControl.Resources>
    <ResourceDictionary>
      <!-- The drop area, the target box, the name's lines and Browse's menu, shared with the Manager's create row -->
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="CreatorForm.xaml" />
      </ResourceDictionary.MergedDictionaries>

      <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

      <!-- A field label that is also a button (#205): "Description (optional)" shows or hides its box. It looks
           like the "Name" label, and turns to the accent on hover so it reads as clickable. -->
      <Style x:Key="FieldLabelButton" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource AppFocusVisual}" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Button">
              <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                <ContentPresenter RecognizesAccessKey="False" />
              </Border>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
        <Style.Triggers>
          <Trigger Property="IsMouseOver" Value="True">
            <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
          </Trigger>
          <Trigger Property="IsEnabled" Value="False">
            <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
            <Setter Property="Cursor" Value="Arrow" />
          </Trigger>
        </Style.Triggers>
      </Style>

      <!-- The welcome panel's line under the bubbles (#213): the same size and color as the intro above it, which reads better than the
           small tertiary helper text on the blue panel in the dark theme. Only a PATH problem changes it, to the error color. -->
      <Style x:Key="WelcomeHelperText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="AutomationProperties.LiveSetting" Value="Polite" />
        <Style.Triggers>
          <DataTrigger Binding="{Binding HelperIsError}" Value="True">
            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
            <Setter Property="AutomationProperties.LiveSetting" Value="Assertive" />
          </DataTrigger>
        </Style.Triggers>
      </Style>
    </ResourceDictionary>
  </UserControl.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid Grid.Row="0" Margin="{StaticResource PagePadding}">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!-- First-run welcome (#61, #11, #213): shown once, while the keycuts folder is empty. Its bubbles fill an example (a website, a
           folder, keycuts itself) into the fields below instead of the panel having a form of its own. Off while a keycut is being saved,
           like the fields it fills. Collapsed without a Welcome. -->
      <Border x:Name="WelcomePanel" Grid.Row="0" DataContext="{Binding Welcome}" Margin="0,0,0,16" Padding="{StaticResource PanelPadding}"
              IsEnabled="{Binding DataContext.IsInputEnabled, RelativeSource={RelativeSource AncestorType=UserControl}, FallbackValue=True}"
              CornerRadius="{StaticResource RadiusLg}" Background="{DynamicResource AccentSoftBrush}"
              Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}">
        <StackPanel>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Welcome to keycuts!" Style="{StaticResource Subheading}" Margin="0" VerticalAlignment="Center" />
            <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Margin="12,0,0,0"
                    VerticalAlignment="Center" Command="{Binding DismissCommand}" Content="got it"
                    AutomationProperties.Name="got it" AutomationProperties.HelpText="Hides the welcome panel" />
          </Grid>
          <TextBlock TextWrapping="Wrap" Margin="0,4,0,12" Foreground="{DynamicResource TextSecondaryBrush}"
                     Text="keycuts lets you open your apps, files, folders, and websites with short names you choose. Create one here, then press Win+R, type the name, and press Enter to open it." />
          <TextBlock Text="Start by creating one of these keycuts" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" />
          <!-- Three bubbles in a row: type badge, what it opens, an arrow to its name. Each fills the fields below. -->
          <ItemsControl x:Name="WelcomeExamples" ItemsSource="{Binding Examples}" Margin="-4,8,-4,0" IsTabStop="False">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <UniformGrid Rows="1" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <RadioButton Style="{StaticResource CardRadio}" Margin="4,0" HorizontalContentAlignment="Center"
                             IsChecked="{Binding IsSelected, Mode=TwoWay}"
                             Command="{Binding DataContext.SelectExampleCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                             CommandParameter="{Binding}" AutomationProperties.Name="{Binding AutomationName}">
                  <StackPanel HorizontalAlignment="Center">
                    <controls:TypeBadge Kind="{Binding Kind}" HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding Label}" Margin="0,8,0,0" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource TextBrush}" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0">
                      <controls:Icon Kind="Arrow" Size="20" VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}" />
                      <TextBlock Text="{Binding Name}" Margin="8,0,0,0" FontWeight="SemiBold" FontSize="{StaticResource FontSizeInput}"
                                 VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}" />
                    </StackPanel>
                  </StackPanel>
                </RadioButton>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <!-- Empty until a bubble is picked, then which button to click, then how to use the keycut, or the PATH warning -->
          <Grid Margin="0,8,0,0" Visibility="{Binding HasHelperText, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <controls:Icon Kind="Rocket" Size="20" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}"
                           Visibility="{Binding ShowRocket, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}" />
            <!-- The same place and size once the keycut is created (and Win+R can find it), in the success color -->
            <controls:Icon Kind="Check" Size="20" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="{DynamicResource SuccessBrush}"
                           Visibility="{Binding IsSuccess, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}" />
            <TextBlock x:Name="WelcomeHelperTextBlock" Grid.Column="1" Text="{Binding HelperText}"
                       Style="{StaticResource WelcomeHelperText}" />
          </Grid>
          <!-- Only after a create, when the keycuts folder isn't on PATH yet (a portable copy), so Win+R can't find it -->
          <Button Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Margin="0,8,0,0"
                  Command="{Binding AddToPathCommand}" Content="add to PATH" AutomationProperties.Name="add to PATH"
                  AutomationProperties.HelpText="Adds the keycuts folder to PATH, so Win+R can find your keycuts"
                  Visibility="{Binding NeedsPath, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}" />
        </StackPanel>
      </Border>

      <!-- Target drop area -->
      <Grid x:Name="DropArea" Grid.Row="1" MinHeight="96">
        <Border Style="{StaticResource DropGlow}" />
        <Border Style="{StaticResource DropFill}" />
        <Rectangle Style="{StaticResource DropStroke}" />
        <Grid Margin="12,16">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <Border Style="{StaticResource IconTile}" VerticalAlignment="Center">
            <controls:Icon Kind="{Binding TargetIcon}" Size="24" HorizontalAlignment="Center"
                           VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}" />
          </Border>

          <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
            <TextBlock Text="Target" Style="{StaticResource FieldLabel}" Margin="0" />
            <!-- #205: a long target wraps and the box grows with it, so there is no ellipsis. Not being edited, it shows the path
                 as it will be saved (#31): with %VAR% while Shift is held or the setting is on (TargetText). The borderless box
                 sits 2 to the left, so its text lines up with the label. -->
            <TextBox x:Name="TextboxTarget" Style="{StaticResource InlineTextBox}" Margin="-2,4,0,0"
                     Text="{Binding TargetText, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap"
                     themes:TextBoxChrome.Placeholder="Drop or paste a file, folder, or URL"
                     IsEnabled="{Binding IsInputEnabled}" AutomationProperties.Name="Target"
                     AutomationProperties.HelpText="{Binding TargetHelpText}" />
          </StackPanel>

          <!-- Icon-only, like the Settings window's folder button: the tooltip and the automation name say "Browse". Centered in
               the box, so it stays so when a long target wraps and the box grows. -->
          <controls:MenuButton x:Name="BtnBrowse" Grid.Column="2" Style="{StaticResource SquareButton}" VerticalAlignment="Center"
                  IsEnabled="{Binding IsInputEnabled}"
                  ToolTip="Browse" AutomationProperties.Name="Browse">
            <controls:Icon Kind="Folder" Size="20" VerticalAlignment="Center" />
            <Button.ContextMenu>
              <ContextMenu x:Name="BrowseMenu" Width="190">
                <MenuItem Style="{StaticResource BrowseMenuItem}" AutomationProperties.Name="File…"
                          Command="{Binding BrowseFileCommand}">
                  <MenuItem.Icon>
                    <controls:Icon Kind="File" Size="16" Foreground="{DynamicResource AccentBrush}" />
                  </MenuItem.Icon>
                  <MenuItem.Header>
                    <StackPanel>
                      <TextBlock Text="File…" FontWeight="SemiBold" FontSize="{StaticResource FontSizeBody}" />
                      <TextBlock Text="Choose a single file" FontSize="{StaticResource FontSizeCaption}"
                                 Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>
                  </MenuItem.Header>
                </MenuItem>
                <MenuItem Style="{StaticResource BrowseMenuItem}" AutomationProperties.Name="Folder…"
                          Command="{Binding BrowseFolderCommand}">
                  <MenuItem.Icon>
                    <controls:Icon Kind="Folder" Size="16" Foreground="{DynamicResource AccentBrush}" />
                  </MenuItem.Icon>
                  <MenuItem.Header>
                    <StackPanel>
                      <TextBlock Text="Folder…" FontWeight="SemiBold" FontSize="{StaticResource FontSizeBody}" />
                      <TextBlock Text="Choose a directory" FontSize="{StaticResource FontSizeCaption}"
                                 Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>
                  </MenuItem.Header>
                </MenuItem>
              </ContextMenu>
            </Button.ContextMenu>
          </controls:MenuButton>
        </Grid>
      </Grid>

      <!-- Name form -->
      <StackPanel Grid.Row="2" Margin="0,16,0,0">
        <!-- The label, and at its right what is happening to the keycut: "Saving…", then "Created name" (#205). They sit on this
             row, not under the field, so the window keeps its height while a keycut is made. -->
        <Grid Margin="0,0,0,8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="Name" Style="{StaticResource FieldLabel}" Margin="0" />
          <controls:HelperText x:Name="NameStatusTextBlock" Grid.Column="1" Style="{StaticResource NameStatus}"
                               Text="{Binding NameStatusText}"
                               Visibility="{Binding HasNameStatus, Converter={StaticResource BoolToVisibility}}" />
        </Grid>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBox x:Name="TextboxShortcut"
                   Text="{Binding ShortcutName, UpdateSourceTrigger=PropertyChanged}"
                   themes:TextBoxChrome.Placeholder="e.g. art"
                   themes:TextBoxChrome.HasError="{Binding IsNameError}"
                   themes:TextBoxChrome.HasWarning="{Binding IsNameWarning}"
                   IsEnabled="{Binding IsInputEnabled}" AutomationProperties.Name="keycut name"
                   AutomationProperties.HelpText="{Binding NameHelpText}">
            <TextBox.InputBindings>
              <!-- Enter creates only from the name field; Shift+Enter too, with the environment-variables setting flipped -->
              <KeyBinding Key="Return" Command="{Binding CreateCommand}" />
              <KeyBinding Key="Return" Modifiers="Shift" Command="{Binding CreateCommand}" />
            </TextBox.InputBindings>
          </TextBox>
          <!-- Icon-only (#205): a white rocket on the same solid blue. The tooltip and the automation name are "Create", or
               "Saving" while the keycut is being written, when the rocket gives way to the spinner. The tooltip also shows while
               the button is disabled, so the bare icon can always be identified. -->
          <Button x:Name="BtnCreateShortcut" Grid.Column="1" Style="{StaticResource PrimarySquareButton}" Margin="8,0,0,0"
                  Command="{Binding CreateCommand}" ToolTip="{Binding CreateButtonName}"
                  AutomationProperties.Name="{Binding CreateButtonName}">
            <Grid>
              <controls:Icon Kind="Rocket" Size="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                <controls:Icon.Style>
                  <Style TargetType="controls:Icon">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsSaving}" Value="True">
                        <Setter Property="Visibility" Value="Collapsed" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </controls:Icon.Style>
              </controls:Icon>
              <Control HorizontalAlignment="Center" VerticalAlignment="Center" Width="14" Height="14"
                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}">
                <Control.Style>
                  <Style TargetType="Control" BasedOn="{StaticResource Spinner}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsSaving}" Value="True">
                        <Setter Property="Visibility" Value="Visible" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Control.Style>
              </Control>
            </Grid>
          </Button>
        </Grid>
        <!-- Name warnings and errors; takes no room (#205) while there is nothing to say. Saving and Created are above, by the label. -->
        <controls:HelperText x:Name="HelperTextBlock" Style="{StaticResource NameHelper}" Text="{Binding HelperText}"
                             Visibility="{Binding ShowHelperLine, Converter={StaticResource BoolToVisibility}}" />

        <!-- #162, #205: the description is optional. Its label, "Description (optional)", is a button that shows the box and
             hides it, the choice being remembered between launches. Styled like the "Name" label,
             with the same 16 above it as between Target and Name. -->
        <Button x:Name="BtnToggleDescription" Style="{StaticResource FieldLabelButton}" HorizontalAlignment="Left"
                Margin="0,16,0,0" Command="{Binding ToggleDescriptionCommand}"
                Content="{Binding DescriptionToggleText}" AutomationProperties.Name="{Binding DescriptionToggleName}"
                IsEnabled="{Binding IsInputEnabled}" />
        <TextBox x:Name="TextboxDescription" Margin="0,8,0,0"
                 Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                 themes:TextBoxChrome.Placeholder="e.g. Recent paintings"
                 IsEnabled="{Binding IsInputEnabled}" AutomationProperties.Name="Description"
                 Visibility="{Binding IsDescriptionVisible, Converter={StaticResource BoolToVisibility}}">
          <TextBox.InputBindings>
            <KeyBinding Key="Return" Command="{Binding CreateCommand}" />
            <KeyBinding Key="Return" Modifiers="Shift" Command="{Binding CreateCommand}" />
          </TextBox.InputBindings>
        </TextBox>
      </StackPanel>
    </Grid>

    <!-- #205: the footer both screens share (Settings, the count, the update line) -->
    <views:FooterView Grid.Row="1" />
  </Grid>
</UserControl>
