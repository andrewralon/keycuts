<Window x:Class="keycuts.GUI.ConfirmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:keycuts.GUI.Controls"
        xmlns:vm="clr-namespace:keycuts.GUI.ViewModels"
        mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=vm:ConfirmViewModel}"
        Title="{Binding Title}" Width="440" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" UseLayoutRounding="True"
        Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextBrush}"
        FontFamily="{StaticResource AppFontFamily}" FontSize="{StaticResource FontSizeBody}"
        Loaded="Confirm_Loaded">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <!-- Same as the Settings window's field labels and section labels -->
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource FontSizeEyebrow}" />
            <Setter Property="FontWeight" Value="ExtraBold" />
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>

        <Style x:Key="DestinationText" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        </Style>
    </Window.Resources>

    <!-- The body scrolls when the window is capped to the screen (high DPI, large text); the footer always stays visible -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" Focusable="False" IsTabStop="False"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="24">
                <!-- Header -->
                <Grid Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="38" Height="38" CornerRadius="10" Background="{DynamicResource SurfaceSubtleBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" VerticalAlignment="Top">
                        <controls:Icon Kind="Warning" Size="20" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{DynamicResource WarningBrush}" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="14,0,0,0">
                        <TextBlock x:Name="HeadingText" Text="{Binding Heading}" FontSize="{StaticResource FontSizeHeading}"
                                   FontWeight="SemiBold" TextWrapping="Wrap" AutomationProperties.HeadingLevel="Level1" />
                        <TextBlock Text="{Binding Intro}" Margin="0,4,0,0" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>
                </Grid>

                <!-- A replace: what the keycut opens now, and what it will open -->
                <Border Padding="14,12" Margin="0,0,0,14" CornerRadius="{StaticResource RadiusLg}"
                        Background="{DynamicResource SurfaceSubtleBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                        Visibility="{Binding ShowDestinations, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock Text="OPENS NOW" Style="{StaticResource SectionLabel}" />
                        <TextBlock x:Name="CurrentDestinationText" Text="{Binding CurrentDestination}" Style="{StaticResource DestinationText}"
                                   AutomationProperties.Name="{Binding CurrentDestination, StringFormat='Opens now: {0}'}" />
                        <TextBlock Text="WILL OPEN" Style="{StaticResource SectionLabel}" Margin="0,12,0,4" />
                        <TextBlock x:Name="NewDestinationText" Text="{Binding NewDestination}" Style="{StaticResource DestinationText}"
                                   AutomationProperties.Name="{Binding NewDestination, StringFormat='Will open: {0}'}" />
                    </StackPanel>
                </Border>

                <!-- Other commands with this name, most important first -->
                <ItemsControl x:Name="WarningList" ItemsSource="{Binding Warnings}" Focusable="False" IsTabStop="False"
                              Visibility="{Binding ShowWarnings, Converter={StaticResource BoolToVisibility}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <controls:Icon Kind="Warning" Size="15" Margin="0,1,8,0" VerticalAlignment="Top"
                                               Foreground="{DynamicResource WarningBrush}" />
                                <TextBlock Grid.Column="1" Text="{Binding}" TextWrapping="Wrap" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer, as in Settings: Cancel and Escape keep things as they are; Enter goes ahead -->
        <Border Grid.Row="1" Background="{DynamicResource SurfaceSubtleBrush}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0" Padding="24,13">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnCancel" Content="Cancel" Style="{StaticResource SecondaryButton}" IsCancel="True" />
                <Button x:Name="BtnConfirm" Style="{StaticResource PrimaryButton}" IsDefault="True" Margin="8,0,0,0"
                        Click="Confirm_Click" AutomationProperties.Name="{Binding ConfirmText}"
                        AutomationProperties.HelpText="{Binding Summary}">
                    <StackPanel Orientation="Horizontal">
                        <controls:Icon Kind="Check" Size="16" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding ConfirmText}" Margin="7,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>
