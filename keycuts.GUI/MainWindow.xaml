<Window x:Class="keycuts.GUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:vm="clr-namespace:keycuts.GUI.ViewModels"
        xmlns:views="clr-namespace:keycuts.GUI.Views"
        Title="{Binding Title}" Width="{StaticResource MainWidth}" SizeToContent="Height" ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True"
        Background="{DynamicResource CanvasBrush}" Foreground="{DynamicResource TextBrush}"
        FontFamily="{StaticResource AppFontFamily}" FontSize="{StaticResource FontSizeBody}"
        KeyDown="Main_KeyDown">
  <!-- #218: no standard title bar. The tab bar (RailView) is the top row and does what a title bar does: WindowChrome makes
       RailHeight of it a caption (drag, double click, snap, the window menu) and leaves the resize border on the Manager, the shadow,
       the rounded corners and Aero Snap to Windows. The tabs and caption buttons are marked IsHitTestVisibleInChrome in RailView.
       The Title stays "keycuts" for the taskbar and Alt+Tab. -->
  <shell:WindowChrome.WindowChrome>
    <!-- The Creator is fixed-size (ResizeMode.CanMinimize), but WindowChrome would still answer a resize edge at the border, with the
         resize cursor and no resizing: the border is 0 there, and MainWindow sets it for the Manager. -->
    <shell:WindowChrome CaptionHeight="{StaticResource RailHeight}" ResizeBorderThickness="0"
                        GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
  </shell:WindowChrome.WindowChrome>
  <Window.Resources>
    <DataTemplate DataType="{x:Type vm:CreatorViewModel}">
      <views:CreatorView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:ManagerViewModel}">
      <views:ManagerView />
    </DataTemplate>
  </Window.Resources>
  <Grid x:Name="Frame">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <views:RailView x:Name="Rail" Grid.Row="0" />
    <ContentControl Grid.Row="1" Content="{Binding CurrentView}" Focusable="False" IsTabStop="False" />
  </Grid>
</Window>
