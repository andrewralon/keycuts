<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>keycuts.CLI</RootNamespace>
    <AssemblyName>keycuts</AssemblyName>
    <UseWindowsForms>false</UseWindowsForms>
    <UseWPF>false</UseWPF>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="CommandLineParser" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\keycuts.Common\keycuts.Common.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- keypaste.exe became "keycuts paste" (#97); the shim keeps "keypaste <name>" working from the install folder on PATH -->
    <None Include="keypaste.cmd" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>