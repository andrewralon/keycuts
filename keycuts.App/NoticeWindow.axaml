<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:keycuts.GUI.Controls"
        x:Class="keycuts.GUI.NoticeWindow"
        Title="keycuts" Width="{StaticResource ConfirmWidth}" SizeToContent="Height" CanResize="False" CanMaximize="False"
        CanMinimize="False" ShowInTaskbar="False" WindowStartupLocation="CenterOwner" UseLayoutRounding="True"
        Background="{DynamicResource SurfaceBrush}" FontSize="{StaticResource FontSizeBody}">
  <!-- A message with an OK button: what WPF showed with MessageBox (the startup notices, a crash). Avalonia has no message box, so
       this is the confirmation's look with one button. -->
  <Grid RowDefinitions="*,Auto">
    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <Grid Margin="{StaticResource PagePadding}" ColumnDefinitions="Auto,*">
        <Border Theme="{StaticResource IconTile}" Background="{DynamicResource SurfaceSubtleBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" VerticalAlignment="Top">
          <controls:Icon x:Name="NoticeIcon" Kind="Check" Size="24" HorizontalAlignment="Center" VerticalAlignment="Center"
                         Foreground="{DynamicResource AccentBrush}" />
        </Border>
        <TextBlock x:Name="MessageText" Grid.Column="1" Margin="12,0,0,0" TextWrapping="Wrap" VerticalAlignment="Center"
                   Foreground="{DynamicResource TextBrush}" />
      </Grid>
    </ScrollViewer>
    <Border Grid.Row="1" Theme="{StaticResource DialogFooter}">
      <Button x:Name="BtnOk" Theme="{StaticResource PrimaryButton}" HorizontalAlignment="Right" IsDefault="True" IsCancel="True"
              Content="ok" Click="Ok_Click" />
    </Border>
  </Grid>
</Window>
