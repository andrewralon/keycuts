<UserControl x:Class="keycuts.GUI.Views.RailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
             xmlns:controls="clr-namespace:keycuts.GUI.Controls"
             IsTabStop="False" Focusable="False">
  <!-- #218: the tab bar that replaces the title bar. Left to right: the app icon in a recessed square and the name (not a tab), the
       tabs (creator, manager, and the settings gear), the empty bar, and the caption buttons. WindowChrome (MainWindow) makes the whole
       bar a caption, drag, double click, snap and the window menu included, except what is marked IsHitTestVisibleInChrome: the tabs
       and the caption buttons. The textures are palette brushes, so high contrast drops them. -->
  <UserControl.Resources>
    <!-- Glyphs on a 10 x 10 box, the Windows standard size, stroked 1 in the button's foreground -->
    <Style x:Key="CaptionGlyph" TargetType="Path">
      <Setter Property="Width" Value="10" />
      <Setter Property="Height" Value="10" />
      <Setter Property="StrokeThickness" Value="1" />
      <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
      <Setter Property="SnapsToDevicePixels" Value="True" />
      <Setter Property="IsHitTestVisible" Value="False" />
    </Style>
  </UserControl.Resources>

  <Grid x:Name="Bar" Height="{StaticResource RailHeight}" Background="{DynamicResource RailBrush}">
    <Rectangle Fill="{DynamicResource RailTextureBrush}" IsHitTestVisible="False" />

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <!-- 12 from the edge, 16 to the first tab so the name stands apart from the tabs -->
      <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="12,0,16,0" VerticalAlignment="Center">
        <Border Width="28" Height="28" CornerRadius="{StaticResource RadiusMd}" Background="{DynamicResource SocketBrush}"
                BorderBrush="{DynamicResource SocketBorderBrush}" BorderThickness="1">
          <Image x:Name="AppIcon" Width="20" Height="20" RenderOptions.BitmapScalingMode="HighQuality" />
        </Border>
        <TextBlock Text="keycuts" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="{StaticResource FontSizeSubheading}"
                   FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" />
      </StackPanel>

      <controls:RailTabControl x:Name="TabStrip" Grid.Column="1" Style="{StaticResource RailTabControl}"
                               shell:WindowChrome.IsHitTestVisibleInChrome="True"
                               IsEnabled="{Binding AreTabsEnabled, FallbackValue=True}"
                               AutomationProperties.Name="Screens">
        <TabItem x:Name="CreatorTab" AutomationProperties.Name="creator" ToolTip="creator">
          <TabItem.Header>
            <StackPanel Orientation="Horizontal">
              <controls:Icon Kind="Spark" Size="16" />
              <TextBlock Text="creator" Margin="8,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
          </TabItem.Header>
        </TabItem>
        <TabItem x:Name="ManagerTab" AutomationProperties.Name="manager" ToolTip="manager">
          <TabItem.Header>
            <StackPanel Orientation="Horizontal">
              <controls:Icon Kind="Table" Size="16" />
              <TextBlock Text="manager" Margin="8,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
          </TabItem.Header>
        </TabItem>
        <!-- The gear alone: the tooltip and the automation name say what it is -->
        <TabItem x:Name="SettingsTab" AutomationProperties.Name="settings" ToolTip="settings">
          <TabItem.Header>
            <controls:Icon Kind="Settings" Size="16" />
          </TabItem.Header>
        </TabItem>
      </controls:RailTabControl>

      <!-- The faint dot grid that says "grab here", fading out at both ends -->
      <Border Grid.Column="2" Margin="8" CornerRadius="{StaticResource RadiusSm}" Background="{DynamicResource RailGripBrush}" IsHitTestVisible="False">
        <Border.OpacityMask>
          <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="Transparent" Offset="0" />
            <GradientStop Color="Black" Offset="0.22" />
            <GradientStop Color="Black" Offset="0.78" />
            <GradientStop Color="Transparent" Offset="1" />
          </LinearGradientBrush>
        </Border.OpacityMask>
      </Border>

      <StackPanel Grid.Column="3" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
        <Button x:Name="BtnMinimize" Style="{StaticResource CaptionButton}" ToolTip="Minimize"
                AutomationProperties.Name="Minimize" Click="Minimize_Click">
          <Path Style="{StaticResource CaptionGlyph}" Data="M0,5.5 H10" />
        </Button>
        <Button x:Name="BtnMaximize" Style="{StaticResource CaptionButton}" ToolTip="Maximize"
                AutomationProperties.Name="Maximize" Click="Maximize_Click">
          <Path x:Name="MaximizeGlyph" Style="{StaticResource CaptionGlyph}" Data="M0.5,0.5 H9.5 V9.5 H0.5 Z" />
        </Button>
        <Button x:Name="BtnClose" Style="{StaticResource CaptionCloseButton}" ToolTip="Close"
                AutomationProperties.Name="Close" Click="Close_Click">
          <Path Style="{StaticResource CaptionGlyph}" Data="M0,0 L10,10 M10,0 L0,10" />
        </Button>
      </StackPanel>
    </Grid>
  </Grid>
</UserControl>
