<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:themes="clr-namespace:keycuts.GUI.Themes"
                    xmlns:controls="clr-namespace:keycuts.GUI.Controls">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Tokens.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- All colors are DynamicResource so the palette dictionary can be swapped at runtime. -->

    <!-- Keyboard focus: 2px accent outline offset by 2px. WPF only shows this for keyboard focus. -->
    <Style x:Key="AppFocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="-4" StrokeThickness="2" RadiusX="7" RadiusY="7" SnapsToDevicePixels="True"
                               Stroke="{DynamicResource AccentBrush}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Buttons -->
    <ControlTemplate x:Key="AppButtonTemplate" TargetType="Button">
        <Border Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{StaticResource RadiusSm}"
                SnapsToDevicePixels="True">
            <ContentPresenter Margin="{TemplateBinding Padding}"
                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                              RecognizesAccessKey="True" />
        </Border>
    </ControlTemplate>

    <Style x:Key="BaseButton" TargetType="Button">
        <Setter Property="Template" Value="{StaticResource AppButtonTemplate}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource AppFocusVisual}" />
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="MinHeight" Value="{StaticResource ControlHeight}" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
    </Style>

    <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource TextSecondaryBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{DynamicResource SurfaceSubtleBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
                <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
        <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
        <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource AccentPressedBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource AccentPressedBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{DynamicResource BorderBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
                <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
        <Setter Property="Width" Value="{StaticResource IconButtonSize}" />
        <Setter Property="Height" Value="{StaticResource IconButtonSize}" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
                <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Unstyled buttons (for example in the Settings window) get the secondary look. -->
    <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}" />

    <!-- An icon-only button with a border or fill: square at the height of the text box beside it, with a 20px glyph (Create,
         Browse, choose a folder, open the output folder). Ghost icon buttons with no border are IconButton, 32. -->
    <Style x:Key="SquareButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
        <Setter Property="Width" Value="{StaticResource ControlHeight}" />
        <Setter Property="Height" Value="{StaticResource ControlHeight}" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="0" />
        <!-- A disabled icon-only button keeps its tooltip, so its bare icon can still be identified -->
        <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
    </Style>

    <Style x:Key="PrimarySquareButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
        <Setter Property="Width" Value="{StaticResource ControlHeight}" />
        <Setter Property="Height" Value="{StaticResource ControlHeight}" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
    </Style>

    <!-- TextBox: 36px, accent border plus soft glow on focus; ErrorTextBox (or Validation.HasError) shows the danger state. -->
    <Style x:Key="AppTextBox" TargetType="TextBox">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeInput}" />
        <Setter Property="MinHeight" Value="{StaticResource InputHeight}" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="AllowDrop" Value="True" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
        <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource AccentBrush}" />
        <Setter Property="SelectionTextBrush" Value="{DynamicResource OnAccentBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Grid>
                        <Border x:Name="Glow" Margin="-3" BorderThickness="3" Opacity="0"
                                CornerRadius="8" BorderBrush="{DynamicResource AccentBrush}" IsHitTestVisible="False" />
                        <Border x:Name="Box" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource RadiusSm}" SnapsToDevicePixels="True">
                            <Grid>
                                <ScrollViewer x:Name="PART_ContentHost"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
                                <TextBlock x:Name="Placeholder" Margin="{TemplateBinding Padding}" Visibility="Collapsed"
                                           Text="{TemplateBinding themes:TextBoxChrome.Placeholder}" IsHitTestVisible="False"
                                           VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                           TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextTertiaryBrush}" />
                            </Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource TextSecondaryBrush}" />
                        </Trigger>
                        <Trigger Property="Validation.HasError" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource DangerSoftBrush}" />
                        </Trigger>
                        <Trigger Property="themes:TextBoxChrome.HasWarning" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource WarningBrush}" />
                        </Trigger>
                        <Trigger Property="themes:TextBoxChrome.HasError" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            <Setter TargetName="Glow" Property="Opacity" Value="0.2" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="themes:TextBoxChrome.HasWarning" Value="True" />
                                <Condition Property="IsKeyboardFocusWithin" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource WarningBrush}" />
                            <Setter TargetName="Glow" Property="BorderBrush" Value="{DynamicResource WarningBrush}" />
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="themes:TextBoxChrome.HasError" Value="True" />
                                <Condition Property="IsKeyboardFocusWithin" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
                            <Setter TargetName="Glow" Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
                        </MultiTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource SurfaceSubtleBrush}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="TextBox" BasedOn="{StaticResource AppTextBox}" />

    <Style x:Key="ErrorTextBox" TargetType="TextBox" BasedOn="{StaticResource AppTextBox}">
        <Setter Property="themes:TextBoxChrome.HasError" Value="True" />
    </Style>

    <!--
        Shared text styles (docs/styleguide.md, Type). Every window uses these rather than a copy of its own. Each carries the
        gap below it that the guide gives it; a view sets Margin only where the layout needs something else.
    -->

    <!-- A dialog's title heading: 20 SemiBold, 16 above the content, level 1 -->
    <Style x:Key="Heading" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSizeHeading}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,0,0,16" />
        <Setter Property="AutomationProperties.HeadingLevel" Value="Level1" />
    </Style>

    <!-- A level 2 heading: the welcome panel, empty and error states, a sheet's title -->
    <Style x:Key="Subheading" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSizeSubheading}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,0,0,4" />
        <Setter Property="AutomationProperties.HeadingLevel" Value="Level2" />
    </Style>

    <!-- A field's label, 8 above its control; the control's automation name starts with this text -->
    <Style x:Key="FieldLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

    <!-- An error under a field, 4 below it (a view sets 16 above when it closes a form) -->
    <Style x:Key="ErrorText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,4,0,0" />
        <Setter Property="AutomationProperties.LiveSetting" Value="Assertive" />
    </Style>

    <!-- Notes beside a label, status lines, the count: 12 secondary, no spacing of its own -->
    <Style x:Key="Caption" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- Section label (Controls/SectionLabel): 12 ExtraBold accent capitals, 8 above its first row, a level 2 heading -->
    <Style TargetType="controls:SectionLabel">
        <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
        <Setter Property="FontWeight" Value="ExtraBold" />
        <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
        <Setter Property="Margin" Value="0,0,0,8" />
        <Setter Property="AutomationProperties.HeadingLevel" Value="Level2" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:SectionLabel">
                    <TextBlock Text="{TemplateBinding DisplayText}" TextWrapping="Wrap" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Helper text (Controls/HelperText): 12 secondary, 4 below its control. A warning or a success adds a 12px icon, 4 from
         the text; it never uses TextTertiaryBrush, which is for hints only. -->
    <Style TargetType="controls:HelperText">
        <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="Margin" Value="0,4,0,0" />
        <Setter Property="AutomationProperties.LiveSetting" Value="Polite" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:HelperText">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <!-- The icon is lowered 2 to sit on the first line's text: an optical offset -->
                        <controls:Icon x:Name="StateIcon" Kind="Warning" Size="12" Margin="0,2,4,0" VerticalAlignment="Top"
                                       Visibility="Collapsed" />
                        <TextBlock Grid.Column="1" Text="{TemplateBinding Text}" TextWrapping="Wrap" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="State" Value="Warning">
                            <Setter TargetName="StateIcon" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="State" Value="Success">
                            <Setter TargetName="StateIcon" Property="Kind" Value="Check" />
                            <Setter TargetName="StateIcon" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="State" Value="Warning">
                <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                <Setter Property="AutomationProperties.LiveSetting" Value="Assertive" />
            </Trigger>
            <Trigger Property="State" Value="Error">
                <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                <Setter Property="AutomationProperties.LiveSetting" Value="Assertive" />
            </Trigger>
            <Trigger Property="State" Value="Success">
                <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- WPF's default Label style sets the system control-text color, so it doesn't inherit the window's Foreground. -->
    <Style TargetType="Label">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    </Style>

    <!-- CheckBox: 18px box, accent fill with a check mark when checked. The text keeps the size it inherits. -->
    <Style TargetType="CheckBox">
        <Setter Property="FocusVisualStyle" Value="{StaticResource AppFocusVisual}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="8,0,0,0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="Box" Width="18" Height="18" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource RadiusSm}"
                                SnapsToDevicePixels="True">
                            <controls:Icon x:Name="Mark" Kind="Check" Size="14" Visibility="Collapsed"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{DynamicResource OnAccentBrush}" />
                        </Border>
                        <ContentPresenter Grid.Column="1" Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource TextSecondaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource AccentBrush}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            <Setter TargetName="Mark" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="True" />
                                <Condition Property="IsMouseOver" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource AccentHoverBrush}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}" />
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="True" />
                                <Condition Property="IsPressed" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource AccentPressedBrush}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentPressedBrush}" />
                        </MultiTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource SurfaceSubtleBrush}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                            <Setter TargetName="Mark" Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- RadioButton: the round partner of CheckBox, with an accent fill and a dot when selected. -->
    <Style TargetType="RadioButton">
        <Setter Property="FocusVisualStyle" Value="{StaticResource AppFocusVisual}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="8,0,0,0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="Box" Width="18" Height="18" CornerRadius="9"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" SnapsToDevicePixels="True">
                            <Ellipse x:Name="Mark" Width="8" Height="8" Visibility="Collapsed"
                                     HorizontalAlignment="Center" VerticalAlignment="Center"
                                     Fill="{DynamicResource OnAccentBrush}" />
                        </Border>
                        <ContentPresenter Grid.Column="1" Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource TextSecondaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource AccentBrush}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            <Setter TargetName="Mark" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="True" />
                                <Condition Property="IsMouseOver" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource AccentHoverBrush}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}" />
                        </MultiTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource SurfaceSubtleBrush}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                            <Setter TargetName="Mark" Property="Fill" Value="{DynamicResource TextTertiaryBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ToolTip -->
    <Style TargetType="ToolTip">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource RadiusSm}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ContextMenu / MenuItem: flat menus (no submenus). -->
    <Style TargetType="ContextMenu">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="MinWidth" Value="166" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource RadiusMd}"
                            Padding="{TemplateBinding Padding}">
                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="AppMenuItem" TargetType="MenuItem">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="{StaticResource RadiusSm}"
                            MinHeight="{TemplateBinding MinHeight}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ContentPresenter x:Name="Icon" ContentSource="Icon" Width="16" Height="16"
                                              HorizontalAlignment="Left" VerticalAlignment="Center" />
                            <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True"
                                              VerticalAlignment="Center" Margin="4,0,12,0" />
                            <TextBlock Grid.Column="2" Text="{TemplateBinding InputGestureText}" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextTertiaryBrush}" FontSize="{StaticResource FontSizeCaption}" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
                            <Setter TargetName="Icon" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="MenuItem" BasedOn="{StaticResource AppMenuItem}" />

    <Style x:Key="DangerMenuItem" TargetType="MenuItem" BasedOn="{StaticResource AppMenuItem}">
        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
    </Style>

    <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator">
        <Setter Property="Margin" Value="4" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Height="1" Background="{DynamicResource BorderBrush}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Slim scroll bars -->
    <Style x:Key="ScrollTrackButton" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ScrollThumb" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="Bar" Margin="2" CornerRadius="3" Background="{DynamicResource BorderStrongBrush}" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bar" Property="Background" Value="{DynamicResource TextTertiaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Bar" Property="Background" Value="{DynamicResource TextSecondaryBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Width" Value="12" />
        <Setter Property="MinWidth" Value="12" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource ScrollTrackButton}" />
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource ScrollThumb}" />
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource ScrollTrackButton}" />
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Height" Value="12" />
                <Setter Property="MinHeight" Value="12" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                                <Track x:Name="PART_Track">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageLeftCommand" Style="{StaticResource ScrollTrackButton}" />
                                    </Track.DecreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource ScrollThumb}" />
                                    </Track.Thumb>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageRightCommand" Style="{StaticResource ScrollTrackButton}" />
                                    </Track.IncreaseRepeatButton>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--
        ToggleSwitch: a 36x20 track with a 14px thumb for ToggleButton. Off is a plain outlined track; on fills with the accent.
        The track sits in a transparent area 24 high, so the switch is a 24px pointer target by its own size (WCAG 2.5.8),
        wherever it is placed. ToggleButton's automation peer already exposes the Toggle pattern; set AutomationProperties.Name
        where it is used.
    -->
    <!-- The focus ring follows the track, not the hit area: 2px outside it, at its radius plus 2 (a ring, an exception to the grid) -->
    <Style x:Key="ToggleFocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="-4,-2" StrokeThickness="2" RadiusX="12" RadiusY="12" SnapsToDevicePixels="True"
                               Stroke="{DynamicResource AccentBrush}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ToggleSwitch" TargetType="ToggleButton">
        <!-- Space toggles; Enter passes through to the dialog's default button, as with CheckBox (a bare ToggleButton takes Enter) -->
        <Setter Property="KeyboardNavigation.AcceptsReturn" Value="False" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource ToggleFocusVisual}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <!-- The hit area: transparent, not null, so a click above or below the track still toggles -->
                    <Border x:Name="HitArea" Background="Transparent">
                        <!-- Fully round: the radius is half the track's height -->
                        <Border x:Name="Track" Height="20" VerticalAlignment="Center" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10" SnapsToDevicePixels="True">
                            <!-- The thumb sits 2 inside the track: an optical offset -->
                            <Ellipse x:Name="Thumb" Width="14" Height="14" HorizontalAlignment="Left" Margin="2,0,0,0"
                                     Fill="{DynamicResource TextSecondaryBrush}" />
                        </Border>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource TextSecondaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentBrush}" />
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            <Setter TargetName="Thumb" Property="Fill" Value="{DynamicResource OnAccentBrush}" />
                            <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                            <Setter TargetName="Thumb" Property="Margin" Value="0,0,2,0" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="True" />
                                <Condition Property="IsMouseOver" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentHoverBrush}" />
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}" />
                        </MultiTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource SurfaceSubtleBrush}" />
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                            <Setter TargetName="Thumb" Property="Fill" Value="{DynamicResource TextTertiaryBrush}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Inline spinner; takes its color from Foreground (for example OnAccentBrush inside a primary button). -->
    <Style x:Key="Spinner" TargetType="Control">
        <Setter Property="Width" Value="14" />
        <Setter Property="Height" Value="14" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Control">
                    <Grid RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <RotateTransform x:Name="Rotation" />
                        </Grid.RenderTransform>
                        <Ellipse Stroke="{TemplateBinding Foreground}" StrokeThickness="2" Opacity="0.3" />
                        <Ellipse Stroke="{TemplateBinding Foreground}" StrokeThickness="2" StrokeDashArray="3.2 6" StrokeDashOffset="0" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsVisible" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="Spin">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Rotation" Storyboard.TargetProperty="Angle"
                                                         From="0" To="360" Duration="0:0:0.7" RepeatBehavior="Forever" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <StopStoryboard BeginStoryboardName="Spin" />
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Type badge: 22px tall, icon + label. Colors per kind come from the Badge*Brush palette entries. -->
    <Style TargetType="controls:TypeBadge">
        <Setter Property="Height" Value="22" />
        <Setter Property="Padding" Value="4,0,8,0" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource BadgeCommandForegroundBrush}" />
        <Setter Property="Background" Value="{DynamicResource BadgeCommandBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BadgeCommandBorderBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:TypeBadge">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource RadiusSm}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <controls:Icon Kind="{TemplateBinding IconKind}" Size="12" VerticalAlignment="Center" />
                            <TextBlock Text="{TemplateBinding Label}" Margin="4,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Kind" Value="Url">
                <Setter Property="Foreground" Value="{DynamicResource BadgeUrlForegroundBrush}" />
                <Setter Property="Background" Value="{DynamicResource BadgeUrlBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource BadgeUrlBorderBrush}" />
            </Trigger>
            <Trigger Property="Kind" Value="File">
                <Setter Property="Foreground" Value="{DynamicResource BadgeFileForegroundBrush}" />
                <Setter Property="Background" Value="{DynamicResource BadgeFileBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource BadgeFileBorderBrush}" />
            </Trigger>
            <Trigger Property="Kind" Value="Folder">
                <Setter Property="Foreground" Value="{DynamicResource BadgeFolderForegroundBrush}" />
                <Setter Property="Background" Value="{DynamicResource BadgeFolderBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource BadgeFolderBorderBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--
        Layout pieces (docs/styleguide.md, Layout and Control sizes).
    -->

    <!-- The inline icon tile: 40, RadiusLg, accent on AccentSoftBrush; the glyph inside is 24 -->
    <Style x:Key="IconTile" TargetType="Border">
        <Setter Property="Width" Value="{StaticResource TileSize}" />
        <Setter Property="Height" Value="{StaticResource TileSize}" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusLg}" />
        <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource AccentBrush}" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- A panel set into a page (Confirm's targets box): RadiusLg, 16 inside and 16 below. The welcome panel is the one
         exception: AccentSoftBrush with no border. -->
    <Style x:Key="InsetPanel" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SurfaceSubtleBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusLg}" />
        <Setter Property="Padding" Value="{StaticResource PanelPadding}" />
        <Setter Property="Margin" Value="0,0,0,16" />
    </Style>

    <!-- The footer every dialog ends in: buttons right-aligned, 8 apart, the primary one last; cancel comes before it, and a
         secondary action that isn't cancel sits at the left edge -->
    <Style x:Key="DialogFooter" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SurfaceSubtleBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
        <Setter Property="Padding" Value="{StaticResource DialogFooterPadding}" />
    </Style>

    <!--
        Overlay sheets (the icon picker, and any picker after it): an OverlayScrim over the page and an OverlaySheet on it, in
        one Grid cell that spans the window. The page behind is disabled meanwhile, so Tab stays in the sheet; Escape, the
        close button and a click on the scrim close it.
    -->
    <Style x:Key="OverlayScrim" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource ScrimBrush}" />
    </Style>

    <!-- 40 from the top of the window and 16 from the bottom, centered, at most the window's width less 2 x 16. The shadow sits
         on a border behind the sheet, not on it, so the sheet's text keeps ClearType. Give the content a ScrollViewer when it
         can be taller than the window. -->
    <Style x:Key="OverlaySheet" TargetType="ContentControl">
        <Setter Property="Margin" Value="16,40,16,16" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="KeyboardNavigation.TabNavigation" Value="Cycle" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Grid>
                        <Border x:Name="Shadow" CornerRadius="{StaticResource RadiusLg}" Background="{DynamicResource SurfaceRaisedBrush}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="28" ShadowDepth="8" Opacity="{DynamicResource ShadowOpacity}" Color="{DynamicResource ShadowColor}" />
                            </Border.Effect>
                        </Border>
                        <Border x:Name="Sheet" CornerRadius="{StaticResource RadiusLg}" Background="{DynamicResource SurfaceRaisedBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" SnapsToDevicePixels="True">
                            <ContentPresenter />
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A sheet's header: the title (Subheading), an optional Caption note 4 under it, and an IconButton with a 16 Close glyph
         at the top right, whose automation name starts with "Close" -->
    <Style x:Key="OverlaySheetHeader" TargetType="Grid">
        <Setter Property="Margin" Value="16,16,16,8" />
    </Style>

    <!-- The check badge of a selected card: an 18 round accent badge with a 12 check, 8 in from the card's top right corner -->
    <Style x:Key="CheckBadge" TargetType="ContentControl">
        <Setter Property="Width" Value="18" />
        <Setter Property="Height" Value="18" />
        <Setter Property="Margin" Value="0,8,8,0" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <!-- Fully round: the radius is half its size -->
                    <Border CornerRadius="9" Background="{DynamicResource AccentBrush}" SnapsToDevicePixels="True">
                        <controls:Icon Kind="Check" Size="12" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{DynamicResource OnAccentBrush}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Cards in a sheet or panel: SurfaceBrush, a 1px border, RadiusMd, 12 inside, 4 at the sides and 8 below (so cards in a
        row are 8 apart), SurfaceHoverBrush on hover. The selected card gets a 2px accent border with 1 less padding, so nothing
        moves, and the check badge; the background doesn't change, and the badge means selection never relies on color alone.
        CardItem is for a ListBox (the icon picker), CardRadio for radio buttons (the welcome bubbles); give either content of
        its own.
    -->
    <Style x:Key="CardItem" TargetType="ListBoxItem">
        <Setter Property="Margin" Value="4,0,4,8" />
        <Setter Property="Padding" Value="12" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource AppFocusVisual}" />
        <Setter Property="Cursor" Value="Hand" />
        <!-- A ListBox's own Foreground is the system text color, not the palette's -->
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid>
                        <Border x:Name="Card" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}"
                                CornerRadius="{StaticResource RadiusMd}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ContentControl x:Name="Check" Style="{StaticResource CheckBadge}" Visibility="Collapsed" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Card" Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            <Setter TargetName="Card" Property="BorderThickness" Value="2" />
                            <!-- The selection border's extra 1 comes off the padding: an exception to the grid -->
                            <Setter TargetName="Card" Property="Padding" Value="11" />
                            <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CardRadio" TargetType="RadioButton">
        <Setter Property="Margin" Value="4,0,4,8" />
        <Setter Property="Padding" Value="12" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource AppFocusVisual}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid>
                        <Border x:Name="Card" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}"
                                CornerRadius="{StaticResource RadiusMd}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True" />
                        </Border>
                        <ContentControl x:Name="Check" Style="{StaticResource CheckBadge}" Visibility="Collapsed" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Card" Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            <Setter TargetName="Card" Property="BorderThickness" Value="2" />
                            <!-- The selection border's extra 1 comes off the padding: an exception to the grid -->
                            <Setter TargetName="Card" Property="Padding" Value="11" />
                            <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The tab bar that replaces the title bar (issue 218; docs/styleguide.md, Tabbed window) -->

    <!-- Keyboard focus on a tab: inside it, since the tab stands on the bar's bottom edge and a ring around it would be cut -->
    <Style x:Key="TabFocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="4,4,16,4" StrokeThickness="2" RadiusX="{StaticResource RadiusSmValue}" RadiusY="{StaticResource RadiusSmValue}" SnapsToDevicePixels="True"
                               Stroke="{DynamicResource AccentBrush}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A folder tab: TabHeight high, a cut corner at the left, a slanted right side, standing on the bar's bottom edge. The selected tab
         is the page color and runs into the page; only its shadow falls to the right. Inactive tabs are shaded and textured. -->
    <Style x:Key="RailTabItem" TargetType="TabItem">
        <Setter Property="FocusVisualStyle" Value="{StaticResource TabFocusVisual}" />
        <Setter Property="Height" Value="{StaticResource TabHeight}" />
        <Setter Property="VerticalAlignment" Value="Bottom" />
        <Setter Property="Margin" Value="0,0,4,0" />
        <Setter Property="Padding" Value="12,0,24,0" />
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TabTextBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Grid x:Name="Root" Background="Transparent" SnapsToDevicePixels="True">
                        <!-- The selected tab's shadow, to the right only (Direction 0). It is a shape of its own under the tab, with the effect
                             written here, because an effect set from a trigger is one object shared by every tab and can't be frozen
                             with a palette color in it. Its opacity is ShadowOpacity, since a color's alpha is ignored; high contrast sets it to 0. -->
                        <controls:FolderTabShape x:Name="Shadow" Cut="{StaticResource TabCut}" Slant="{StaticResource TabSlant}"
                                                 Fill="{DynamicResource SurfaceBrush}" StrokeThickness="0" Visibility="Collapsed"
                                                 IsHitTestVisible="False">
                            <controls:FolderTabShape.Effect>
                                <DropShadowEffect Direction="0" ShadowDepth="3" BlurRadius="4" Opacity="{DynamicResource ShadowOpacity}" Color="{DynamicResource ShadowColor}" />
                            </controls:FolderTabShape.Effect>
                        </controls:FolderTabShape>
                        <controls:FolderTabShape x:Name="Body" Cut="{StaticResource TabCut}" Slant="{StaticResource TabSlant}"
                                                 Fill="{DynamicResource TabBrush}" Stroke="{DynamicResource TabBorderBrush}"
                                                 StrokeThickness="1" />
                        <controls:FolderTabShape x:Name="Texture" Cut="{StaticResource TabCut}" Slant="{StaticResource TabSlant}"
                                                 Fill="{DynamicResource TabTextureBrush}" StrokeThickness="1" IsHitTestVisible="False" />
                        <!-- High contrast only: an inactive tab closes its outline at the base, so the selected one, whose outline
                             runs into the page, is the one to tell apart. Transparent in the other palettes. -->
                        <Rectangle x:Name="Base" Height="1" VerticalAlignment="Bottom" Fill="{DynamicResource TabBaseBrush}"
                                   IsHitTestVisible="False" />
                        <ContentPresenter ContentSource="Header" Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Left" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Panel.ZIndex" Value="5" />
                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                            <Setter Property="Cursor" Value="Arrow" />
                            <Setter TargetName="Body" Property="Fill" Value="{DynamicResource SurfaceBrush}" />
                            <Setter TargetName="Body" Property="Stroke" Value="{DynamicResource TabSelectedBorderBrush}" />
                            <Setter TargetName="Texture" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Base" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Shadow" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Only the row of tabs: the screen under it is chosen by the shell, not hosted here. One Tab stop; the arrow keys move between tabs. -->
    <Style x:Key="RailTabControl" TargetType="controls:RailTabControl">
        <Setter Property="ItemContainerStyle" Value="{StaticResource RailTabItem}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="VerticalAlignment" Value="Bottom" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="KeyboardNavigation.TabNavigation" Value="Once" />
        <Setter Property="KeyboardNavigation.DirectionalNavigation" Value="Cycle" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:RailTabControl">
                    <StackPanel IsItemsHost="True" Orientation="Horizontal" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Minimize, maximize or restore, and close: CaptionButtonWidth by RailHeight, a 10px glyph in the text color. They are not Tab stops,
         as the standard ones aren't (the window menu, Alt+Space, has the same commands). Maximize also answers to the window's
         non-client mouse messages (CaptionButtonState), which is how Windows 11 shows its snap layouts over it. -->
    <Style x:Key="CaptionButton" TargetType="Button">
        <Setter Property="Width" Value="{StaticResource CaptionButtonWidth}" />
        <Setter Property="Height" Value="{StaticResource RailHeight}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Face" Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource CaptionHoverBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource CaptionHoverGlyphBrush}" />
            </Trigger>
            <Trigger Property="controls:CaptionButtonState.IsHot" Value="True">
                <Setter Property="Background" Value="{DynamicResource CaptionHoverBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource CaptionHoverGlyphBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource CaptionPressedBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource CaptionHoverGlyphBrush}" />
            </Trigger>
            <Trigger Property="controls:CaptionButtonState.IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource CaptionPressedBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource CaptionHoverGlyphBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="CaptionCloseButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource CaptionCloseBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource CaptionCloseGlyphBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource CaptionCloseBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource CaptionCloseGlyphBrush}" />
                <Setter Property="Opacity" Value="0.8" />
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
