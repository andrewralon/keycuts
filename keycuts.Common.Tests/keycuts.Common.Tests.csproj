<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Common's tests without the GUI, so they can follow Common to net10.0 and run on macOS (docs/macos-port.md,
         Phase 2). The namespace stays keycuts.Tests, so test names and filters didn't change in the split. -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>keycuts.Tests</RootNamespace>
    <AssemblyName>keycuts.Common.Tests</AssemblyName>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- xUnit v3 test projects are executables; VSTest still runs them through xunit.runner.visualstudio. -->
    <OutputType>Exe</OutputType>
    <!-- xUnit1051 (pass TestContext.Current.CancellationToken) arrived with v3. The tests finish in milliseconds and
         use their own tokens, so turning it on would touch some 200 calls for no gain. -->
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="GitHubActionsTestLogger" PrivateAssets="all" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3.mtp-off" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\keycuts.Common\keycuts.Common.csproj" />
  </ItemGroup>
</Project>
