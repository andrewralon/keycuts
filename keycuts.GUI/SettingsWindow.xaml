<Window x:Name="SettingsWindowName" x:Class="keycuts.GUI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:common="clr-namespace:keycuts.Common;assembly=keycuts.Common"
        xmlns:controls="clr-namespace:keycuts.GUI.Controls"
        xmlns:themes="clr-namespace:keycuts.GUI.Themes"
        xmlns:vm="clr-namespace:keycuts.GUI.ViewModels"
        mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}"
        Title="Settings" Width="440" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" UseLayoutRounding="True"
        Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextBrush}"
        FontFamily="{StaticResource AppFontFamily}" FontSize="{StaticResource FontSizeBody}"
        Loaded="Settings_Loaded" Closed="Settings_Closed">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource FontSizeEyebrow}" />
            <Setter Property="FontWeight" Value="ExtraBold" />
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>

        <Style x:Key="SettingLabel" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,2" />
        </Style>

        <Style x:Key="SettingNote" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="FieldMessage" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,6,0,0" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasOutputFolderError}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- The folder box shows the error state while the view model has a message for it -->
        <Style x:Key="OutputFolderBox" TargetType="TextBox" BasedOn="{StaticResource AppTextBox}">
            <!-- The box is narrow, so a long path can be read in full from the tooltip -->
            <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="ToolTipService.IsEnabled" Value="False" />
                </Trigger>
                <DataTrigger Binding="{Binding HasOutputFolderError}" Value="True">
                    <Setter Property="themes:TextBoxChrome.HasError" Value="True" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SettingRow" TargetType="Grid">
            <Setter Property="Margin" Value="0,0,0,16" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="24">
            <!-- Header -->
            <StackPanel Margin="0,0,0,22">
                <TextBlock Text="Settings" FontSize="{StaticResource FontSizeHeadingLarge}" FontWeight="SemiBold"
                           AutomationProperties.HeadingLevel="Level1" />
                <TextBlock Text="Choose how keycuts creates your shortcuts." Margin="0,4,0,0"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
            </StackPanel>

            <!-- Output -->
            <StackPanel Margin="0,0,0,22">
                <TextBlock Text="OUTPUT" Style="{StaticResource SectionLabel}" />
                <TextBlock Text="Output folder" Style="{StaticResource FieldLabel}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="TextboxOutputFolder" Grid.Column="0" Style="{StaticResource OutputFolderBox}"
                             Text="{Binding OutputFolder, UpdateSourceTrigger=PropertyChanged}"
                             themes:TextBoxChrome.Placeholder="Choose where shortcuts are saved"
                             AutomationProperties.Name="Output folder"
                             AutomationProperties.HelpText="{Binding OutputFolderMessage}" />
                    <Button x:Name="BtnChoose" Grid.Column="1" Margin="8,0,0,0" Command="{Binding ChooseCommand}"
                            AutomationProperties.Name="Choose">
                        <StackPanel Orientation="Horizontal">
                            <controls:Icon Kind="Folder" Size="17" VerticalAlignment="Center" />
                            <TextBlock Text="Choose" Margin="7,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnLaunch" Grid.Column="2" Margin="8,0,0,0" Command="{Binding LaunchCommand}"
                            AutomationProperties.Name="Launch">
                        <StackPanel Orientation="Horizontal">
                            <controls:Icon Kind="External" Size="16" VerticalAlignment="Center" />
                            <TextBlock Text="Launch" Margin="7,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>
                <TextBlock x:Name="OutputFolderMessage" Style="{StaticResource FieldMessage}" Text="{Binding OutputFolderMessage}"
                           AutomationProperties.LiveSetting="Polite" />
            </StackPanel>

            <!-- Behavior -->
            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,18,0,0" Margin="0,0,0,6">
                <StackPanel>
                    <TextBlock Text="BEHAVIOR" Style="{StaticResource SectionLabel}" />

                    <Grid Style="{StaticResource SettingRow}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Force overwrite" Style="{StaticResource SettingLabel}" />
                            <TextBlock Text="Replace shortcuts with matching names without asking." Style="{StaticResource SettingNote}" />
                        </StackPanel>
                        <ToggleButton x:Name="ToggleForceOverwrite" Grid.Column="1" Style="{StaticResource ToggleSwitch}" Margin="20,0,0,0"
                                      IsChecked="{Binding ForceOverwrite}" AutomationProperties.Name="Force overwrite"
                                      AutomationProperties.HelpText="Replace shortcuts with matching names without asking." />
                    </Grid>

                    <Grid Style="{StaticResource SettingRow}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Right-click context menus" Style="{StaticResource SettingLabel}" />
                            <TextBlock Text="Add “keycut this!” to File Explorer menus." Style="{StaticResource SettingNote}" />
                        </StackPanel>
                        <ToggleButton x:Name="ToggleRightClick" Grid.Column="1" Style="{StaticResource ToggleSwitch}" Margin="20,0,0,0"
                                      IsChecked="{Binding RightClickContextMenus}" AutomationProperties.Name="Right-click context menus"
                                      AutomationProperties.HelpText="Add “keycut this!” to File Explorer menus." />
                    </Grid>

                    <!-- #31: save new file and folder keycuts as %USERPROFILE%\... and the like; Shift flips it while creating -->
                    <Grid Style="{StaticResource SettingRow}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Use environment variables in paths" Style="{StaticResource SettingLabel}" />
                            <TextBlock Text="Save paths as %USERPROFILE%\… so keycuts work on other accounts. Hold Shift to flip it."
                                       Style="{StaticResource SettingNote}" />
                        </StackPanel>
                        <ToggleButton x:Name="ToggleEnvironmentVariables" Grid.Column="1" Style="{StaticResource ToggleSwitch}" Margin="20,0,0,0"
                                      IsChecked="{Binding UseEnvironmentVariables}" AutomationProperties.Name="Use environment variables in paths"
                                      AutomationProperties.HelpText="Saves C:\Users\you\Desktop as %USERPROFILE%\Desktop, so keycuts work on other accounts. Hold Shift while creating to flip it for one keycut." />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Appearance -->
            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,18,0,0">
                <StackPanel>
                    <TextBlock Text="APPEARANCE" Style="{StaticResource SectionLabel}" />
                    <TextBlock Text="Theme" Style="{StaticResource SettingLabel}" />
                    <StackPanel x:Name="ThemeChoices" Orientation="Horizontal" Margin="0,6,0,0">
                        <RadioButton Content="System" GroupName="Theme" Tag="{x:Static common:ThemePreference.System}"
                                     AutomationProperties.Name="System theme" Checked="Theme_Checked" Margin="0,0,16,0" />
                        <RadioButton Content="Light" GroupName="Theme" Tag="{x:Static common:ThemePreference.Light}"
                                     AutomationProperties.Name="Light theme" Checked="Theme_Checked" Margin="0,0,16,0" />
                        <RadioButton Content="Dark" GroupName="Theme" Tag="{x:Static common:ThemePreference.Dark}"
                                     AutomationProperties.Name="Dark theme" Checked="Theme_Checked" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Shown when a save partly failed (for example PATH could not be updated); the window stays open -->
            <TextBlock x:Name="SaveErrorMessage" Text="{Binding SaveError}" Margin="0,14,0,0" TextWrapping="Wrap"
                       Foreground="{DynamicResource DangerBrush}" AutomationProperties.LiveSetting="Assertive"
                       Visibility="{Binding HasSaveError, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>

        <!-- Footer -->
        <Border Grid.Row="1" Background="{DynamicResource SurfaceSubtleBrush}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0" Padding="24,13">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <!-- Closes Settings and shows the first-run welcome panel in the creator again -->
                <Button x:Name="BtnShowWelcome" Grid.Column="0" Content="Show welcome" Style="{StaticResource SecondaryButton}"
                        Click="ShowWelcome_Click" AutomationProperties.Name="Show the welcome panel" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="BtnCancel" Content="Cancel" Style="{StaticResource SecondaryButton}" IsCancel="True" />
                    <Button x:Name="BtnSave" Style="{StaticResource PrimaryButton}" IsDefault="True" Margin="8,0,0,0"
                            Click="Save_Click" AutomationProperties.Name="Save changes">
                        <StackPanel Orientation="Horizontal">
                            <controls:Icon Kind="Check" Size="16" VerticalAlignment="Center" />
                            <TextBlock Text="Save changes" Margin="7,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
