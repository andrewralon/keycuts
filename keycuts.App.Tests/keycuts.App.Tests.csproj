<Project Sdk="Microsoft.NET.Sdk">
  <!-- The Avalonia app's tests (docs/macos-port.md Phase 3), headless, so they run on Windows, macOS and Linux. At cutover
       (Phase 3.12) they take keycuts.Tests' place. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- Annotations without the warnings, as in keycuts.Tests (nullable off): the view model tests are its files, linked -->
    <Nullable>annotations</Nullable>
    <RootNamespace>keycuts.Tests</RootNamespace>
    <AssemblyName>keycuts.App.Tests</AssemblyName>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- xUnit v3 test projects are executables; VSTest still runs them through xunit.runner.visualstudio. -->
    <OutputType>Exe</OutputType>
    <!-- As in keycuts.Tests: the tests use their own tokens -->
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
    <!-- The files shared with keycuts.Tests tell the two apps' types apart with it (Rect) -->
    <DefineConstants>$(DefineConstants);AVALONIA</DefineConstants>
    <!-- Reading a rendered frame's pixels -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia.Headless.XUnit" />
    <PackageReference Include="GitHubActionsTestLogger" PrivateAssets="all" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3.mtp-off" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\keycuts.App\keycuts.App.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\keycuts.Common.Tests\PlatformFacts.cs" Link="Shared\PlatformFacts.cs" />
    <Compile Include="..\keycuts.Common.Tests\RepoFiles.cs" Link="Shared\RepoFiles.cs" />
    <Compile Include="..\keycuts.Common.Tests\TestNameChecks.cs" Link="Shared\TestNameChecks.cs" />
    <Compile Include="..\keycuts.Common.Tests\UpdateFakes.cs" Link="Shared\UpdateFakes.cs" />
    <Compile Include="..\keycuts.Tests\GifWriter.cs" Link="Shared\GifWriter.cs" />
  </ItemGroup>
  <!-- The view model tests, run against the view models both apps share (docs/macos-port.md, correction 15): the same files
       keycuts.Tests runs against the WPF build. -->
  <ItemGroup>
    <Compile Include="..\keycuts.Tests\CommandNameTests.cs" Link="Shared\ViewModels\CommandNameTests.cs" />
    <Compile Include="..\keycuts.Tests\CreatorSubmitTests.cs" Link="Shared\ViewModels\CreatorSubmitTests.cs" />
    <Compile Include="..\keycuts.Tests\CreatorViewModelTests.cs" Link="Shared\ViewModels\CreatorViewModelTests.cs" />
    <Compile Include="..\keycuts.Tests\EditKeycutViewModelTests.cs" Link="Shared\ViewModels\EditKeycutViewModelTests.cs" />
    <Compile Include="..\keycuts.Tests\KeycutMigrationTests.cs" Link="Shared\ViewModels\KeycutMigrationTests.cs" />
    <Compile Include="..\keycuts.Tests\ManagerRowActionsTests.cs" Link="Shared\ViewModels\ManagerRowActionsTests.cs" />
    <Compile Include="..\keycuts.Tests\ManagerSearchSortTests.cs" Link="Shared\ViewModels\ManagerSearchSortTests.cs" />
    <Compile Include="..\keycuts.Tests\ManagerViewModelTests.cs" Link="Shared\ViewModels\ManagerViewModelTests.cs" />
    <Compile Include="..\keycuts.Tests\NameWarningMessageTests.cs" Link="Shared\ViewModels\NameWarningMessageTests.cs" />
    <Compile Include="..\keycuts.Tests\UpdateNoticeViewModelTests.cs" Link="Shared\ViewModels\UpdateNoticeViewModelTests.cs" />
    <Compile Include="..\keycuts.Tests\WelcomeViewModelTests.cs" Link="Shared\ViewModels\WelcomeViewModelTests.cs" />
    <Compile Include="..\keycuts.Tests\ShellViewModelTests.cs" Link="Shared\ViewModels\ShellViewModelTests.cs" />
    <Compile Include="..\keycuts.Tests\SettingsTests.cs" Link="Shared\ViewModels\SettingsTests.cs" />
    <Compile Include="..\keycuts.Tests\SettingsViewModelTests.cs" Link="Shared\ViewModels\SettingsViewModelTests.cs" />
    <Compile Include="..\keycuts.Tests\ShellIdListTests.cs" Link="Shared\ShellIdListTests.cs" />
  </ItemGroup>
</Project>
