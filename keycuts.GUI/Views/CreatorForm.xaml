<!-- The pieces a creator form is built from, shared by the Creator screen (CreatorView) and the Manager's create row
     (CreateRowView): the drop area's layers, the borderless target box, the name's status and helper line, and Browse's menu.
     The drop area's triggers find the view's element named DropArea. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:keycuts.GUI.Controls"
                    xmlns:themes="clr-namespace:keycuts.GUI.Themes">
  <!-- Borderless single-line field that sits inside the drop area; focus is shown on the drop area instead. -->
  <Style x:Key="InlineTextBox" TargetType="TextBox">
    <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
    <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}" />
    <Setter Property="SelectionBrush" Value="{DynamicResource AccentBrush}" />
    <Setter Property="SelectionTextBrush" Value="{DynamicResource OnAccentBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="MinHeight" Value="22" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="AllowDrop" Value="True" />
    <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Grid Background="Transparent">
            <ScrollViewer x:Name="PART_ContentHost" Padding="{TemplateBinding Padding}" Focusable="False"
                          VerticalAlignment="Center" HorizontalScrollBarVisibility="Hidden"
                          VerticalScrollBarVisibility="Hidden" />
            <!-- 2 in, where the text box draws its first character: an optical offset -->
            <TextBlock x:Name="Placeholder" Visibility="Collapsed" IsHitTestVisible="False" Margin="2,0,0,0"
                       Text="{TemplateBinding themes:TextBoxChrome.Placeholder}" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextSecondaryBrush}" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="Text" Value="">
              <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Placeholder" Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="Text" Value="">
        <Setter Property="ToolTipService.IsEnabled" Value="False" />
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- Drop area layers: the dashed outline, the fill, and the soft glow around it. -->
  <Style x:Key="DropStroke" TargetType="Rectangle">
    <Setter Property="RadiusX" Value="{StaticResource RadiusLgValue}" />
    <Setter Property="RadiusY" Value="{StaticResource RadiusLgValue}" />
    <Setter Property="StrokeThickness" Value="1" />
    <Setter Property="Stroke" Value="{DynamicResource BorderStrongBrush}" />
    <Setter Property="StrokeDashArray">
      <Setter.Value>
        <DoubleCollection>4 3</DoubleCollection>
      </Setter.Value>
    </Setter>
    <Setter Property="IsHitTestVisible" Value="False" />
    <Style.Triggers>
      <DataTrigger Binding="{Binding IsKeyboardFocusWithin, ElementName=DropArea}" Value="True">
        <Setter Property="Stroke" Value="{DynamicResource AccentBrush}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding ShowTargetError}" Value="True">
        <Setter Property="Stroke" Value="{DynamicResource DangerBrush}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding ShowDragHover}" Value="True">
        <Setter Property="Stroke" Value="{DynamicResource AccentBrush}" />
        <Setter Property="StrokeThickness" Value="2" />
        <Setter Property="StrokeDashArray" Value="{x:Null}" />
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="DropFill" TargetType="Border">
    <Setter Property="CornerRadius" Value="{StaticResource RadiusLg}" />
    <Setter Property="Background" Value="{DynamicResource SurfaceSubtleBrush}" />
    <Style.Triggers>
      <DataTrigger Binding="{Binding ShowTargetError}" Value="True">
        <Setter Property="Background" Value="{DynamicResource DangerSoftBrush}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding ShowDragHover}" Value="True">
        <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <!-- The glow is a ring outside the drop area: 3 out at RadiusLg + 3, and 4 out at RadiusLg + 4 while something is dragged over -->
  <Style x:Key="DropGlow" TargetType="Border">
    <Setter Property="Margin" Value="-3" />
    <Setter Property="BorderThickness" Value="3" />
    <Setter Property="CornerRadius" Value="15" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Opacity" Value="0" />
    <Setter Property="IsHitTestVisible" Value="False" />
    <Style.Triggers>
      <DataTrigger Binding="{Binding IsKeyboardFocusWithin, ElementName=DropArea}" Value="True">
        <Setter Property="Opacity" Value="0.2" />
      </DataTrigger>
      <MultiDataTrigger>
        <MultiDataTrigger.Conditions>
          <Condition Binding="{Binding IsKeyboardFocusWithin, ElementName=DropArea}" Value="True" />
          <Condition Binding="{Binding ShowTargetError}" Value="True" />
        </MultiDataTrigger.Conditions>
        <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
      </MultiDataTrigger>
      <DataTrigger Binding="{Binding ShowDragHover}" Value="True">
        <Setter Property="Margin" Value="-4" />
        <Setter Property="BorderThickness" Value="4" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        <Setter Property="Opacity" Value="0.2" />
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <!-- The name line's states (#153): an error outranks a warning. Saving and Created are NameStatus. -->
  <Style x:Key="NameHelper" TargetType="controls:HelperText" BasedOn="{StaticResource {x:Type controls:HelperText}}">
    <Style.Triggers>
      <DataTrigger Binding="{Binding HelperIsWarning}" Value="True">
        <Setter Property="State" Value="Warning" />
      </DataTrigger>
      <DataTrigger Binding="{Binding HelperIsError}" Value="True">
        <Setter Property="State" Value="Error" />
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <!-- Saving, then Created with its check: at the right of the Name label in the Manager's create row; the Creator puts it under the name box -->
  <Style x:Key="NameStatus" TargetType="controls:HelperText" BasedOn="{StaticResource {x:Type controls:HelperText}}">
    <Setter Property="Margin" Value="12,0,0,0" />
    <Setter Property="HorizontalAlignment" Value="Right" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Style.Triggers>
      <DataTrigger Binding="{Binding IsSuccess}" Value="True">
        <Setter Property="State" Value="Success" />
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="BrowseMenuItem" TargetType="MenuItem" BasedOn="{StaticResource AppMenuItem}">
    <Setter Property="MinHeight" Value="48" />
  </Style>

  <!-- The Manager's create row squeezes the drop area to one line, a text box's height: the same layers at a text box's radius, and
       the glow 3 out at RadiusSm + 3, 4 out at RadiusSm + 4 while something is dragged over -->
  <Style x:Key="RowDropStroke" TargetType="Rectangle" BasedOn="{StaticResource DropStroke}">
    <Setter Property="RadiusX" Value="{StaticResource RadiusSmValue}" />
    <Setter Property="RadiusY" Value="{StaticResource RadiusSmValue}" />
  </Style>

  <Style x:Key="RowDropFill" TargetType="Border" BasedOn="{StaticResource DropFill}">
    <Setter Property="CornerRadius" Value="{StaticResource RadiusSm}" />
  </Style>

  <Style x:Key="RowDropGlow" TargetType="Border" BasedOn="{StaticResource DropGlow}">
    <Setter Property="CornerRadius" Value="8" />
    <Style.Triggers>
      <DataTrigger Binding="{Binding ShowDragHover}" Value="True">
        <Setter Property="CornerRadius" Value="9" />
      </DataTrigger>
    </Style.Triggers>
  </Style>
</ResourceDictionary>
