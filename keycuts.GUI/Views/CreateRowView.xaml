<UserControl x:Class="keycuts.GUI.Views.CreateRowView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:keycuts.GUI.Controls"
             xmlns:themes="clr-namespace:keycuts.GUI.Themes"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:design="clr-namespace:keycuts.GUI.DesignData"
             mc:Ignorable="d" d:DataContext="{x:Static design:DesignViewModels.CreatorUrl}" d:DesignWidth="912"
             AllowDrop="{Binding IsInputEnabled}">
  <!-- The Manager's create row (docs/styleguide.md, The Manager's create row): the Creator's fields in one row, Target, Name and
       Description, then Create. An inset panel over a CreatorViewModel of its own that always shows its description and clears after
       a create. CreatorInput does what the Creator's form does: drop, paste, Browse, resolving the target, the name check. -->
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="CreatorForm.xaml" />
      </ResourceDictionary.MergedDictionaries>

      <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </ResourceDictionary>
  </UserControl.Resources>

  <Border Padding="{StaticResource PanelPadding}" CornerRadius="{StaticResource RadiusLg}" BorderThickness="1"
          Background="{DynamicResource SurfaceSubtleBrush}" BorderBrush="{DynamicResource BorderBrush}">
    <Grid>
      <!-- The fields share the row 2 : 1.25 : 1.25, 12 apart: a long target has the most room, and Name and Description are as wide as each other -->
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="2*" />
        <ColumnDefinition Width="1.25*" />
        <ColumnDefinition Width="1.25*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!-- Target: the Creator's drop area squeezed to one text box's height, the type icon at its left, then Browse -->
      <TextBlock Grid.Row="0" Grid.Column="0" Text="Target" Style="{StaticResource FieldLabel}" />
      <Grid Grid.Row="1" Grid.Column="0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid x:Name="DropArea" Height="{StaticResource InputHeight}">
          <Border Style="{StaticResource RowDropGlow}" />
          <Border Style="{StaticResource RowDropFill}" />
          <Rectangle Style="{StaticResource RowDropStroke}" />
          <Grid Margin="12,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <controls:Icon Kind="{Binding TargetIcon}" Size="16" VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}" />
            <!-- One line: a long target scrolls in the box, and its tooltip shows all of it. Not being edited, it shows the path as
                 it will be saved (#31), as the Creator's does. -->
            <TextBox x:Name="TextboxTarget" Grid.Column="1" Style="{StaticResource InlineTextBox}" Margin="8,0,0,0"
                     Text="{Binding TargetText, UpdateSourceTrigger=PropertyChanged}" TextWrapping="NoWrap"
                     themes:TextBoxChrome.Placeholder="Drop or paste a file, folder, or URL"
                     IsEnabled="{Binding IsInputEnabled}" AutomationProperties.Name="Target"
                     AutomationProperties.HelpText="{Binding TargetHelpText}" />
          </Grid>
        </Grid>
        <controls:MenuButton x:Name="BtnBrowse" Grid.Column="1" Style="{StaticResource SquareButton}" Margin="8,0,0,0"
                             IsEnabled="{Binding IsInputEnabled}" ToolTip="Browse" AutomationProperties.Name="Browse">
          <controls:Icon Kind="Folder" Size="20" VerticalAlignment="Center" />
          <Button.ContextMenu>
            <ContextMenu x:Name="BrowseMenu" Width="190">
              <MenuItem Style="{StaticResource BrowseMenuItem}" AutomationProperties.Name="File…" Command="{Binding BrowseFileCommand}">
                <MenuItem.Icon>
                  <controls:Icon Kind="File" Size="16" Foreground="{DynamicResource AccentBrush}" />
                </MenuItem.Icon>
                <MenuItem.Header>
                  <StackPanel>
                    <TextBlock Text="File…" FontWeight="SemiBold" FontSize="{StaticResource FontSizeBody}" />
                    <TextBlock Text="Choose a single file" FontSize="{StaticResource FontSizeCaption}"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                  </StackPanel>
                </MenuItem.Header>
              </MenuItem>
              <MenuItem Style="{StaticResource BrowseMenuItem}" AutomationProperties.Name="Folder…" Command="{Binding BrowseFolderCommand}">
                <MenuItem.Icon>
                  <controls:Icon Kind="Folder" Size="16" Foreground="{DynamicResource AccentBrush}" />
                </MenuItem.Icon>
                <MenuItem.Header>
                  <StackPanel>
                    <TextBlock Text="Folder…" FontWeight="SemiBold" FontSize="{StaticResource FontSizeBody}" />
                    <TextBlock Text="Choose a directory" FontSize="{StaticResource FontSizeCaption}"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                  </StackPanel>
                </MenuItem.Header>
              </MenuItem>
            </ContextMenu>
          </Button.ContextMenu>
        </controls:MenuButton>
      </Grid>

      <!-- Name, with "Saving…" and then "Created" at the right of its label, as on the Creator -->
      <Grid Grid.Row="0" Grid.Column="1" Margin="12,0,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="Name" Style="{StaticResource FieldLabel}" />
        <controls:HelperText x:Name="NameStatusTextBlock" Grid.Column="1" Style="{StaticResource NameStatus}" Margin="12,0,0,8"
                             Text="{Binding NameStatusText}"
                             Visibility="{Binding HasNameStatus, Converter={StaticResource BoolToVisibility}}" />
      </Grid>
      <TextBox x:Name="TextboxShortcut" Grid.Row="1" Grid.Column="1" Margin="12,0,0,0"
               Text="{Binding ShortcutName, UpdateSourceTrigger=PropertyChanged}"
               themes:TextBoxChrome.Placeholder="e.g. art"
               themes:TextBoxChrome.HasError="{Binding IsNameError}"
               themes:TextBoxChrome.HasWarning="{Binding IsNameWarning}"
               IsEnabled="{Binding IsInputEnabled}" AutomationProperties.Name="keycut name"
               AutomationProperties.HelpText="{Binding NameHelpText}">
        <TextBox.InputBindings>
          <!-- Shift+Enter too, with the environment-variables setting flipped -->
          <KeyBinding Key="Return" Command="{Binding CreateCommand}" />
          <KeyBinding Key="Return" Modifiers="Shift" Command="{Binding CreateCommand}" />
        </TextBox.InputBindings>
      </TextBox>

      <!-- Description: always shown here, so there is no Add a description link -->
      <TextBlock Grid.Row="0" Grid.Column="2" Margin="12,0,0,8" Text="Description" Style="{StaticResource FieldLabel}" />
      <TextBox x:Name="TextboxDescription" Grid.Row="1" Grid.Column="2" Margin="12,0,0,0"
               Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
               themes:TextBoxChrome.Placeholder="e.g. my paintings (optional)"
               IsEnabled="{Binding IsInputEnabled}" AutomationProperties.Name="Description">
        <TextBox.InputBindings>
          <KeyBinding Key="Return" Command="{Binding CreateCommand}" />
          <KeyBinding Key="Return" Modifiers="Shift" Command="{Binding CreateCommand}" />
        </TextBox.InputBindings>
      </TextBox>

      <!-- Create ends the row: the Creator's rocket, which gives way to the spinner while the keycut is written -->
      <Button x:Name="BtnCreateShortcut" Grid.Row="1" Grid.Column="3" Style="{StaticResource PrimarySquareButton}" Margin="8,0,0,0"
              Command="{Binding CreateCommand}" ToolTip="{Binding CreateButtonName}"
              AutomationProperties.Name="{Binding CreateButtonName}">
        <Grid>
          <controls:Icon Kind="Rocket" Size="20" HorizontalAlignment="Center" VerticalAlignment="Center">
            <controls:Icon.Style>
              <Style TargetType="controls:Icon">
                <Setter Property="Visibility" Value="Visible" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsSaving}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </controls:Icon.Style>
          </controls:Icon>
          <Control HorizontalAlignment="Center" VerticalAlignment="Center" Width="14" Height="14"
                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}">
            <Control.Style>
              <Style TargetType="Control" BasedOn="{StaticResource Spinner}">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsSaving}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Control.Style>
          </Control>
        </Grid>
      </Button>

      <!-- Name warnings and errors, and target errors, under the whole row; takes no room while there is nothing to say -->
      <controls:HelperText x:Name="HelperTextBlock" Grid.Row="2" Grid.ColumnSpan="4" Style="{StaticResource NameHelper}"
                           Text="{Binding HelperText}"
                           Visibility="{Binding ShowHelperLine, Converter={StaticResource BoolToVisibility}}" />
    </Grid>
  </Border>
</UserControl>
