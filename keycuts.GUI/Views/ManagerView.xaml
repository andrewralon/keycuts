<UserControl x:Class="keycuts.GUI.Views.ManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:keycuts.GUI.Controls"
             xmlns:themes="clr-namespace:keycuts.GUI.Themes"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:design="clr-namespace:keycuts.GUI.DesignData"
             mc:Ignorable="d" d:DataContext="{x:Static design:DesignViewModels.ManagerTwoItems}"
             Background="{DynamicResource SurfaceBrush}"
             Loaded="ManagerView_Loaded">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

    <!-- Single-line table text: trims with an ellipsis and shows the full value in a tooltip. -->
    <Style x:Key="CellText" TargetType="TextBlock">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
      <Setter Property="TextWrapping" Value="NoWrap" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
      <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
      <Style.Triggers>
        <Trigger Property="Text" Value="">
          <Setter Property="ToolTipService.IsEnabled" Value="False" />
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="ManagerHeader" TargetType="DataGridColumnHeader">
      <Setter Property="Height" Value="34" />
      <Setter Property="Padding" Value="10,0" />
      <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="IsTabStop" Value="False" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="DataGridColumnHeader">
            <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
              <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Left" RecognizesAccessKey="False"
                                SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Sortable column header: label plus a chevron that shows on hover and for the active column. -->
    <Style x:Key="SortHeaderButtonStyle" TargetType="controls:SortHeaderButton">
      <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
      <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="ActiveColumn" Value="{Binding DataContext.SortColumn, RelativeSource={RelativeSource AncestorType=UserControl}}" />
      <Setter Property="IsDescending" Value="{Binding DataContext.SortDescending, RelativeSource={RelativeSource AncestorType=UserControl}}" />
      <Setter Property="Command" Value="{Binding DataContext.SortCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
      <Setter Property="CommandParameter" Value="{Binding Column, RelativeSource={RelativeSource Self}}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="controls:SortHeaderButton">
            <Border x:Name="Frame" Background="Transparent" BorderBrush="Transparent" BorderThickness="1"
                    CornerRadius="3" Padding="3,2">
              <StackPanel Orientation="Horizontal">
                <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="False" />
                <controls:Icon x:Name="Chevron" Kind="Chevron" Size="11" Margin="3,0,0,0" Opacity="0"
                               VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                  <controls:Icon.RenderTransform>
                    <RotateTransform Angle="90" />
                  </controls:Icon.RenderTransform>
                </controls:Icon>
              </StackPanel>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                <Setter TargetName="Chevron" Property="Opacity" Value="1" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                <Setter TargetName="Chevron" Property="Opacity" Value="1" />
              </Trigger>
              <Trigger Property="State" Value="Ascending">
                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                <Setter TargetName="Chevron" Property="Opacity" Value="1" />
                <Setter TargetName="Chevron" Property="RenderTransform">
                  <Setter.Value>
                    <RotateTransform Angle="-90" />
                  </Setter.Value>
                </Setter>
              </Trigger>
              <Trigger Property="State" Value="Descending">
                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                <Setter TargetName="Chevron" Property="Opacity" Value="1" />
                <Setter TargetName="Chevron" Property="RenderTransform">
                  <Setter.Value>
                    <RotateTransform Angle="90" />
                  </Setter.Value>
                </Setter>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Rows have no selection, focus or click behavior; only a restrained hover tint. -->
    <Style x:Key="ManagerRow" TargetType="DataGridRow">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Cursor" Value="Arrow" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="IsTabStop" Value="False" />
      <Setter Property="ValidationErrorTemplate" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="DataGridRow">
            <Border Background="{TemplateBinding Background}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,0,1" SnapsToDevicePixels="True">
              <DataGridCellsPresenter ItemsPanel="{TemplateBinding ItemsPanel}"
                                      SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
        </Trigger>
        <DataTrigger Binding="{Binding IsMenuOpen}" Value="True">
          <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="ManagerCell" TargetType="DataGridCell">
      <Setter Property="Focusable" Value="False" />
      <Setter Property="IsTabStop" Value="False" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="10,0" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="DataGridCell">
            <Border Background="Transparent" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
              <ContentPresenter VerticalAlignment="Center" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="ManagerTable" TargetType="DataGrid">
      <Setter Property="AutoGenerateColumns" Value="False" />
      <Setter Property="IsReadOnly" Value="True" />
      <Setter Property="CanUserAddRows" Value="False" />
      <Setter Property="CanUserDeleteRows" Value="False" />
      <Setter Property="CanUserResizeRows" Value="False" />
      <Setter Property="CanUserResizeColumns" Value="False" />
      <Setter Property="CanUserReorderColumns" Value="False" />
      <Setter Property="CanUserSortColumns" Value="False" />
      <Setter Property="ClipboardCopyMode" Value="None" />
      <Setter Property="HeadersVisibility" Value="Column" />
      <Setter Property="GridLinesVisibility" Value="None" />
      <Setter Property="SelectionMode" Value="Single" />
      <Setter Property="SelectionUnit" Value="FullRow" />
      <Setter Property="RowHeight" Value="36" />
      <Setter Property="ColumnHeaderHeight" Value="34" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
      <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="EnableRowVirtualization" Value="True" />
      <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
      <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
      <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
      <Setter Property="ColumnHeaderStyle" Value="{StaticResource ManagerHeader}" />
      <Setter Property="RowStyle" Value="{StaticResource ManagerRow}" />
      <Setter Property="CellStyle" Value="{StaticResource ManagerCell}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="DataGrid">
            <Border Background="{TemplateBinding Background}" BorderThickness="{TemplateBinding BorderThickness}"
                    SnapsToDevicePixels="True">
              <ScrollViewer x:Name="DG_ScrollViewer" Focusable="False">
                <ScrollViewer.Template>
                  <ControlTemplate TargetType="ScrollViewer">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                      </Grid.RowDefinitions>
                      <Border Grid.ColumnSpan="2" Background="{DynamicResource SurfaceSubtleBrush}"
                              BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" />
                      <DataGridColumnHeadersPresenter x:Name="PART_ColumnHeadersPresenter" />
                      <ScrollContentPresenter x:Name="PART_ScrollContentPresenter" Grid.Row="1"
                                              CanContentScroll="{TemplateBinding CanContentScroll}" />
                      <ScrollBar x:Name="PART_VerticalScrollBar" Grid.Column="1" Grid.Row="1"
                                 Maximum="{TemplateBinding ScrollableHeight}"
                                 ViewportSize="{TemplateBinding ViewportHeight}"
                                 Value="{Binding VerticalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"
                                 Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" />
                    </Grid>
                  </ControlTemplate>
                </ScrollViewer.Template>
                <ItemsPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
              </ScrollViewer>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid Grid.Row="0" Margin="24,24,24,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Text="KEYCUT MANAGER" FontSize="{StaticResource FontSizeEyebrow}" FontWeight="SemiBold"
                   Foreground="{DynamicResource AccentBrush}" />
        <TextBlock Text="Your keycuts" FontSize="{StaticResource FontSizeHeadingLarge}" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextBrush}" AutomationProperties.HeadingLevel="Level1" />
        <TextBlock Text="Scan, search, and manage every shortcut in one place." Margin="0,4,0,0"
                   FontSize="{StaticResource FontSizeBody}" Foreground="{DynamicResource TextSecondaryBrush}"
                   TextTrimming="CharacterEllipsis" />
      </StackPanel>
      <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" VerticalAlignment="Top" Margin="12,0,40,0"
              Command="{Binding ShowCreatorCommand}">
        <StackPanel Orientation="Horizontal">
          <controls:Icon Kind="Spark" Size="15" />
          <TextBlock Text="New keycut" Margin="8,0,0,0" />
        </StackPanel>
      </Button>
    </Grid>

    <Grid Grid.Row="1" Margin="24,16,24,12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Grid>
        <TextBox x:Name="SearchBox" Style="{StaticResource AppTextBox}" Padding="34,0,10,0"
                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                 IsEnabled="{Binding CanSearch}" IsEnabledChanged="SearchBox_IsEnabledChanged"
                 themes:TextBoxChrome.Placeholder="Search names, types, descriptions, or destinations"
                 AutomationProperties.Name="Search shortcuts" />
        <controls:Icon Kind="Search" Size="16" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="11,0,0,0"
                       IsHitTestVisible="False" Foreground="{DynamicResource TextTertiaryBrush}" />
      </Grid>
      <TextBlock Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="{StaticResource FontSizeBody}"
                 Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding ResultCountText}"
                 AutomationProperties.LiveSetting="Polite" />
    </Grid>

    <Grid Grid.Row="2" Margin="24,0,24,12">
      <!-- Populated -->
      <Border x:Name="TableHost" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
              CornerRadius="{StaticResource RadiusMd}" SizeChanged="TableHost_SizeChanged"
              Visibility="{Binding IsTableVisible, Converter={StaticResource BoolToVisibility}}">
        <DataGrid x:Name="Table" Style="{StaticResource ManagerTable}" ItemsSource="{Binding Rows}"
                  AutomationProperties.Name="Keycuts" PreviewKeyDown="Table_PreviewKeyDown"
                  KeyboardNavigation.TabNavigation="Continue">
          <DataGrid.Columns>
            <DataGridTemplateColumn Width="1.7*" MinWidth="190">
              <DataGridTemplateColumn.Header>
                <controls:SortHeaderButton Column="Shortcut" Content="Shortcut" Style="{StaticResource SortHeaderButtonStyle}" />
              </DataGridTemplateColumn.Header>
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource CellText}" Text="{Binding Name}" FontWeight="Bold"
                               Foreground="{DynamicResource TextBrush}" />
                    <StackPanel Orientation="Horizontal" Margin="0,1,0,0" ToolTip="{Binding MissingTooltip}"
                                Visibility="{Binding IsDestinationMissing, Converter={StaticResource BoolToVisibility}}">
                      <controls:Icon Kind="Close" Size="11" VerticalAlignment="Center"
                                     Foreground="{DynamicResource DangerBrush}" />
                      <TextBlock Text="Missing" Margin="3,0,0,0" FontSize="{StaticResource FontSizeEyebrow}"
                                 VerticalAlignment="Center" Foreground="{DynamicResource DangerBrush}" />
                    </StackPanel>
                  </StackPanel>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Width="110">
              <DataGridTemplateColumn.Header>
                <controls:SortHeaderButton Column="Type" Content="Type" Style="{StaticResource SortHeaderButtonStyle}" />
              </DataGridTemplateColumn.Header>
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <controls:TypeBadge Kind="{Binding Kind}" HorizontalAlignment="Left" VerticalAlignment="Center" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Width="1.5*" MinWidth="100">
              <DataGridTemplateColumn.Header>
                <controls:SortHeaderButton Column="Description" Content="Description" Style="{StaticResource SortHeaderButtonStyle}" />
              </DataGridTemplateColumn.Header>
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <TextBlock Style="{StaticResource CellText}" Text="{Binding Description}" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="Destination" Width="2.8*" MinWidth="120">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <TextBlock Style="{StaticResource CellText}" Text="{Binding Destination}" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Width="44">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <controls:MenuButton Style="{StaticResource IconButton}" Width="28" Height="28"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       AutomationProperties.Name="{Binding ActionsLabel}"
                                       Click="RowMenu_Click" PreviewKeyDown="RowMenu_PreviewKeyDown">
                    <controls:Icon Kind="More" Size="17" />
                    <Button.ContextMenu>
                      <ContextMenu Width="190" Placement="Bottom" HorizontalOffset="-162" VerticalOffset="4"
                                   Opened="RowMenu_Opened" Closed="RowMenu_Closed" PreviewKeyDown="RowMenuPopup_PreviewKeyDown">
                        <MenuItem Header="Open keycut" Command="{Binding OpenCommand}" Click="SafeItem_Click">
                          <MenuItem.Icon>
                            <controls:Icon Kind="Play" Size="16" />
                          </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Edit" Command="{Binding EditCommand}" Click="SafeItem_Click">
                          <MenuItem.Icon>
                            <controls:Icon Kind="File" Size="16" />
                          </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Copy destination" Command="{Binding CopyDestinationCommand}" Click="SafeItem_Click">
                          <MenuItem.Icon>
                            <controls:Icon Kind="Copy" Size="16" />
                          </MenuItem.Icon>
                        </MenuItem>
                        <Separator />
                        <MenuItem Header="Delete" Style="{StaticResource DangerMenuItem}" Command="{Binding DeleteCommand}">
                          <MenuItem.Icon>
                            <controls:Icon Kind="Delete" Size="16" Foreground="{DynamicResource DangerBrush}" />
                          </MenuItem.Icon>
                        </MenuItem>
                      </ContextMenu>
                    </Button.ContextMenu>
                  </controls:MenuButton>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
          </DataGrid.Columns>
        </DataGrid>
      </Border>

      <!-- Loading -->
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal"
                  Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}">
        <Control Style="{StaticResource Spinner}" VerticalAlignment="Center" />
        <TextBlock Text="Loading keycuts…" Margin="10,0,0,0" VerticalAlignment="Center"
                   Foreground="{DynamicResource TextSecondaryBrush}" />
      </StackPanel>

      <!-- Empty -->
      <Grid Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
        <Rectangle RadiusX="8" RadiusY="8" Stroke="{DynamicResource BorderStrongBrush}" StrokeThickness="1"
                   StrokeDashArray="4 3" />
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
          <Grid Width="58" Height="58" HorizontalAlignment="Center" Margin="0,0,0,12">
            <Border CornerRadius="15" Background="{DynamicResource AccentSoftBrush}" />
            <controls:Icon Kind="File" Size="32" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{DynamicResource AccentBrush}" />
            <controls:Icon Kind="Spark" Size="14" HorizontalAlignment="Right" VerticalAlignment="Top"
                           Margin="0,6,6,0" Foreground="{DynamicResource AccentBrush}" />
          </Grid>
          <TextBlock Text="No keycuts yet" HorizontalAlignment="Center" FontSize="{StaticResource FontSizeSubheading}"
                     AutomationProperties.HeadingLevel="Level2"
                     FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" />
          <TextBlock Text="Create your first keycut and it will show up here." HorizontalAlignment="Center"
                     Margin="0,4,0,16" Foreground="{DynamicResource TextSecondaryBrush}" />
          <Button x:Name="EmptyCreateButton" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Center" Padding="16,0" Height="38"
                  Command="{Binding ShowCreatorCommand}">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="Create a keycut" />
              <controls:Icon Kind="Arrow" Size="16" Margin="8,0,0,0" />
            </StackPanel>
          </Button>
        </StackPanel>
      </Grid>

      <!-- No search results -->
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                  Visibility="{Binding IsNoResults, Converter={StaticResource BoolToVisibility}}">
        <TextBlock Text="{Binding NoResultsMessage}" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"
                   MaxWidth="560" FontSize="{StaticResource FontSizeSubheading}" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextBrush}" />
        <Button Style="{StaticResource SecondaryButton}" Content="Clear search" HorizontalAlignment="Center"
                Margin="0,12,0,0" Command="{Binding ClearSearchCommand}" />
      </StackPanel>

      <!-- Load error -->
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="560"
                  Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
        <TextBlock Text="Can't load your keycuts" HorizontalAlignment="Center" AutomationProperties.HeadingLevel="Level2"
                   AutomationProperties.LiveSetting="Assertive"
                   FontSize="{StaticResource FontSizeSubheading}" FontWeight="SemiBold"
                   Foreground="{DynamicResource DangerBrush}" />
        <TextBlock Text="{Binding ErrorMessage}" HorizontalAlignment="Center" TextAlignment="Center"
                   TextWrapping="Wrap" Margin="0,4,0,16" Foreground="{DynamicResource TextSecondaryBrush}" />
        <Button Style="{StaticResource SecondaryButton}" Content="Open settings" HorizontalAlignment="Center"
                Command="{Binding OpenSettingsCommand}" />
      </StackPanel>
    </Grid>

    <Border Grid.Row="3" Height="34" Background="{DynamicResource SurfaceSubtleBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
      <Grid Margin="24,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <TextBlock VerticalAlignment="Center" FontSize="{StaticResource FontSizeCaption}"
                   Foreground="{DynamicResource TextTertiaryBrush}" Text="{Binding StatusText}" />
        <TextBlock Grid.Column="1" x:Name="StatusMessageText" Margin="16,0,0,0" HorizontalAlignment="Right"
                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" FontSize="{StaticResource FontSizeCaption}"
                   Text="{Binding StatusMessage}" AutomationProperties.LiveSetting="Polite">
          <TextBlock.Style>
            <Style TargetType="TextBlock">
              <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                  <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>
      </Grid>
    </Border>

    <!-- Declared last so Tab reaches it after the status bar; it sits visually at the top right. -->
    <Button Style="{StaticResource IconButton}" HorizontalAlignment="Right" VerticalAlignment="Top"
            Margin="0,24,24,0" Command="{Binding OpenSettingsCommand}" AutomationProperties.Name="Open settings">
      <controls:Icon Kind="Settings" />
    </Button>
  </Grid>
</UserControl>
