#!/bin/sh
# keycuts 2.0.0
# <shortcut>/Users/me/Shortcuts/url-quote</shortcut>
# <type>url</type>
# <target>https://example.com/?q=it's+$5&x=`a`</target>
# <description></description>
open 'https://example.com/?q=it'\''s+$5&x=`a`'
s=$?
u="$HOME/Library/Application Support/keycuts/usage"; { mkdir -p "$u" && echo 1 >>"$u/${0##*/}.runs"; } 2>/dev/null
exit $s
