<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="AccentBrush" Color="#4f8cff" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#75a5ff" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#3f76da" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#182a4d" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="#6a9eff" />
    <SolidColorBrush x:Key="CanvasBrush" Color="#14171d" />
    <SolidColorBrush x:Key="SidebarBrush" Color="#191c23" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#20242c" />
    <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="#272c35" />
    <SolidColorBrush x:Key="SurfaceSubtleBrush" Color="#252a33" />
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#2c3441" />
    <SolidColorBrush x:Key="TextBrush" Color="#f3f5f8" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#bdc5d2" />
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="#8d97a8" />
    <SolidColorBrush x:Key="BorderBrush" Color="#363d48" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="#4a5361" />
    <SolidColorBrush x:Key="ControlBorderBrush" Color="#8d97a8" />
    <SolidColorBrush x:Key="DangerBrush" Color="#ff8175" />
    <SolidColorBrush x:Key="DangerSoftBrush" Color="#482522" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#64d5a0" />
    <SolidColorBrush x:Key="WarningBrush" Color="#f0c365" />
    <SolidColorBrush x:Key="OnAccentBrush" Color="#06090f" />
    <SolidColorBrush x:Key="BadgeUrlForegroundBrush" Color="#c4a1ff" />
    <SolidColorBrush x:Key="BadgeUrlBackgroundBrush" Color="#33254c" />
    <SolidColorBrush x:Key="BadgeUrlBorderBrush" Color="#574279" />
    <SolidColorBrush x:Key="BadgeFileForegroundBrush" Color="#86c8ff" />
    <SolidColorBrush x:Key="BadgeFileBackgroundBrush" Color="#18354e" />
    <SolidColorBrush x:Key="BadgeFileBorderBrush" Color="#295879" />
    <SolidColorBrush x:Key="BadgeFolderForegroundBrush" Color="#f0c365" />
    <SolidColorBrush x:Key="BadgeFolderBackgroundBrush" Color="#41351e" />
    <SolidColorBrush x:Key="BadgeFolderBorderBrush" Color="#62502a" />
    <SolidColorBrush x:Key="BadgeCommandForegroundBrush" Color="#75dca8" />
    <SolidColorBrush x:Key="BadgeCommandBackgroundBrush" Color="#193c2c" />
    <SolidColorBrush x:Key="BadgeCommandBorderBrush" Color="#285e45" />
    <SolidColorBrush x:Key="ScrimBrush" Color="#99000000" />
    <Color x:Key="ShadowColor">#000000</Color>

    <!-- Tab bar (#218): the bar, its tabs, the app icon's socket and the caption buttons. Gradients and textures live here, not in the views. -->
    <LinearGradientBrush x:Key="RailBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#1c2029" Offset="0" />
        <GradientStop Color="#111318" Offset="1" />
    </LinearGradientBrush>
    <!-- Fine horizontal lines over the bar: 1 px in every 3 -->
    <DrawingBrush x:Key="RailTextureBrush" TileMode="Tile" ViewportUnits="Absolute" Viewport="0,0,4,3" ViewboxUnits="Absolute" Viewbox="0,0,4,3">
        <DrawingBrush.Drawing>
            <GeometryDrawing Brush="#06ffffff"><GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,4,1" /></GeometryDrawing.Geometry></GeometryDrawing>
        </DrawingBrush.Drawing>
    </DrawingBrush>
    <!-- The faint dot grid in the empty, draggable part of the bar -->
    <DrawingBrush x:Key="RailGripBrush" TileMode="Tile" ViewportUnits="Absolute" Viewport="0,0,6,6" ViewboxUnits="Absolute" Viewbox="0,0,6,6">
        <DrawingBrush.Drawing>
            <GeometryDrawing Brush="#1affffff"><GeometryDrawing.Geometry><RectangleGeometry Rect="2.5,2.5,1,1" /></GeometryDrawing.Geometry></GeometryDrawing>
        </DrawingBrush.Drawing>
    </DrawingBrush>
    <LinearGradientBrush x:Key="TabBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#2b313c" Offset="0" />
        <GradientStop Color="#191c23" Offset="1" />
    </LinearGradientBrush>
    <!-- Fine diagonal lines over an inactive tab: 1 px in every 4 -->
    <DrawingBrush x:Key="TabTextureBrush" TileMode="Tile" ViewportUnits="Absolute" Viewport="0,0,4,4" ViewboxUnits="Absolute" Viewbox="0,0,4,4">
        <DrawingBrush.Drawing>
            <GeometryDrawing>
                <GeometryDrawing.Pen><Pen Brush="#0bffffff" Thickness="1" /></GeometryDrawing.Pen>
                <GeometryDrawing.Geometry>
                    <GeometryGroup>
                        <LineGeometry StartPoint="0,4" EndPoint="4,0" />
                        <LineGeometry StartPoint="-1,1" EndPoint="1,-1" />
                        <LineGeometry StartPoint="3,5" EndPoint="5,3" />
                    </GeometryGroup>
                </GeometryDrawing.Geometry>
            </GeometryDrawing>
        </DrawingBrush.Drawing>
    </DrawingBrush>
    <SolidColorBrush x:Key="TabBorderBrush" Color="#3d4553" />
    <SolidColorBrush x:Key="TabSelectedBorderBrush" Color="#4a5361" />
    <SolidColorBrush x:Key="TabTextBrush" Color="#9aa4b5" />
    <SolidColorBrush x:Key="TabBaseBrush" Color="Transparent" />
    <LinearGradientBrush x:Key="SocketBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#20242c" Offset="0" />
        <GradientStop Color="#14171d" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="SocketBorderBrush" Color="#363d48" />
    <SolidColorBrush x:Key="CaptionHoverBrush" Color="#14ffffff" />
    <SolidColorBrush x:Key="CaptionPressedBrush" Color="#24ffffff" />
    <SolidColorBrush x:Key="CaptionHoverGlyphBrush" Color="#f3f5f8" />
    <!-- The one fixed color: Windows' close button is this red with a white glyph in every theme -->
    <SolidColorBrush x:Key="CaptionCloseBrush" Color="#c42b1c" />
    <SolidColorBrush x:Key="CaptionCloseGlyphBrush" Color="#ffffff" />
</ResourceDictionary>
