<Window x:Class="keycuts.GUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:vm="clr-namespace:keycuts.GUI.ViewModels"
        xmlns:views="clr-namespace:keycuts.GUI.Views"
        xmlns:controls="clr-namespace:keycuts.GUI.Controls"
        Title="{Binding Title}" Width="{StaticResource MainWidth}" SizeToContent="Height" ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True"
        AllowsTransparency="True" WindowStyle="None" Background="Transparent" Foreground="{DynamicResource TextBrush}"
        FontFamily="{StaticResource AppFontFamily}" FontSize="{StaticResource FontSizeBody}"
        KeyDown="Main_KeyDown">
  <!-- #218: no standard title bar. The tab bar (RailView) is the top row and does what a title bar does: WindowChrome makes
       RailHeight of it a caption (drag, snap, the window menu) and leaves the resize border at the large size, the shadow,
       the rounded corners and Aero Snap to Windows. The tabs and caption buttons are marked IsHitTestVisibleInChrome in RailView.
       The window is never maximized, on any screen (NoMaximizeHook). The Title stays "keycuts" for the taskbar and Alt+Tab. -->
  <shell:WindowChrome.WindowChrome>
    <!-- The Creator is fixed-size (ResizeMode.CanMinimize), but WindowChrome would still answer a resize edge at the border, with the
         resize cursor and no resizing: the border is 0 there, and MainWindow sets it for the Manager and Settings. -->
    <shell:WindowChrome CaptionHeight="{StaticResource RailHeight}" ResizeBorderThickness="0"
                        GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
  </shell:WindowChrome.WindowChrome>
  <Window.Resources>
    <DataTemplate DataType="{x:Type vm:CreatorViewModel}">
      <views:CreatorView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:ManagerViewModel}">
      <views:ManagerView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
      <views:SettingsView />
    </DataTemplate>
  </Window.Resources>
  <!-- The torn bottom-right corner (docs/mockups/torn-corner-v2, B2): the window is transparent (AllowsTransparency), the page
       (Frame) is clipped to the torn shape in MainWindow, and TornCorner draws the frayed edge and threads over it. High contrast
       keeps the plain rectangle. -->
  <Grid>
    <Grid x:Name="Frame" Background="{DynamicResource CanvasBrush}">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <views:RailView x:Name="Rail" Grid.Row="0" />
      <ContentControl Grid.Row="1" Content="{Binding CurrentView}" Focusable="False" IsTabStop="False" />
      <!-- A transparent window gets no border from Windows, so the page draws its own; the clip cuts it off at the rip -->
      <Border Grid.RowSpan="2" BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1" IsHitTestVisible="False" />
    </Grid>
    <controls:TornCorner x:Name="Tear" Stroke="{DynamicResource ControlBorderBrush}" />
  </Grid>
</Window>
