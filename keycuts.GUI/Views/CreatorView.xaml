<UserControl x:Class="keycuts.GUI.Views.CreatorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:keycuts.GUI.Controls"
             Background="Transparent" Loaded="CreatorView_Loaded" KeyDown="CreatorView_KeyDown"
             DragEnter="Creator_DragEnter" Drop="Creator_Drop" AllowDrop="True">
  <!-- Interim compact layout; KC-09 replaces it with the final creator design. -->
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid Grid.Row="0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Text="NEW KEYCUT" FontSize="{StaticResource FontSizeEyebrow}" FontWeight="SemiBold"
                   Foreground="{DynamicResource AccentBrush}" />
        <TextBlock Text="Launch anything instantly" FontSize="{StaticResource FontSizeHeading}" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextBrush}" />
      </StackPanel>
      <Button Grid.Column="1" Style="{StaticResource IconButton}" VerticalAlignment="Top"
              Command="{Binding OpenSettingsCommand}" AutomationProperties.Name="Open settings">
        <controls:Icon Kind="Settings" />
      </Button>
    </Grid>

    <TextBlock Grid.Row="1" Text="Destination" Margin="0,16,0,4" FontSize="{StaticResource FontSizeBody}"
               Foreground="{DynamicResource TextSecondaryBrush}" />
    <TextBox x:Name="TextboxDestination" Grid.Row="2" Style="{StaticResource AppTextBox}"
             Text="{Binding Destination, UpdateSourceTrigger=PropertyChanged}"
             AutomationProperties.Name="Destination"
             AllowDrop="True" PreviewDragOver="TextboxDestination_PreviewDragOver"
             DragEnter="Creator_DragEnter" Drop="Creator_Drop" />

    <TextBlock Grid.Row="3" Text="Name your keycut" Margin="0,12,0,4" FontSize="{StaticResource FontSizeBody}"
               Foreground="{DynamicResource TextSecondaryBrush}" />
    <Grid Grid.Row="4">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBox x:Name="TextboxShortcut" Style="{StaticResource AppTextBox}"
               Text="{Binding ShortcutName, UpdateSourceTrigger=PropertyChanged}"
               AutomationProperties.Name="Keycut name" />
      <Button x:Name="BtnCreateShortcut" Grid.Column="1" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0"
              Content="Create" Click="CreateShortcut_Click" />
    </Grid>

    <Button Grid.Row="5" Style="{StaticResource SecondaryButton}" Margin="0,16,0,0" HorizontalAlignment="Left"
            Command="{Binding ShowManagerCommand}">
      <StackPanel Orientation="Horizontal">
        <controls:Icon Kind="External" Size="15" />
        <TextBlock Text="View all keycuts" Margin="8,0,0,0" />
        <TextBlock Text="{Binding KeycutCount}" Margin="8,0,0,0" Foreground="{DynamicResource TextSecondaryBrush}" />
      </StackPanel>
    </Button>
  </Grid>
</UserControl>
