<UserControl x:Class="keycuts.GUI.Views.ManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:keycuts.GUI.Controls"
             xmlns:themes="clr-namespace:keycuts.GUI.Themes"
             xmlns:views="clr-namespace:keycuts.GUI.Views"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:design="clr-namespace:keycuts.GUI.DesignData"
             mc:Ignorable="d" d:DataContext="{x:Static design:DesignViewModels.ManagerTwoItems}"
             Background="{DynamicResource SurfaceBrush}"
             Loaded="ManagerView_Loaded" PreviewKeyDown="ManagerView_PreviewKeyDown"
             PreviewMouseDown="ManagerView_PreviewMouseDown">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

    <!-- Single-line table text: trims with an ellipsis and shows the full value in a tooltip. -->
    <Style x:Key="CellText" TargetType="TextBlock">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
      <Setter Property="TextWrapping" Value="NoWrap" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
      <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
      <Style.Triggers>
        <Trigger Property="Text" Value="">
          <Setter Property="ToolTipService.IsEnabled" Value="False" />
        </Trigger>
      </Style.Triggers>
    </Style>

    <!-- The divider between two column headers, to drag (#202). Wider than it looks, so it's easy to hit; the line shows on
         hover and turns to the accent while dragging. Mouse only: the full values are in the cells' tooltips. -->
    <Style x:Key="ColumnGripper" TargetType="Thumb">
      <Setter Property="Width" Value="9" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Cursor" Value="SizeWE" />
      <Setter Property="Focusable" Value="False" />
      <!-- A double click on a divider would size the column to its content (see Gripper_PreviewMouseDoubleClick) -->
      <EventSetter Event="PreviewMouseDoubleClick" Handler="Gripper_PreviewMouseDoubleClick" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Thumb">
            <Border Background="{TemplateBinding Background}">
              <Rectangle x:Name="Line" Width="2" Margin="0,9" HorizontalAlignment="Center"
                         Fill="{DynamicResource BorderStrongBrush}" Opacity="0" SnapsToDevicePixels="True" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Line" Property="Opacity" Value="1" />
              </Trigger>
              <Trigger Property="IsDragging" Value="True">
                <Setter TargetName="Line" Property="Opacity" Value="1" />
                <Setter TargetName="Line" Property="Fill" Value="{DynamicResource AccentBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="ManagerHeader" TargetType="DataGridColumnHeader">
      <Setter Property="Height" Value="34" />
      <Setter Property="Padding" Value="10,0" />
      <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="IsTabStop" Value="False" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="DataGridColumnHeader">
            <Grid>
              <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Left" RecognizesAccessKey="False"
                                  SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
              </Border>
              <!-- The grid finds these two by name and hides the one a column can't use (a fixed column, the first one's left).
                   It sets the thumb's own Visibility, so a header that must not offer one (see Tag, below) collapses its host. -->
              <Border x:Name="LeftGripperHost" HorizontalAlignment="Left">
                <Thumb x:Name="PART_LeftHeaderGripper" Style="{StaticResource ColumnGripper}" />
              </Border>
              <Border x:Name="RightGripperHost" HorizontalAlignment="Right">
                <Thumb x:Name="PART_RightHeaderGripper" Style="{StaticResource ColumnGripper}" />
              </Border>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="Tag" Value="NoRightGripper">
                <Setter TargetName="RightGripperHost" Property="Visibility" Value="Collapsed" />
              </Trigger>
              <Trigger Property="Tag" Value="NoGrippers">
                <Setter TargetName="LeftGripperHost" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="RightGripperHost" Property="Visibility" Value="Collapsed" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- The last column that gives way: the divider on its right can't move, since the fixed columns beside it are pinned -->
    <Style x:Key="ManagerHeaderPinnedRight" TargetType="DataGridColumnHeader" BasedOn="{StaticResource ManagerHeader}">
      <Setter Property="Tag" Value="NoRightGripper" />
    </Style>

    <!-- The fixed columns (Modified, the menu): their left divider would resize the column before them, whose right edge is pinned -->
    <Style x:Key="ManagerHeaderFixed" TargetType="DataGridColumnHeader" BasedOn="{StaticResource ManagerHeader}">
      <Setter Property="Tag" Value="NoGrippers" />
    </Style>

    <!-- Sortable column header: label plus a chevron that shows on hover and for the active column. -->
    <Style x:Key="SortHeaderButtonStyle" TargetType="controls:SortHeaderButton">
      <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
      <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="ActiveColumn" Value="{Binding DataContext.SortColumn, RelativeSource={RelativeSource AncestorType=UserControl}}" />
      <Setter Property="IsDescending" Value="{Binding DataContext.SortDescending, RelativeSource={RelativeSource AncestorType=UserControl}}" />
      <Setter Property="Command" Value="{Binding DataContext.SortCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
      <Setter Property="CommandParameter" Value="{Binding Column, RelativeSource={RelativeSource Self}}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="controls:SortHeaderButton">
            <Border x:Name="Frame" Background="Transparent" BorderBrush="Transparent" BorderThickness="1"
                    CornerRadius="3" Padding="3,2">
              <StackPanel Orientation="Horizontal">
                <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="False" />
                <controls:Icon x:Name="Chevron" Kind="Chevron" Size="11" Margin="3,0,0,0" Opacity="0"
                               VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                  <controls:Icon.RenderTransform>
                    <RotateTransform Angle="90" />
                  </controls:Icon.RenderTransform>
                </controls:Icon>
              </StackPanel>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                <Setter TargetName="Chevron" Property="Opacity" Value="1" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                <Setter TargetName="Chevron" Property="Opacity" Value="1" />
              </Trigger>
              <Trigger Property="State" Value="Ascending">
                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                <Setter TargetName="Chevron" Property="Opacity" Value="1" />
                <Setter TargetName="Chevron" Property="RenderTransform">
                  <Setter.Value>
                    <RotateTransform Angle="-90" />
                  </Setter.Value>
                </Setter>
              </Trigger>
              <Trigger Property="State" Value="Descending">
                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                <Setter TargetName="Chevron" Property="Opacity" Value="1" />
                <Setter TargetName="Chevron" Property="RenderTransform">
                  <Setter.Value>
                    <RotateTransform Angle="90" />
                  </Setter.Value>
                </Setter>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Rows take no keyboard focus: Up and Down move the selection while focus stays in the search box.
         The bar keeps the selection visible in high contrast, where the tint disappears. -->
    <Style x:Key="ManagerRow" TargetType="DataGridRow">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Cursor" Value="Arrow" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="IsTabStop" Value="False" />
      <Setter Property="ValidationErrorTemplate" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="DataGridRow">
            <Border Background="{TemplateBinding Background}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,0,1" SnapsToDevicePixels="True">
              <Grid>
                <DataGridCellsPresenter ItemsPanel="{TemplateBinding ItemsPanel}"
                                        SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                <Rectangle x:Name="SelectionBar" Width="3" HorizontalAlignment="Left" Visibility="Collapsed"
                           Fill="{DynamicResource AccentBrush}" />
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="SelectionBar" Property="Visibility" Value="Visible" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
        </Trigger>
        <DataTrigger Binding="{Binding IsMenuOpen}" Value="True">
          <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
        </DataTrigger>
        <Trigger Property="IsSelected" Value="True">
          <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="ManagerCell" TargetType="DataGridCell">
      <Setter Property="Focusable" Value="False" />
      <Setter Property="IsTabStop" Value="False" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="10,0" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="DataGridCell">
            <Border Background="Transparent" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
              <ContentPresenter VerticalAlignment="Center" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="ManagerTable" TargetType="DataGrid">
      <Setter Property="AutoGenerateColumns" Value="False" />
      <Setter Property="IsReadOnly" Value="True" />
      <Setter Property="CanUserAddRows" Value="False" />
      <Setter Property="CanUserDeleteRows" Value="False" />
      <Setter Property="CanUserResizeRows" Value="False" />
      <!-- Name, Description and Target can be dragged (#202); the others say CanUserResize="False" -->
      <Setter Property="CanUserResizeColumns" Value="True" />
      <Setter Property="CanUserReorderColumns" Value="False" />
      <Setter Property="CanUserSortColumns" Value="False" />
      <Setter Property="ClipboardCopyMode" Value="None" />
      <Setter Property="HeadersVisibility" Value="Column" />
      <Setter Property="GridLinesVisibility" Value="None" />
      <Setter Property="SelectionMode" Value="Single" />
      <Setter Property="SelectionUnit" Value="FullRow" />
      <Setter Property="RowHeight" Value="36" />
      <Setter Property="ColumnHeaderHeight" Value="34" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
      <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="EnableRowVirtualization" Value="True" />
      <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
      <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
      <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
      <Setter Property="ColumnHeaderStyle" Value="{StaticResource ManagerHeader}" />
      <Setter Property="RowStyle" Value="{StaticResource ManagerRow}" />
      <Setter Property="CellStyle" Value="{StaticResource ManagerCell}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="DataGrid">
            <Border Background="{TemplateBinding Background}" BorderThickness="{TemplateBinding BorderThickness}"
                    SnapsToDevicePixels="True">
              <ScrollViewer x:Name="DG_ScrollViewer" Focusable="False">
                <ScrollViewer.Template>
                  <ControlTemplate TargetType="ScrollViewer">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                      </Grid.RowDefinitions>
                      <Border Grid.ColumnSpan="2" Background="{DynamicResource SurfaceSubtleBrush}"
                              BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" />
                      <DataGridColumnHeadersPresenter x:Name="PART_ColumnHeadersPresenter" />
                      <ScrollContentPresenter x:Name="PART_ScrollContentPresenter" Grid.Row="1"
                                              CanContentScroll="{TemplateBinding CanContentScroll}" />
                      <ScrollBar x:Name="PART_VerticalScrollBar" Grid.Column="1" Grid.Row="1"
                                 Maximum="{TemplateBinding ScrollableHeight}"
                                 ViewportSize="{TemplateBinding ViewportHeight}"
                                 Value="{Binding VerticalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"
                                 Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" />
                    </Grid>
                  </ControlTemplate>
                </ScrollViewer.Template>
                <ItemsPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
              </ScrollViewer>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid Grid.Row="0" Margin="24,24,24,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock Text="keycuts manager" FontSize="{StaticResource FontSizeHeading}" FontWeight="SemiBold"
                 VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}"
                 AutomationProperties.HeadingLevel="Level1" />
      <!-- Lowercase on purpose: the creator's link to this screen says "manager" -->
      <Button x:Name="BtnCreator" Grid.Column="1" Style="{StaticResource SecondaryButton}" VerticalAlignment="Center" Margin="12,0,0,0"
              AutomationProperties.Name="creator"
              Command="{Binding ShowCreatorCommand}">
        <StackPanel Orientation="Horizontal">
          <controls:Icon Kind="Spark" Size="15" />
          <TextBlock Text="creator" Margin="8,0,0,0" />
        </StackPanel>
      </Button>
    </Grid>

    <!-- The total is the footer's pill (#205). "4 of 355 shown" sits at the right of the search box only while a search hides some -->
    <Grid Grid.Row="1" Margin="24,16,24,12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Grid>
        <TextBox x:Name="SearchBox" Style="{StaticResource AppTextBox}" Padding="34,0,10,0"
                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                 IsEnabled="{Binding CanSearch}" IsEnabledChanged="SearchBox_IsEnabledChanged"
                 themes:TextBoxChrome.Placeholder="Search names, types, descriptions, or targets"
                 AutomationProperties.Name="Search keycuts" />
        <controls:Icon Kind="Search" Size="16" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="11,0,0,0"
                       IsHitTestVisible="False" Foreground="{DynamicResource TextTertiaryBrush}" />
      </Grid>
      <TextBlock x:Name="ShownTextBlock" Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center"
                 FontSize="{StaticResource FontSizeBody}" Foreground="{DynamicResource TextSecondaryBrush}"
                 Text="{Binding ShownText}" AutomationProperties.LiveSetting="Polite"
                 Visibility="{Binding HasShownText, Converter={StaticResource BoolToVisibility}}" />
    </Grid>

    <Grid Grid.Row="2" Margin="24,0,24,12">
      <!-- Populated -->
      <Border x:Name="TableHost" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
              CornerRadius="{StaticResource RadiusMd}" SizeChanged="TableHost_SizeChanged"
              Visibility="{Binding IsTableVisible, Converter={StaticResource BoolToVisibility}}">
        <DataGrid x:Name="Table" Style="{StaticResource ManagerTable}" ItemsSource="{Binding Rows}"
                  SelectedItem="{Binding SelectedRow}" AutomationProperties.Name="Keycuts"
                  KeyboardNavigation.TabNavigation="Continue">
          <DataGrid.Columns>
            <!-- A click on the name or description cell of the selected row edits it in place (#202; see ManagerView_PreviewMouseDown) -->
            <DataGridTemplateColumn x:Name="NameColumn" Width="1.7*" MinWidth="190">
              <DataGridTemplateColumn.Header>
                <controls:SortHeaderButton Column="Shortcut" Content="Name" Style="{StaticResource SortHeaderButtonStyle}" />
              </DataGridTemplateColumn.Header>
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="{DynamicResource TextBrush}">
                      <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource CellText}">
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding IsRenaming}" Value="True">
                              <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>
                    <!-- Rename in place (F2, Rename, or a click on the selected row): Enter saves, Escape cancels, clicking or tabbing away saves -->
                    <TextBox Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}" Height="30" MinHeight="30"
                             Visibility="{Binding IsRenaming, Converter={StaticResource BoolToVisibility}}"
                             AutomationProperties.Name="{Binding RenameLabel}"
                             IsVisibleChanged="RenameBox_IsVisibleChanged" PreviewKeyDown="RenameBox_PreviewKeyDown"
                             LostKeyboardFocus="RenameBox_LostKeyboardFocus" />
                    <StackPanel Orientation="Horizontal" Margin="0,1,0,0" ToolTip="{Binding MissingTooltip}"
                                Visibility="{Binding ShowMissingIndicator, Converter={StaticResource BoolToVisibility}}">
                      <controls:Icon Kind="Close" Size="11" VerticalAlignment="Center"
                                     Foreground="{DynamicResource DangerBrush}" />
                      <TextBlock Text="Missing" Margin="3,0,0,0" FontSize="{StaticResource FontSizeCaption}"
                                 VerticalAlignment="Center" Foreground="{DynamicResource DangerBrush}" />
                    </StackPanel>
                    <!-- #203: starts, but something it names is wrong (a start-in folder that doesn't exist). WarningBrush is yellow
                         in the dark palette and a dark amber in the light one, where yellow text can't be read. -->
                    <StackPanel Orientation="Horizontal" Margin="0,1,0,0" ToolTip="{Binding WarningTooltip}"
                                Visibility="{Binding ShowWarningIndicator, Converter={StaticResource BoolToVisibility}}">
                      <controls:Icon Kind="Warning" Size="11" VerticalAlignment="Center"
                                     Foreground="{DynamicResource WarningBrush}" />
                      <TextBlock Text="Warning" Margin="3,0,0,0" FontSize="{StaticResource FontSizeCaption}"
                                 VerticalAlignment="Center" Foreground="{DynamicResource WarningBrush}" />
                    </StackPanel>
                  </StackPanel>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <!-- Type, Modified and the menu are fixed: the same MinWidth as Width, or the grid squeezes them to its default 20
                 when the table jumps narrower than all the columns need (a snap, a restore), and keeps them squeezed after the
                 Modified column has made way again -->
            <DataGridTemplateColumn Width="110" MinWidth="110" CanUserResize="False">
              <DataGridTemplateColumn.Header>
                <controls:SortHeaderButton Column="Type" Content="Type" Style="{StaticResource SortHeaderButtonStyle}" />
              </DataGridTemplateColumn.Header>
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <controls:TypeBadge Kind="{Binding Kind}" HorizontalAlignment="Left" VerticalAlignment="Center" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn x:Name="DescriptionColumn" Width="1.5*" MinWidth="100">
              <DataGridTemplateColumn.Header>
                <controls:SortHeaderButton Column="Description" Content="Description" Style="{StaticResource SortHeaderButtonStyle}" />
              </DataGridTemplateColumn.Header>
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <Grid VerticalAlignment="Center">
                    <TextBlock Text="{Binding Description}">
                      <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource CellText}">
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding IsEditingDescription}" Value="True">
                              <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>
                    <!-- Edit in place (Shift+F2, Edit description, or a click on the selected row): Enter saves, Escape cancels, clicking or tabbing away saves -->
                    <TextBox Text="{Binding EditDescription, UpdateSourceTrigger=PropertyChanged}" Height="30" MinHeight="30"
                             themes:TextBoxChrome.Placeholder="Add a description"
                             Visibility="{Binding IsEditingDescription, Converter={StaticResource BoolToVisibility}}"
                             AutomationProperties.Name="{Binding DescriptionLabel}"
                             IsVisibleChanged="DescriptionBox_IsVisibleChanged" PreviewKeyDown="DescriptionBox_PreviewKeyDown"
                             LostKeyboardFocus="DescriptionBox_LostKeyboardFocus" />
                  </Grid>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <!-- Target is resizable, and the columns to its left give way to it. Its right edge is pinned by the fixed columns
                 beside it, which the grid can't move, so there is no gripper there (#202) -->
            <DataGridTemplateColumn Width="2.8*" MinWidth="120" HeaderStyle="{StaticResource ManagerHeaderPinnedRight}">
              <DataGridTemplateColumn.Header>
                <controls:SortHeaderButton Column="Target" Content="Target" Style="{StaticResource SortHeaderButtonStyle}" />
              </DataGridTemplateColumn.Header>
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <!-- The cell shows the program; the tooltip adds its arguments (#203) -->
                  <TextBlock Style="{StaticResource CellText}" Text="{Binding Target}" ToolTip="{Binding TargetTooltip}" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <!-- #167: hidden while the table is too narrow for it (TableHost_SizeChanged), so the other columns keep their room -->
            <DataGridTemplateColumn x:Name="ModifiedColumn" Width="110" MinWidth="110" CanUserResize="False"
                                    HeaderStyle="{StaticResource ManagerHeaderFixed}">
              <DataGridTemplateColumn.Header>
                <controls:SortHeaderButton Column="Modified" Content="Modified" Style="{StaticResource SortHeaderButtonStyle}" />
              </DataGridTemplateColumn.Header>
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <!-- The text is how long ago; the tooltip is the exact date and time -->
                  <TextBlock Style="{StaticResource CellText}" Text="{Binding ModifiedText}" ToolTip="{Binding ModifiedTooltip}" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Width="44" MinWidth="44" CanUserResize="False" HeaderStyle="{StaticResource ManagerHeaderFixed}">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <controls:MenuButton Style="{StaticResource IconButton}" Width="28" Height="28"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       AutomationProperties.Name="{Binding ActionsLabel}"
                                       Click="RowMenu_Click" PreviewKeyDown="RowMenu_PreviewKeyDown">
                    <controls:Icon Kind="More" Size="17" />
                    <Button.ContextMenu>
                      <!-- 250 wide for the key names beside the items; the offset keeps the menu's right edge under the button (250 - 28) -->
                      <ContextMenu Width="250" Placement="Bottom" HorizontalOffset="-222" VerticalOffset="4"
                                   Opened="RowMenu_Opened" Closed="RowMenu_Closed" PreviewKeyDown="RowMenuPopup_PreviewKeyDown">
                        <MenuItem Header="Open keycut" InputGestureText="Enter" Command="{Binding OpenCommand}" Click="SafeItem_Click">
                          <MenuItem.Icon>
                            <controls:Icon Kind="Play" Size="16" />
                          </MenuItem.Icon>
                        </MenuItem>
                        <!-- #202: greyed out for a keycut the form can't save, and the tooltip (shown on the disabled item) says why -->
                        <MenuItem Header="Edit" InputGestureText="Ctrl+E" Command="{Binding EditCommand}" Click="SafeItem_Click">
                          <MenuItem.Style>
                            <Style TargetType="MenuItem" BasedOn="{StaticResource AppMenuItem}">
                              <Setter Property="ToolTip" Value="{Binding EditTooltip}" />
                              <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
                              <Setter Property="ToolTipService.IsEnabled" Value="False" />
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding CanEditInForm}" Value="False">
                                  <Setter Property="ToolTipService.IsEnabled" Value="True" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </MenuItem.Style>
                          <MenuItem.Icon>
                            <controls:Icon Kind="File" Size="16" />
                          </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Edit in Notepad" InputGestureText="Ctrl+Shift+E" Command="{Binding EditInNotepadCommand}" Click="SafeItem_Click">
                          <MenuItem.Icon>
                            <controls:Icon Kind="External" Size="16" />
                          </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Open file location" InputGestureText="Ctrl+Shift+O" Command="{Binding OpenFileLocationCommand}" Click="SafeItem_Click">
                          <MenuItem.Icon>
                            <controls:Icon Kind="Folder" Size="16" />
                          </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Copy target" InputGestureText="Ctrl+C" Command="{Binding CopyTargetCommand}" Click="SafeItem_Click">
                          <MenuItem.Icon>
                            <controls:Icon Kind="Copy" Size="16" />
                          </MenuItem.Icon>
                        </MenuItem>
                        <!-- No SafeItem_Click: the focus goes to the name box, not back to the menu button -->
                        <MenuItem Header="Rename" InputGestureText="F2" Command="{Binding RenameCommand}" />
                        <MenuItem Header="Edit description" InputGestureText="Shift+F2" Command="{Binding EditDescriptionCommand}" />
                        <Separator />
                        <MenuItem Header="Delete" InputGestureText="Delete" Style="{StaticResource DangerMenuItem}" Command="{Binding DeleteCommand}">
                          <MenuItem.Icon>
                            <controls:Icon Kind="Delete" Size="16" Foreground="{DynamicResource DangerBrush}" />
                          </MenuItem.Icon>
                        </MenuItem>
                      </ContextMenu>
                    </Button.ContextMenu>
                  </controls:MenuButton>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
          </DataGrid.Columns>
        </DataGrid>
      </Border>

      <!-- Loading -->
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal"
                  Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}">
        <Control Style="{StaticResource Spinner}" VerticalAlignment="Center" />
        <TextBlock Text="Loading keycuts…" Margin="10,0,0,0" VerticalAlignment="Center"
                   Foreground="{DynamicResource TextSecondaryBrush}" />
      </StackPanel>

      <!-- Empty -->
      <Grid Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
        <Rectangle RadiusX="8" RadiusY="8" Stroke="{DynamicResource BorderStrongBrush}" StrokeThickness="1"
                   StrokeDashArray="4 3" />
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
          <Grid Width="58" Height="58" HorizontalAlignment="Center" Margin="0,0,0,12">
            <Border CornerRadius="15" Background="{DynamicResource AccentSoftBrush}" />
            <controls:Icon Kind="File" Size="32" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{DynamicResource AccentBrush}" />
            <controls:Icon Kind="Spark" Size="14" HorizontalAlignment="Right" VerticalAlignment="Top"
                           Margin="0,6,6,0" Foreground="{DynamicResource AccentBrush}" />
          </Grid>
          <TextBlock Text="No keycuts yet" HorizontalAlignment="Center" FontSize="{StaticResource FontSizeSubheading}"
                     AutomationProperties.HeadingLevel="Level2"
                     FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" />
          <TextBlock Text="Create your first keycut and it will show up here." HorizontalAlignment="Center"
                     Margin="0,4,0,16" Foreground="{DynamicResource TextSecondaryBrush}" />
          <Button x:Name="EmptyCreateButton" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Center" Padding="16,0" Height="38"
                  Command="{Binding ShowCreatorCommand}">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="Create a keycut" />
              <controls:Icon Kind="Arrow" Size="16" Margin="8,0,0,0" />
            </StackPanel>
          </Button>
        </StackPanel>
      </Grid>

      <!-- No search results -->
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                  Visibility="{Binding IsNoResults, Converter={StaticResource BoolToVisibility}}">
        <TextBlock Text="{Binding NoResultsMessage}" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"
                   MaxWidth="560" FontSize="{StaticResource FontSizeSubheading}" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextBrush}" />
        <Button Style="{StaticResource SecondaryButton}" Content="Clear search" HorizontalAlignment="Center"
                Margin="0,12,0,0" Command="{Binding ClearSearchCommand}" />
      </StackPanel>

      <!-- Load error -->
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="560"
                  Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
        <TextBlock Text="Can't load your keycuts" HorizontalAlignment="Center" AutomationProperties.HeadingLevel="Level2"
                   AutomationProperties.LiveSetting="Assertive"
                   FontSize="{StaticResource FontSizeSubheading}" FontWeight="SemiBold"
                   Foreground="{DynamicResource DangerBrush}" />
        <TextBlock Text="{Binding ErrorMessage}" HorizontalAlignment="Center" TextAlignment="Center"
                   TextWrapping="Wrap" Margin="0,4,0,16" Foreground="{DynamicResource TextSecondaryBrush}" />
        <Button Style="{StaticResource SecondaryButton}" Content="Open settings" HorizontalAlignment="Center"
                Command="{Binding OpenSettingsCommand}" />
      </StackPanel>
    </Grid>

    <!-- #205: the footer both screens share. The status line (Deleted, errors) and Undo sit in it between the count and the
         update line. -->
    <views:FooterView Grid.Row="3">
      <views:FooterView.Message>
        <views:ManagerStatusView />
      </views:FooterView.Message>
    </views:FooterView>
  </Grid>
</UserControl>
